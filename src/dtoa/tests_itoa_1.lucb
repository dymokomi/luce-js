#==============================================================================================
#
#   tests_itoa_1 - Expected itoa results pinned from the C dtoa.c
#
#   DESCRIPTION:
#       Generated by a C driver compiled against upstream QuickJS dtoa.c (2026-06-04): each
#       line is one call and the exact bytes (or bits) C produced. Do not edit by hand.
#
#==============================================================================================

test "integer to text 1":
    check_u64toa(0x0000000000000000, "0")
    check_i64toa(0x0000000000000000, "0")
    check_u32toa(0x00000000, "0")
    check_i32toa(0x00000000, "0")
    check_u64toa(0x0000000000000001, "1")
    check_i64toa(0x0000000000000001, "1")
    check_u32toa(0x00000001, "1")
    check_i32toa(0x00000001, "1")
    check_u64toa(0x0000000000000009, "9")
    check_i64toa(0x0000000000000009, "9")
    check_u32toa(0x00000009, "9")
    check_i32toa(0x00000009, "9")
    check_u64toa(0x000000000000000a, "10")
    check_i64toa(0x000000000000000a, "10")
    check_u32toa(0x0000000a, "10")
    check_i32toa(0x0000000a, "10")
    check_u64toa(0x0000000000000063, "99")
    check_i64toa(0x0000000000000063, "99")
    check_u32toa(0x00000063, "99")
    check_i32toa(0x00000063, "99")
    check_u64toa(0x0000000000000064, "100")
    check_i64toa(0x0000000000000064, "100")
    check_u32toa(0x00000064, "100")
    check_i32toa(0x00000064, "100")
    check_u64toa(0x000000007fffffff, "2147483647")
    check_i64toa(0x000000007fffffff, "2147483647")
    check_u32toa(0x7fffffff, "2147483647")
    check_i32toa(0x7fffffff, "2147483647")
    check_u64toa(0x0000000080000000, "2147483648")
    check_i64toa(0x0000000080000000, "2147483648")
    check_u32toa(0x80000000, "2147483648")
    check_i32toa(0x80000000, "-2147483648")
    check_u64toa(0x00000000ffffffff, "4294967295")
    check_i64toa(0x00000000ffffffff, "4294967295")
    check_u32toa(0xffffffff, "4294967295")
    check_i32toa(0xffffffff, "-1")
    check_u64toa(0x0000000100000000, "4294967296")
    check_i64toa(0x0000000100000000, "4294967296")
    check_u32toa(0x00000000, "0")
    check_i32toa(0x00000000, "0")
    check_u64toa(0x000000003b9ac9ff, "999999999")
    check_i64toa(0x000000003b9ac9ff, "999999999")
    check_u32toa(0x3b9ac9ff, "999999999")
    check_i32toa(0x3b9ac9ff, "999999999")
    check_u64toa(0x000000003b9aca00, "1000000000")
    check_i64toa(0x000000003b9aca00, "1000000000")
    check_u32toa(0x3b9aca00, "1000000000")
    check_i32toa(0x3b9aca00, "1000000000")
    check_u64toa(0x00000002540be400, "10000000000")
    check_i64toa(0x00000002540be400, "10000000000")
    check_u32toa(0x540be400, "1410065408")
    check_i32toa(0x540be400, "1410065408")
    check_u64toa(0x0de0b6b3a7640000, "1000000000000000000")
    check_i64toa(0x0de0b6b3a7640000, "1000000000000000000")
    check_u32toa(0xa7640000, "2808348672")
    check_i32toa(0xa7640000, "-1486618624")
    check_u64toa(0x8ac7230489e7ffff, "9999999999999999999")
    check_i64toa(0x8ac7230489e7ffff, "-8446744073709551617")
    check_u32toa(0x89e7ffff, "2313682943")
    check_i32toa(0x89e7ffff, "-1981284353")
    check_u64toa(0x8ac7230489e80000, "10000000000000000000")
    check_i64toa(0x8ac7230489e80000, "-8446744073709551616")
    check_u32toa(0x89e80000, "2313682944")
    check_i32toa(0x89e80000, "-1981284352")
    check_u64toa(0x7fffffffffffffff, "9223372036854775807")
    check_i64toa(0x7fffffffffffffff, "9223372036854775807")
    check_u32toa(0xffffffff, "4294967295")
    check_i32toa(0xffffffff, "-1")
    check_u64toa(0x8000000000000000, "9223372036854775808")
    check_i64toa(0x8000000000000000, "-9223372036854775808")
    check_u32toa(0x00000000, "0")
    check_i32toa(0x00000000, "0")
    check_u64toa(0xffffffffffffffff, "18446744073709551615")
    check_i64toa(0xffffffffffffffff, "-1")
