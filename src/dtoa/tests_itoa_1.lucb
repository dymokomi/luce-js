    check_i64toa(0xab54a98ceb1f0ad2, "-6101065172474983726")
    check_u32toa(0xeb1f0ad2, "3944680146")
    check_i32toa(0xeb1f0ad2, "-350287150")
    check_u64toa(0x0020000000000001, "9007199254740993")
    check_i64toa(0x0020000000000001, "9007199254740993")
    check_u32toa(0x00000001, "1")
    check_i32toa(0x00000001, "1")
    check_u64toa(0x3b9aca0000000001, "4294967296000000001")
    check_i64toa(0x3b9aca0000000001, "4294967296000000001")
    check_u32toa(0x00000001, "1")
    check_i32toa(0x00000001, "1")

