## The shape of opcode byte `op`, reading the temporary opcodes' values as temporary.
func op_info(op: u8, temporary: bool) -> const OpCodeInfo*:
    if temporary and is_temp_op(op):
        return &opcode_info[(usize)op - op_temp_start + op_count]
    return &opcode_info[(usize)op]

