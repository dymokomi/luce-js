## The number of real opcodes (OP_COUNT).
let op_count: u32 = 244
## The first temporary opcode's value (OP_TEMP_START).
let op_temp_start: u32 = 178
## One past the last temporary opcode's value (OP_TEMP_END).
let op_temp_end: u32 = 197

## The compiler's temporary opcodes; values overlap the short opcodes.
enum TempOp as u8:
    enter_scope = 178
    leave_scope = 179
    label = 180
    scope_get_var_undef = 181
    scope_get_var = 182
    scope_put_var = 183
    scope_delete_var = 184
    scope_make_ref = 185
    scope_get_ref = 186
    scope_put_var_init = 187
    scope_get_var_checkthis = 188
    scope_get_private_field = 189
    scope_get_private_field2 = 190
    scope_put_private_field = 191
    scope_in_private_field = 192
    get_field_opt_chain = 193
    get_array_el_opt_chain = 194
    set_class_name = 195
    line_num = 196

## Whether byte `op` of phase 1 or 2 bytecode is a temporary opcode.
func is_temp_op(op: u8) -> bool:
    return (u32)op >= op_temp_start and (u32)op < op_temp_end

## An opcode's encoded size in bytes, its stack effect and its operand format (JSOpCode).
struct OpCodeInfo:
    let size: u8
    let n_pop: u8
    let n_push: u8
    let fmt: OpFormat

