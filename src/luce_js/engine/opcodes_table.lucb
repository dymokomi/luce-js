#==============================================================================================
#
#   opcodes_table - The bytecode opcodes and their shapes
#
#   DESCRIPTION:
#       Generated by tools/engine_tables.py from quickjs-opcode.h; do not edit.
#       `Op` holds the opcodes the interpreter runs, the short forms included.
#       `TempOp` holds the compiler's temporary opcodes of phases 1 and 2: in C
#       their values overlap the short opcodes (OP_TEMP_START = OP_nop + 1), so
#       they live in their own enum and bytecode in those phases is read through
#       `is_temp_op`.
#
#==============================================================================================

## The bytecode operand formats (OPCodeFormat).
enum OpFormat as u8:
    none_ = 0
    none_int = 1
    none_loc = 2
    none_arg = 3
    none_var_ref = 4
    u8_ = 5
    i8_ = 6
    loc8 = 7
    const8 = 8
    label8 = 9
    u16_ = 10
    i16_ = 11
    label16 = 12
    npop = 13
    npopx = 14
    npop_u16 = 15
    loc = 16
    arg = 17
    var_ref = 18
    u32_ = 19
    i32_ = 20
    const_ = 21
    label = 22
    atom = 23
    atom_u8 = 24
    atom_u16 = 25
    atom_label_u8 = 26
    atom_label_u16 = 27
    label_u16 = 28

