#==============================================================================================
#
#   bytecode_dump - Debug listings of bytecode, pc2line tables and compiled functions
#
#   DESCRIPTION:
#       Port of quickjs.c's DUMP_BYTECODE helpers (lines 32223-32692): skip_lines and
#       print_lines (the source excerpts of a listing), dump_byte_code (one listing of
#       phase 1, 2 or 3 bytecode), dump_pc2line and js_dump_function_bytecode. QuickJS
#       compiles them only with DUMP_BYTECODE; the port keeps them for debugging, and
#       nothing calls them. Everything is written to standard output with `print`, like
#       the value printer's dumps.
#
#       Phase 1 and 2 bytecode holds temporary opcodes (TempOp), phase 3 bytecode short
#       opcodes: a listing of a FunctionBytecode (`b` given) reads the bytes as short
#       opcodes, any other as temporary ones.
#
#==============================================================================================

# mark: Source excerpts =========================================================================

# The names of the temporary opcodes, for the listings of phases 1 and 2 (opcode_info's
# names of the `def` entries of quickjs-opcode.h).
let temp_opcode_names: str[19] = [
    "enter_scope",
    "leave_scope",
    "label",
    "scope_get_var_undef",
    "scope_get_var",
    "scope_put_var",
    "scope_delete_var",
    "scope_make_ref",
    "scope_get_ref",
    "scope_put_var_init",
    "scope_get_var_checkthis",
    "scope_get_private_field",
    "scope_get_private_field2",
    "scope_put_private_field",
    "scope_in_private_field",
    "get_field_opt_chain",
    "get_array_el_opt_chain",
    "set_class_name",
    "line_num",
]

# The name of opcode byte `op` (oi->name), reading the temporary opcodes' values as
# temporary when `temporary`.
func dump_opcode_name(op: u8, temporary: bool) -> str:
    if temporary and is_temp_op(op):
        return temp_opcode_names[(usize)op - op_temp_start]
    return opcode_names[(usize)op]

# Skip `n` lines of the NUL-terminated text at `p0`.
func skip_lines(p0: const u8*, n0: i32) -> const u8*:
    var p = p0
    var n = n0
    while n > 0 and *p != 0:
        n -= 1
        while *p != 0:
            let c = *p
            p = p + 1
            if c == '\n':
                break
    return p

# Print the lines `line` to `line1` (excluded) of `source` as ";; " comments.
func print_lines(source: const u8*, line0: i32, line1: i32):
    var s = source
    var p = skip_lines(s, line0)
    var line = line0
    if *p != 0:
        while line < line1:
            line += 1
            s = p
            p = skip_lines(s, 1)
            print(f";; {(str)u8[]((u8*)s, (usize)(p - s))}")
            if *p == 0:
                if *(p - 1) != '\n':
                    print("\n")
                break

# JS_PrintValue(ctx, js_dump_value_write, stdout, val, NULL): the constant `val` on
# standard output.
func dump_print_value(ctx: Context*, val: Value):
    js_print_value(ctx, js_dump_value_write, none, val, none)

# mark: dump_byte_code ==========================================================================

# The label address `addr` of a jump operand as dump_byte_code marks it: its phase 1 or
# 2 position, or for phase 3 the target of the relative offset read at `pos`.
func dump_label_target(pass: i32, label_slots: LabelSlot*?, addr0: i32, pos: i32) -> i32:
    var addr = addr0
    if pass == 1:
        let ls = label_slots else trap("dump_byte_code: no labels")
        addr = ls[addr].pos
    if pass == 2:
        let ls = label_slots else trap("dump_byte_code: no labels")
        addr = ls[addr].pos2
    if pass == 3:
        addr += pos
    return addr

# Print the label operand `addr` of an opcode whose operand is at `pos` (has_addr1).
func dump_label_operand(pass: i32, label_slots: LabelSlot*?, addr: i32, pos: i32,
                        sep: str):
    if pass == 1:
        let ls = label_slots else trap("dump_byte_code: no labels")
        print(f"{sep}{(u32)addr}:{(u32)ls[addr].pos}")
    if pass == 2:
        let ls = label_slots else trap("dump_byte_code: no labels")
        print(f"{sep}{(u32)addr}:{(u32)ls[addr].pos2}")
    if pass == 3:
        print(f"{sep}{(u32)(addr + pos)}")

# Print the name of variable `idx` for a none_loc/loc8/loc operand (has_loc).
func dump_loc_operand(ctx: Context*, idx: i32, vardefs: BytecodeVarDef*?,
                      vars: VarDef*?, arg_count: i32, var_count: i32):
    print(f" {idx}: ")
    if idx < var_count:
        if let v = vars:
            print_atom(ctx, v[idx].var_name)
        else:
            let vd = vardefs else trap("dump_byte_code: no variables")
            print_atom(ctx, vd[arg_count + idx].var_name)

# Print the name of argument `idx` for a none_arg/arg operand (has_arg).
func dump_arg_operand(ctx: Context*, idx: i32, vardefs: BytecodeVarDef*?,
                      args: VarDef*?, arg_count: i32):
    print(f" {idx}: ")
    if idx < arg_count:
        if let a = args:
            print_atom(ctx, a[idx].var_name)
        else:
            let vd = vardefs else trap("dump_byte_code: no arguments")
            print_atom(ctx, vd[idx].var_name)

# Print the name of closure variable `idx` for a none_var_ref/var_ref operand
# (has_var_ref).
func dump_var_ref_operand(ctx: Context*, idx: i32, closure_var: ClosureVar*?,
                          closure_var_count: i32):
    print(f" {idx}: ")
    if idx < closure_var_count:
        let cv = closure_var else trap("dump_byte_code: no closure variables")
        print_atom(ctx, cv[idx].var_name)

# Print the constant `idx` of a const8/const operand (has_pool_idx).
func dump_const_operand(ctx: Context*, idx: u32, cpool: Value*?, cpool_count: u32):
    print(f" {idx}: ")
    if idx < cpool_count:
        let pool = cpool else trap("dump_byte_code: no constant pool")
        dump_print_value(ctx, pool[(usize)idx])

# Print a listing of `len` bytes of bytecode at `tab`, compiled in phase `pass` (1, 2 or
# 3). Phases 1 and 2 give the variables as VarDefs (`args`, `vars`) and the labels;
# phase 3 gives the function `b` and its `vardefs`.
# The tables are not `const T*?`: a `T*?` does not convert to it.
# workaround: compiler-issues/nullable_pointer_cast
func dump_byte_code(ctx: Context*, pass: i32, tab: const u8*, len: i32,
                    vardefs: BytecodeVarDef*?,
                    args: VarDef*?, arg_count: i32,
                    vars: VarDef*?, var_count: i32,
                    closure_var: ClosureVar*?, closure_var_count: i32,
                    cpool: Value*?, cpool_count: u32,
                    source: u8*?,
                    label_slots: LabelSlot*?, b: FunctionBytecode*?):
    let bits_mem = js_mallocz(ctx, (usize)len) catch failure:
        return
    let bits = (u8*)bits_mem
    defer js_free(ctx, bits)
    let use_short_opcodes = b != none
    var line_num: i32 = 0

    if let fb = b:
        var col_num: i32 = 0
        line_num = find_line_num(ctx, fb, 0xffffffff, &col_num)

    # scan for jump targets
    var pos: i32 = 0
    while pos < len:
        let op = tab[pos]
        let oi = op_info(op, not use_short_opcodes)
        let pos_next = pos + (i32)oi.size
        if (u32)op < op_count:
            var addr: i32 = 0
            var has_addr = true
            match oi.fmt:
                .label8:
                    pos += 1
                    addr = (i32)(i8)tab[pos]
                .label16:
                    pos += 1
                    addr = cutils.get_i16(tab + pos)
                .atom_label_u8, .atom_label_u16:
                    pos += 5
                    addr = (i32)cutils.get_u32(tab + pos)
                .label, .label_u16:
                    pos += 1
                    addr = (i32)cutils.get_u32(tab + pos)
                _:
                    has_addr = false
            if has_addr:
                addr = dump_label_target(pass, label_slots, addr, pos)
                if addr >= 0 and addr < len:
                    bits[addr] |= 1
        pos = pos_next

    var in_source = false
    if let text = source:
        # Always print first line: needed if single line
        print_lines(text, 0, 1)
        in_source = true
    var line1: i32 = 1
    var line: i32 = 1
    pos = 0
    while pos < len:
        let op = tab[pos]
        if let text = source:
            if let fb = b:
                var col_num: i32 = 0
                line1 = find_line_num(ctx, fb, (u32)pos, &col_num) - line_num + 1
                if line1 > line:
                    if not in_source:
                        print("\n")
                    in_source = true
                    print_lines(text, line, line1)
                    line = line1
        if in_source:
            print("\n")
        in_source = false
        if (u32)op >= op_count:
            print(f"invalid opcode (0x{hex(op)})\n")
            pos += 1
            continue
        let oi = op_info(op, not use_short_opcodes)
        let size = (i32)oi.size
        if pos + size > len:
            print(f"truncated opcode (0x{hex(op)})\n")
            break
        if bits[pos] != 0:
            print(f"{pad(pos, 5)}:  ")
        else:
            print("        ")
        print(dump_opcode_name(op, not use_short_opcodes))
        pos += 1
        let operand = tab + pos
        match oi.fmt:
            .none_int:
                print(f" {(i32)op - (i32)Op.push_0}")
            .npopx:
                print(f" {(i32)op - (i32)Op.call0}")
            .u8_:
                print(f" {cutils.get_u8(operand)}")
            .i8_:
                print(f" {cutils.get_i8(operand)}")
            .u16_, .npop:
                print(f" {cutils.get_u16(operand)}")
            .npop_u16:
                print(f" {cutils.get_u16(operand)},{cutils.get_u16(operand + 2)}")
            .i16_:
                print(f" {cutils.get_i16(operand)}")
            .i32_:
                print(f" {cutils.get_i32(operand)}")
            .u32_:
                print(f" {cutils.get_u32(operand)}")
            .label8:
                dump_label_operand(pass, label_slots, cutils.get_i8(operand), pos, " ")
            .label16:
                dump_label_operand(pass, label_slots, cutils.get_i16(operand), pos, " ")
            .label:
                dump_label_operand(pass, label_slots, (i32)cutils.get_u32(operand), pos, " ")
            .label_u16:
                dump_label_operand(pass, label_slots, (i32)cutils.get_u32(operand), pos, " ")
                print(f",{cutils.get_u16(operand + 4)}")
            .const8:
                dump_const_operand(ctx, cutils.get_u8(operand), cpool, cpool_count)
            .const_:
                dump_const_operand(ctx, cutils.get_u32(operand), cpool, cpool_count)
            .atom:
                print(" ")
                print_atom(ctx, cutils.get_u32(operand))
            .atom_u8:
                print(" ")
                print_atom(ctx, cutils.get_u32(operand))
                print(f",{cutils.get_u8(operand + 4)}")
            .atom_u16:
                print(" ")
                print_atom(ctx, cutils.get_u32(operand))
                print(f",{cutils.get_u16(operand + 4)}")
            .atom_label_u8, .atom_label_u16:
                print(" ")
                print_atom(ctx, cutils.get_u32(operand))
                let addr = (i32)cutils.get_u32(operand + 4)
                dump_label_operand(pass, label_slots, addr, pos + 4, ",")
                if oi.fmt == OpFormat.atom_label_u8:
                    print(f",{cutils.get_u8(operand + 8)}")
                else:
                    print(f",{cutils.get_u16(operand + 8)}")
            .none_loc:
                let idx = ((i32)op - (i32)Op.get_loc0) % 4
                dump_loc_operand(ctx, idx, vardefs, vars, arg_count, var_count)
            .loc8:
                let idx = (i32)cutils.get_u8(operand)
                dump_loc_operand(ctx, idx, vardefs, vars, arg_count, var_count)
            .loc:
                let idx = (i32)cutils.get_u16(operand)
                dump_loc_operand(ctx, idx, vardefs, vars, arg_count, var_count)
            .none_arg:
                let idx = ((i32)op - (i32)Op.get_arg0) % 4
                dump_arg_operand(ctx, idx, vardefs, args, arg_count)
            .arg:
                let idx = (i32)cutils.get_u16(operand)
                dump_arg_operand(ctx, idx, vardefs, args, arg_count)
            .none_var_ref:
                let idx = ((i32)op - (i32)Op.get_var_ref0) % 4
                dump_var_ref_operand(ctx, idx, closure_var, closure_var_count)
            .var_ref:
                let idx = (i32)cutils.get_u16(operand)
                dump_var_ref_operand(ctx, idx, closure_var, closure_var_count)
            _:
                discard(0)
        print("\n")
        pos += size - 1
    if let text = source:
        if not in_source:
            print("\n")
        print_lines(text, line, 0x7fffffff)

# mark: pc2line and functions ===================================================================

# Print the pc2line table `buf[0..<len]`: one PC, line and column per row.
func dump_pc2line(ctx: Context*, buf: const u8*, len: i32):
    if len <= 0:
        return

    print(f"{pad("PC", 5)} {pad("LINE", 5)} {pad("COL", 5)}\n")

    var p = buf
    let p_end = buf + len
    var val: u32 = 0
    var v: i32 = 0

    # get the function line and column numbers
    var ret = get_leb128(&val, p, p_end)
    if ret < 0:
        return
    p = p + ret
    var line_num = (i32)val + 1

    ret = get_leb128(&val, p, p_end)
    if ret < 0:
        return
    p = p + ret
    var col_num = (i32)val + 1

    print(f"{pad("-", 5)} {pad(line_num, 5)} {pad(col_num, 5)}\n")

    var pc: i32 = 0
    while p < p_end:
        var op = (i32)*p
        p = p + 1
        if op == 0:
            ret = get_leb128(&val, p, p_end)
            if ret < 0:
                return
            pc += (i32)val
            p = p + ret
            ret = get_sleb128(&v, p, p_end)
            if ret < 0:
                return
            p = p + ret
            line_num += v
        else:
            op -= pc2line_op_first
            pc += op // pc2line_range
            line_num += (op % pc2line_range) + pc2line_base
        ret = get_sleb128(&v, p, p_end)
        if ret < 0:
            return
        p = p + ret
        col_num += v

        print(f"{pad(pc, 5)} {pad(line_num, 5)} {pad(col_num, 5)}\n")

# The kind word of closure variable `cv` in a function listing.
func dump_closure_type(cv: const ClosureVar*):
    match cv.closure_type:
        .local_:
            print(f" [loc{cv.var_idx}]\n")
        .arg:
            print(f" [arg{cv.var_idx}]\n")
        .ref:
            print(f" [ref{cv.var_idx}]\n")
        .global_ref:
            print(f" [global_ref{cv.var_idx}]\n")
        .global_decl:
            print(" [global_decl]\n")
        .global:
            print(" [global]\n")
        .module_decl:
            print(" [module_decl]\n")
        .module_import:
            print(" [module_import]\n")
        _:
            print(" [?]\n")

# Print the compiled function `b`: its name, mode, variables, closure variables and a
# listing of its bytecode.
func js_dump_function_bytecode(ctx: Context*, b: FunctionBytecode*):
    var atom_buf: u8[atom_get_str_buf_size] = ---

    if b.has_debug and b.debug.filename != no_atom:
        var col_num: i32 = 0
        let text = js_atom_get_str(ctx, atom_buf, b.debug.filename)
        let line_num = find_line_num(ctx, b, 0xffffffff, &col_num)
        print(f"{text}:{line_num}:{col_num}: ")

    let name = js_atom_get_str(ctx, atom_buf, b.func_name)
    let star = "*" if b.func_kind == js_func_generator else ""
    print(f"function: {star}{name}\n")
    if b.js_mode != 0:
        print("  mode:")
        if ((i32)b.js_mode & js_mode_strict) != 0:
            print(" strict")
        print("\n")
    if b.arg_count != 0:
        if let vardefs = b.vardefs:
            print("  args:")
            for i in 0..<(i32)b.arg_count:
                print(f" {js_atom_get_str(ctx, atom_buf, vardefs[i].var_name)}")
            print("\n")
    if b.var_count != 0:
        if let vardefs = b.vardefs:
            print("  locals:\n")
            for i in 0..<(i32)b.var_count:
                let vd = vardefs + ((i32)b.arg_count + i)
                var kind = "var"
                if vd.var_kind == VarKind.catch_:
                    kind = "catch"
                elif vd.var_kind == VarKind.function_decl or vd.var_kind == VarKind.new_function_decl:
                    kind = "function"
                elif vd.is_const:
                    kind = "const"
                elif vd.is_lexical:
                    kind = "let"
                print(f"{pad(i, 5)}: {kind} {js_atom_get_str(ctx, atom_buf, vd.var_name)}")
                if vd.has_scope:
                    print(f" [next:{vd.scope_next}]")
                print("\n")
    if b.closure_var_count != 0:
        let closure_var = b.closure_var else trap("js_dump_function_bytecode: no closure")
        print("  closure vars:\n")
        for i in 0..<b.closure_var_count:
            let cv = closure_var + i
            var kind = "var"
            if cv.is_const:
                kind = "const"
            elif cv.is_lexical:
                kind = "let"
            print(f"{pad(i, 5)}: {kind} {js_atom_get_str(ctx, atom_buf, cv.var_name)}")
            dump_closure_type(cv)
    print(f"  stack_size: {b.stack_size}\n")
    print(f"  var_ref_count: {b.var_ref_count}\n")
    print("  opcodes:\n")
    var source: u8*? = none
    if b.has_debug:
        if let text = b.debug.source:
            source = text
    dump_byte_code(ctx, 3, b.byte_code_buf, b.byte_code_len,
                   b.vardefs,
                   none, (i32)b.arg_count,
                   none, (i32)b.var_count,
                   b.closure_var, b.closure_var_count,
                   b.cpool, (u32)b.cpool_count,
                   source,
                   none, b)
    print("\n")
