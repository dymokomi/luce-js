    check_limb_to_a(0x0fdf7081, 10, 1, "9")
    check_u64toa(0x00000000924cce20, 29, "43j9qkn")
    check_limb_to_a(0xc33b473d, 29, 7, "5ek0s46")
    check_u64toa(0x3e3de95b916d5ef3, 27, "12nl97ncqij1of")
