test "digit writers":
    check_u64toa(0x0000000000000000, 10, "0")
    check_limb_to_a(0x7724dcee, 10, 5, "04558")
    check_u64toa(0x0000000000000007, 18, "7")
    check_limb_to_a(0x08c61805, 18, 6, "5g4101")
    check_u64toa(0x000000000000000e, 16, "e")
    check_limb_to_a(0xaa6baee3, 16, 8, "aa6baee3")
    check_u64toa(0x0000000000000015, 10, "21")
    check_limb_to_a(0xb802d7bc, 10, 6, "194044")
    check_u64toa(0x00000000ab16bd13, 14, "1d330a003")
    check_limb_to_a(0xab6f7283, 14, 7, "3dc0947")
