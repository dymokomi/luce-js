    check_u64toa(0x7aaeb8996de307d0, 10, "8840206087687964624")
    check_limb_to_a(0x07fad874, 10, 3, "924")
    check_u64toa(0xed2646e7a3c5b0c4, 28, "2hgcmj22mlk070")
    check_limb_to_a(0xa24be905, 28, 3, "23h")
    check_u64toa(0x5ed9b966d9fb9f97, 4, "11323121232112123121332321332113")
    check_limb_to_a(0xcdc43169, 4, 1, "1")
    check_u64toa(0xf0020fa747e8c34b, 10, "17294402730196517707")
    check_limb_to_a(0xb1414a0d, 10, 5, "46029")
    check_u64toa(0x480b3d4cce82ebd9, 7, "12202645542001301135013")
