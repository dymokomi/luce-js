#==============================================================================================
#
#   refcount - Duplicating and releasing values, and quickjs.h's other inline helpers
#
#   DESCRIPTION:
#       Port of quickjs.h's inline functions over the reference count: every value with a
#       negative tag points at a js_malloc'ed block whose header holds the count
#       (`js_rc`). Releasing the last reference hands the value to `js_free_value_raw`.
#
#==============================================================================================

## A new reference to `v` (JS_DupValue).
pub func js_dup_value(ctx: Context*, v: Value) -> Value:
    if js_value_has_ref_count(v):
        let p = js_rc(v.u.ptr)
        p.ref_count += 1
    return v

## A new reference to `v` without a context (JS_DupValueRT).
pub func js_dup_value_rt(rt: Runtime*, v: Value) -> Value:
    if js_value_has_ref_count(v):
        let p = js_rc(v.u.ptr)
        p.ref_count += 1
    return v

## Release a reference to `v`; the last one frees it (JS_FreeValue).
pub func js_free_value(ctx: Context*, v: Value):
    if js_value_has_ref_count(v):
        let p = js_rc(v.u.ptr)
        p.ref_count -= 1
        if p.ref_count <= 0:
            js_free_value_raw(ctx, v)

## Release a reference to `v` without a context (JS_FreeValueRT).
pub func js_free_value_rt(rt: Runtime*, v: Value):
    if js_value_has_ref_count(v):
        let p = js_rc(v.u.ptr)
        p.ref_count -= 1
        if p.ref_count <= 0:
            js_free_value_rt_raw(rt, v)

## The property `prop` of `this_obj` (JS_GetProperty).
pub func js_get_property(ctx: Context*, this_obj: Value, prop: Atom) -> Value!:
    return try js_get_property_internal(ctx, this_obj, prop, this_obj, false)

## Set the property `prop` of `this_obj`, taking ownership of `val` (JS_SetProperty).
pub func js_set_property(ctx: Context*, this_obj: Value, prop: Atom, val: Value) -> i32!:
    return try js_set_property_internal(ctx, this_obj, prop, val, this_obj, prop_throw)

## A C function object (JS_NewCFunction).
pub func js_new_c_function(ctx: Context*, func_: CFunction, name: const u8*, length: i32) -> Value!:
    return try js_new_c_function2(ctx, func_, name, length, CFunctionEnum.generic, 0)

## A string value from NUL-terminated UTF-8 text (JS_NewString).
pub func js_new_string(ctx: Context*, text: const u8*) -> Value!:
    return try js_new_string_len(ctx, text, cutils.strlen(text))

