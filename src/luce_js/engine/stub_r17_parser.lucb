## Ported from quickjs.c:28901 js_parse_statement_or_decl.
# quickjs.c:28481 (signatures assumed by r18's module_parse.lucb; r17 owns these)
let decl_mask_func: i32 = 1 << 0 # allow normal function declaration
# ored with decl_mask_func if function declarations are allowed with a label
let decl_mask_func_with_label: i32 = 1 << 1
let decl_mask_other: i32 = 1 << 2 # all other declarations
let decl_mask_all: i32 = decl_mask_func | decl_mask_func_with_label | decl_mask_other
func js_parse_statement_or_decl(s: ParseState*, decl_mask: i32) -> !:
    trap("unported: js_parse_statement_or_decl")
