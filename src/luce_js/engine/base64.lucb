#==============================================================================================
#
#   base64 - Base64 and hex encoding and decoding of byte buffers
#
#   DESCRIPTION:
#       Port of quickjs.c "Uint8Array base64/hex (tc39 proposal-arraybuffer-base64)"
#       helpers (lines 58966-59311): the alphabets and decoding tables, b64_encode,
#       b64_skip_ws, from_base64 (the FromBase64 abstract operation), u8a_hex_encode and
#       u8a_hex_decode. The C pointer and length pairs are spans here, so every access
#       is bounds-checked; these functions need no runtime and are unit-tested in
#       tests_r28.
#
#==============================================================================================

# mark: Alphabets and tables ====================================================================

# The alphabet option of the base64 methods.
let b64_alphabet_base64: i32 = 0
let b64_alphabet_base64url: i32 = 1

# The lastChunkHandling option of the base64 decoders.
let b64_last_loose: i32 = 0
let b64_last_strict: i32 = 1
let b64_last_stop_before_partial: i32 = 2

let b64_enc: const u8[] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

let b64url_enc: const u8[] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

# A decoding table maps a byte to its 6-bit value, to k_ws for whitespace (skipped) or to
# k_er for a byte that is not in the alphabet.
let k_ws: u8 = 64
let k_er: u8 = 65

let b64_dec: u8[256] = [
    k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_ws, k_ws, k_er, k_ws, k_ws, k_er, k_er,
    k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er, k_er,
