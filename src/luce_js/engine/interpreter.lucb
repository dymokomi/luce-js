                        else:
                            slow = true
                        if slow:
                            # add_slow_case
                            sf.cur_pc = pc
                            js_add_slow(ctx, sp) catch: break dispatch
                            sp = sp - 1
                    .add_loc:
                        let idx = (usize)*pc
                        pc = pc + 1

                        let op2 = sp[(isize)-1]
                        let pv = var_buf + idx
                        if js_value_is_both_int(*pv, op2):
                            let r = (i64)js_value_get_int(*pv) + (i64)js_value_get_int(op2)
                            if (i64)(i32)r != r:
