                            let v2 = js_value_get_int(op2)
                            sp[(isize)-2] = js_new_float64(f64(v1) / f64(v2))
                            sp = sp - 1
                        else:
                            # binary_arith_slow
                            sf.cur_pc = pc
                            js_binary_arith_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    .mod:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        var slow = true
                        if js_value_is_both_int(op1, op2):
