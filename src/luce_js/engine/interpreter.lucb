                        js_method_set_properties(ctx, sp[(isize)-1], atom, prop_flags, obj) catch:
                            ret = -1
                            recover ()
                        if ret >= 0:
                            ret = bool_status(js_define_property(ctx, obj, atom, value, getter, setter, prop_flags) catch: recover none)
