                        # 2 bits for target,
                        # 3 bits for source,
                        # 2 bits for exclusionList
                        let mask = (i32)*pc
                        pc = pc + 1
                        sf.cur_pc = pc
                        js_copy_data_properties(ctx, sp[(isize)(-1 - (mask & 3))], sp[(isize)(-1 - ((mask >> 2) & 7))], sp[(isize)(-1 - ((mask >> 5) & 7))], false) catch: break dispatch

