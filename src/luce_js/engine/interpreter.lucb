                        if slow:
                            # binary_arith_slow
                            sf.cur_pc = pc
                            js_binary_arith_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    .div:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        if js_value_is_both_int(op1, op2):
