                        let val = get_array_el_inline(ctx, sf, pc, sp[(isize)-2], sp[(isize)-1]) catch:
                            sp = sp - 1
                            break dispatch
                        js_free_value(ctx, sp[(isize)-2])
                        sp[(isize)-2] = val
                        sp = sp - 1

                    .get_array_el2:
                        # GET_ARRAY_EL_INLINE(get_array_el2, 1)
                        let val = get_array_el_inline(ctx, sf, pc, sp[(isize)-2], sp[(isize)-1]) catch:
                            sp[(isize)-1] = js_undefined()
                            break dispatch
                        sp[(isize)-1] = val

                    .get_array_el3:
