                        if op1.tag == Tag.int and js_value_get_int(op1) != 2147483647:
                            sp[(isize)-1] = js_new_int32(js_value_get_int(op1) + 1)
                        else:
                            # inc_slow
                            sf.cur_pc = pc
                            js_unary_arith_slow(ctx, sp, opcode) catch: break dispatch
                    .dec:
                        let op1 = sp[(isize)-1]
                        if op1.tag == Tag.int and js_value_get_int(op1) != -2147483648:
                            sp[(isize)-1] = js_new_int32(js_value_get_int(op1) - 1)
                        else:
                            # dec_slow
                            sf.cur_pc = pc
                            js_unary_arith_slow(ctx, sp, opcode) catch: break dispatch
                    .post_inc:
                        let op1 = sp[(isize)-1]
                        if op1.tag == Tag.int and js_value_get_int(op1) != 2147483647:
                            sp[0] = js_new_int32(js_value_get_int(op1) + 1)
                        else:
                            # post_inc_slow
                            sf.cur_pc = pc
                            js_post_inc_slow(ctx, sp, opcode) catch: break dispatch
                        sp = sp + 1
                    .post_dec:
                        let op1 = sp[(isize)-1]
                        if op1.tag == Tag.int and js_value_get_int(op1) != -2147483648:
                            sp[0] = js_new_int32(js_value_get_int(op1) - 1)
                        else:
                            # post_dec_slow
                            sf.cur_pc = pc
                            js_post_inc_slow(ctx, sp, opcode) catch: break dispatch
                        sp = sp + 1
                    .inc_loc:
                        let idx = (usize)*pc
                        pc = pc + 1

                        var op1 = var_buf[idx]
                        if op1.tag == Tag.int and js_value_get_int(op1) != 2147483647:
                            var_buf[idx] = js_new_int32(js_value_get_int(op1) + 1)
                        else:
                            # inc_loc_slow
                            sf.cur_pc = pc
                            # must duplicate otherwise the variable value may
                            # be destroyed before JS code accesses it
                            op1 = js_dup_value(ctx, op1)
                            js_unary_arith_slow(ctx, &op1 + 1, Op.inc) catch: break dispatch
                            set_value(ctx, var_buf + idx, op1)
                    .dec_loc:
                        let idx = (usize)*pc
                        pc = pc + 1

                        var op1 = var_buf[idx]
                        if op1.tag == Tag.int and js_value_get_int(op1) != -2147483648:
                            var_buf[idx] = js_new_int32(js_value_get_int(op1) - 1)
                        else:
                            # dec_loc_slow
                            sf.cur_pc = pc
                            # must duplicate otherwise the variable value may
                            # be destroyed before JS code accesses it
                            op1 = js_dup_value(ctx, op1)
                            js_unary_arith_slow(ctx, &op1 + 1, Op.dec) catch: break dispatch
                            set_value(ctx, var_buf + idx, op1)
                    .not_:
                        let op1 = sp[(isize)-1]
                        if op1.tag == Tag.int:
                            sp[(isize)-1] = js_new_int32(~js_value_get_int(op1))
                        else:
                            sf.cur_pc = pc
                            js_not_slow(ctx, sp) catch: break dispatch

                    .shl:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        if js_value_is_both_int(op1, op2):
                            let v1 = (u32)js_value_get_int(op1)
                            let v2 = (u32)js_value_get_int(op2) & 0x1f
                            sp[(isize)-2] = js_new_int32((i32)(v1 << v2))
                            sp = sp - 1
                        else:
                            sf.cur_pc = pc
                            js_binary_logic_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    .shr:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        if js_value_is_both_int(op1, op2):
                            let v2 = (u32)js_value_get_int(op2) & 0x1f
                            sp[(isize)-2] = js_new_uint32((u32)js_value_get_int(op1) >> v2)
                            sp = sp - 1
                        else:
                            sf.cur_pc = pc
                            js_shr_slow(ctx, sp) catch: break dispatch
                            sp = sp - 1
                    .sar:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        if js_value_is_both_int(op1, op2):
                            let v2 = (u32)js_value_get_int(op2) & 0x1f
                            sp[(isize)-2] = js_new_int32(js_value_get_int(op1) >> v2)
                            sp = sp - 1
                        else:
                            sf.cur_pc = pc
                            js_binary_logic_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    .and_:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        if js_value_is_both_int(op1, op2):
                            sp[(isize)-2] = js_new_int32(js_value_get_int(op1) & js_value_get_int(op2))
                            sp = sp - 1
                        else:
                            sf.cur_pc = pc
                            js_binary_logic_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    .or_:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        if js_value_is_both_int(op1, op2):
                            sp[(isize)-2] = js_new_int32(js_value_get_int(op1) | js_value_get_int(op2))
                            sp = sp - 1
                        else:
                            sf.cur_pc = pc
                            js_binary_logic_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    .xor:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        if js_value_is_both_int(op1, op2):
                            sp[(isize)-2] = js_new_int32(js_value_get_int(op1) ^ js_value_get_int(op2))
                            sp = sp - 1
                        else:
                            sf.cur_pc = pc
                            js_binary_logic_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1

                    # OP_CMP(OP_lt, <, js_relational_slow(ctx, sp, opcode))
                    .lt:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        var slow = false
                        if js_value_is_both_int(op1, op2):
                            sp[(isize)-2] = js_new_bool(js_value_get_int(op1) < js_value_get_int(op2))
                            sp = sp - 1
                        elif js_tag_is_float64(op1.tag) or js_tag_is_float64(op2.tag):
                            var d1: f64 = 0.0
                            var d2: f64 = 0.0
                            if js_tag_is_float64(op1.tag):
                                d1 = js_value_get_float64(op1)
                            elif op1.tag == Tag.int:
                                d1 = f64(js_value_get_int(op1))
                            else:
                                slow = true
                            if js_tag_is_float64(op2.tag):
                                d2 = js_value_get_float64(op2)
                            elif op2.tag == Tag.int:
                                d2 = f64(js_value_get_int(op2))
                            else:
                                slow = true
                            if not slow:
                                sp[(isize)-2] = js_new_bool(d1 < d2)
                                sp = sp - 1
                        else:
                            slow = true
                        if slow:
                            sf.cur_pc = pc
                            js_relational_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    # OP_CMP(OP_lte, <=, js_relational_slow(ctx, sp, opcode))
                    .lte:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        var slow = false
                        if js_value_is_both_int(op1, op2):
                            sp[(isize)-2] = js_new_bool(js_value_get_int(op1) <= js_value_get_int(op2))
                            sp = sp - 1
                        elif js_tag_is_float64(op1.tag) or js_tag_is_float64(op2.tag):
                            var d1: f64 = 0.0
                            var d2: f64 = 0.0
                            if js_tag_is_float64(op1.tag):
                                d1 = js_value_get_float64(op1)
                            elif op1.tag == Tag.int:
                                d1 = f64(js_value_get_int(op1))
                            else:
                                slow = true
                            if js_tag_is_float64(op2.tag):
                                d2 = js_value_get_float64(op2)
                            elif op2.tag == Tag.int:
                                d2 = f64(js_value_get_int(op2))
                            else:
                                slow = true
                            if not slow:
                                sp[(isize)-2] = js_new_bool(d1 <= d2)
                                sp = sp - 1
                        else:
                            slow = true
                        if slow:
                            sf.cur_pc = pc
                            js_relational_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    # OP_CMP(OP_gt, >, js_relational_slow(ctx, sp, opcode))
                    .gt:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        var slow = false
                        if js_value_is_both_int(op1, op2):
                            sp[(isize)-2] = js_new_bool(js_value_get_int(op1) > js_value_get_int(op2))
                            sp = sp - 1
                        elif js_tag_is_float64(op1.tag) or js_tag_is_float64(op2.tag):
                            var d1: f64 = 0.0
                            var d2: f64 = 0.0
                            if js_tag_is_float64(op1.tag):
                                d1 = js_value_get_float64(op1)
                            elif op1.tag == Tag.int:
                                d1 = f64(js_value_get_int(op1))
                            else:
                                slow = true
                            if js_tag_is_float64(op2.tag):
                                d2 = js_value_get_float64(op2)
                            elif op2.tag == Tag.int:
                                d2 = f64(js_value_get_int(op2))
                            else:
                                slow = true
                            if not slow:
                                sp[(isize)-2] = js_new_bool(d1 > d2)
                                sp = sp - 1
                        else:
                            slow = true
                        if slow:
                            sf.cur_pc = pc
                            js_relational_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1
                    # OP_CMP(OP_gte, >=, js_relational_slow(ctx, sp, opcode))
                    .gte:
                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        var slow = false
                        if js_value_is_both_int(op1, op2):
                            sp[(isize)-2] = js_new_bool(js_value_get_int(op1) >= js_value_get_int(op2))
                            sp = sp - 1
                        elif js_tag_is_float64(op1.tag) or js_tag_is_float64(op2.tag):
                            var d1: f64 = 0.0
                            var d2: f64 = 0.0
                            if js_tag_is_float64(op1.tag):
                                d1 = js_value_get_float64(op1)
                            elif op1.tag == Tag.int:
                                d1 = f64(js_value_get_int(op1))
                            else:
                                slow = true
                            if js_tag_is_float64(op2.tag):
                                d2 = js_value_get_float64(op2)
                            elif op2.tag == Tag.int:
                                d2 = f64(js_value_get_int(op2))
                            else:
                                slow = true
                            if not slow:
                                sp[(isize)-2] = js_new_bool(d1 >= d2)
                                sp = sp - 1
                        else:
                            slow = true
                        if slow:
                            sf.cur_pc = pc
                            js_relational_slow(ctx, sp, opcode) catch: break dispatch
                            sp = sp - 1

                    # OP_CMP_EQ(OP_eq, 0)
                    .eq:
                        eq_inline(ctx, sf, pc, sp, false) catch: break dispatch
                        sp = sp - 1
                    # OP_CMP_EQ(OP_neq, 1)
                    .neq:
                        eq_inline(ctx, sf, pc, sp, true) catch: break dispatch
                        sp = sp - 1

                    # OP_CMP_STRICT_EQ(OP_strict_eq, 0)
                    .strict_eq:
                        strict_eq_inline(ctx, sp, false)
                        sp = sp - 1
                    # OP_CMP_STRICT_EQ(OP_strict_neq, 1)
                    .strict_neq:
                        strict_eq_inline(ctx, sp, true)
                        sp = sp - 1

                    .in_:
                        sf.cur_pc = pc
                        js_operator_in(ctx, sp) catch: break dispatch
                        sp = sp - 1
                    .private_in:
                        sf.cur_pc = pc
                        js_operator_private_in(ctx, sp) catch: break dispatch
                        sp = sp - 1
                    .instanceof:
                        sf.cur_pc = pc
                        js_operator_instanceof(ctx, sp) catch: break dispatch
                        sp = sp - 1
                    .typeof:
                        let op1 = sp[(isize)-1]
                        let atom = js_operator_typeof(ctx, op1)
                        js_free_value(ctx, op1)
                        # a predefined atom: C does not test for an exception
                        sp[(isize)-1] = js_atom_to_string(ctx, atom) catch: recover js_exception()
                    .delete:
                        sf.cur_pc = pc
                        js_operator_delete(ctx, sp) catch: break dispatch
                        sp = sp - 1
                    .delete_var:
                        let atom = cutils.get_u32(pc)
                        pc = pc + 4
                        sf.cur_pc = pc

                        let ret = js_delete_global_var(ctx, atom) catch: break dispatch
                        *sp = js_new_bool(ret)
                        sp = sp + 1

                    .to_object:
                        if sp[(isize)-1].tag != Tag.object:
                            sf.cur_pc = pc
                            ret_val = js_to_object(ctx, sp[(isize)-1]) catch: break dispatch
                            js_free_value(ctx, sp[(isize)-1])
                            sp[(isize)-1] = ret_val

                    .to_propkey:
                        let tag = sp[(isize)-1].tag
                        if not (tag == Tag.int or tag == Tag.string or tag == Tag.symbol):
                            sf.cur_pc = pc
                            ret_val = js_to_property_key(ctx, sp[(isize)-1]) catch: break dispatch
                            js_free_value(ctx, sp[(isize)-1])
                            sp[(isize)-1] = ret_val

                    .with_get_var, .with_put_var, .with_delete_var, .with_make_ref, .with_get_ref:
                        let atom = cutils.get_u32(pc)
                        let diff = (i32)cutils.get_u32(pc + 4)
                        let is_with = pc[8] != 0
                        pc = pc + 9
                        sf.cur_pc = pc

                        let obj = sp[(isize)-1]
                        var ret = js_has_property(ctx, obj, atom) catch: break dispatch
                        var found = ret
                        if found and is_with:
                            ret = js_has_unscopable(ctx, obj, atom) catch: break dispatch
                            if ret:
                                found = false # goto no_with
                        if found:
                            match opcode:
                                .with_get_var:
                                    # in Object Environment Records, GetBindingValue() calls
                                    # HasProperty()
                                    ret = js_has_property(ctx, obj, atom) catch: break dispatch
                                    var val = js_undefined()
                                    if not ret:
                                        if is_strict_mode(ctx):
                                            js_throw_reference_error_not_defined(ctx, atom) catch: break dispatch
                                        val = js_undefined()
                                    else:
                                        val = js_get_property(ctx, obj, atom) catch: break dispatch
                                    set_value(ctx, sp - 1, val)
                                .with_put_var: # used e.g. in for in/of
                                    # in Object Environment Records, SetMutableBinding()
                                    # calls HasProperty()
                                    ret = js_has_property(ctx, obj, atom) catch: break dispatch
                                    if not ret and is_strict_mode(ctx):
                                        js_throw_reference_error_not_defined(ctx, atom) catch: break dispatch
                                    let set_ret = bool_status(js_set_property_internal(ctx, obj, atom, sp[(isize)-2], obj, prop_throw_strict) catch: recover none)
                                    js_free_value(ctx, sp[(isize)-1])
                                    sp = sp - 2
                                    if set_ret < 0:
                                        break dispatch
                                .with_delete_var:
                                    ret = js_delete_property(ctx, obj, atom, 0) catch: break dispatch
                                    js_free_value(ctx, sp[(isize)-1])
                                    sp[(isize)-1] = js_new_bool(ret)
                                .with_make_ref:
                                    # produce a pair object/propname on the stack
                                    *sp = js_atom_to_value(ctx, atom) catch: break dispatch
                                    sp = sp + 1
                                .with_get_ref:
                                    # produce a pair object/method on the stack
                                    # in Object Environment Records, GetBindingValue() calls
                                    # HasProperty()
                                    ret = js_has_property(ctx, obj, atom) catch: break dispatch
                                    var val = js_undefined()
                                    if not ret:
                                        val = js_undefined()
                                    else:
                                        val = js_get_property(ctx, obj, atom) catch: break dispatch
                                    *sp = val
                                    sp = sp + 1
                                _:
                                    trap("not a with opcode")
                            pc = pc + (isize)(diff - 5)
                        else:
                            # no_with: if not jumping, drop the object argument
                            js_free_value(ctx, sp[(isize)-1])
                            sp = sp - 1

                    .await:
                        ret_val = js_new_int32(func_ret_await)
                        exit = FrameExit.done_generator
                        break frame
                    .yield:
                        ret_val = js_new_int32(func_ret_yield)
                        exit = FrameExit.done_generator
                        break frame
                    .yield_star, .async_yield_star:
                        ret_val = js_new_int32(func_ret_yield_star)
                        exit = FrameExit.done_generator
                        break frame
                    .return_async:
                        ret_val = js_undefined()
                        exit = FrameExit.done_generator
                        break frame
                    .initial_yield:
                        ret_val = js_new_int32(func_ret_initial_yield)
                        exit = FrameExit.done_generator
                        break frame

                    .nop:
                        continue dispatch
                    .is_undefined_or_null:
                        if sp[(isize)-1].tag == Tag.undefined or sp[(isize)-1].tag == Tag.null:
                            # set_true
                            sp[(isize)-1] = js_true()
                        else:
                            # free_and_set_false
                            js_free_value(ctx, sp[(isize)-1])
                            sp[(isize)-1] = js_false()
                    # SHORT_OPCODES
                    .is_undefined:
                        if sp[(isize)-1].tag == Tag.undefined:
                            # set_true
                            sp[(isize)-1] = js_true()
                        else:
                            # free_and_set_false
                            js_free_value(ctx, sp[(isize)-1])
                            sp[(isize)-1] = js_false()
                    .is_null:
                        if sp[(isize)-1].tag == Tag.null:
                            # set_true
                            sp[(isize)-1] = js_true()
                        else:
                            # free_and_set_false
                            js_free_value(ctx, sp[(isize)-1])
                            sp[(isize)-1] = js_false()
                    # XXX: could merge to a single opcode
                    .typeof_is_undefined:
                        # different from OP_is_undefined because of isHTMLDDA
                        let res = js_operator_typeof(ctx, sp[(isize)-1]) == atom_undefined
                        # free_and_set_true / free_and_set_false
                        js_free_value(ctx, sp[(isize)-1])
                        sp[(isize)-1] = js_new_bool(res)
                    .typeof_is_function:
                        let res = js_operator_typeof(ctx, sp[(isize)-1]) == atom_function
                        # free_and_set_true / free_and_set_false
                        js_free_value(ctx, sp[(isize)-1])
                        sp[(isize)-1] = js_new_bool(res)
                    # end SHORT_OPCODES
                    _:
                        # OP_invalid and DEFAULT
                        let bad_pc = (i32)(pc - bc_buf - 1)
                        let bad_op = (u8)opcode
                        js_throw_internal_error(ctx, f"invalid opcode: pc={bad_pc} opcode=0x{hex_byte_prefix(bad_op)}{hex(bad_op)}") catch: break dispatch

        # exception:
        throwing = false
        if is_backtrace_needed(ctx, rt.current_exception):
            # add the backtrace information now (it is not done
            # before if the exception happens in a bytecode
            # operation
            sf.cur_pc = pc
            build_backtrace(ctx, rt.current_exception, none, 0, 0, 0)
        if not rt.current_exception_is_uncatchable:
            while sp > stack_buf:
                sp = sp - 1
                let val = *sp
                js_free_value(ctx, val)
                if val.tag == Tag.catch_offset:
                    let pos = js_value_get_int(val)
                    if pos == 0:
                        # enumerator: close it with a throw
                        js_free_value(ctx, sp[(isize)-1]) # drop the next method
                        sp = sp - 1
                        js_iterator_close(ctx, sp[(isize)-1], true) catch: recover ()
                    else:
                        *sp = rt.current_exception
                        sp = sp + 1
                        rt.current_exception = js_uninitialized()
                        pc = bc_buf + (usize)pos
                        continue frame
        exit = FrameExit.exception
        break frame

    # ret_val = JS_EXCEPTION on the exception exit.
    # the local variables are freed by the caller in the generator
    # case. Hence the label 'done' should never be reached in a
    # generator function.
    if exit == FrameExit.done_generator or (exit == FrameExit.exception and b.func_kind != js_func_normal):
        # done_generator:
        sf.cur_pc = pc
        sf.cur_sp = sp
    else:
        # done:
        if b.var_ref_count != 0:
            # variable references reference the stack: must close them
            close_var_refs(rt, b, sf)
        # free the local variables and stack
        var pval = local_buf
        while pval < sp:
            js_free_value(ctx, *pval)
            pval = pval + 1
    rt.current_stack_frame = sf.prev_frame
    if let block = heap_frame:
        js_free_rt(rt, block)
    if exit == FrameExit.exception:
        error(exception, "")
    return ret_val
