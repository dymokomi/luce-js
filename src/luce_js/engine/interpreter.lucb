                            if ret < 0:
                                js_free_atom(ctx, atom)
                                break dispatch
                            if is_strict_mode(ctx):
                                js_throw_reference_error_not_defined(ctx, atom) catch:
                                    js_free_atom(ctx, atom)
                                    break dispatch
                        ret = bool_status(js_set_property_internal(ctx, sp[(isize)-3], atom, sp[(isize)-1], sp[(isize)-3], prop_throw_strict) catch: recover none)
                        js_free_atom(ctx, atom)
                        js_free_value(ctx, sp[(isize)-2])
                        js_free_value(ctx, sp[(isize)-3])
                        sp = sp - 3
                        if ret < 0:
                            break dispatch

                    .put_super_value:
                        sf.cur_pc = pc
                        if sp[(isize)-3].tag != Tag.object:
                            js_throw_type_error_not_an_object(ctx) catch: break dispatch
                        let atom = js_value_to_atom(ctx, sp[(isize)-2]) catch: break dispatch
