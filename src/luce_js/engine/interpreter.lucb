                            sf.cur_pc = pc
                            js_unary_arith_slow(ctx, sp, opcode) catch: break dispatch
                    .neg:
                        let op1 = sp[(isize)-1]
                        let tag = op1.tag
                        var fp_res = false
                        var d: f64 = 0.0
                        if tag == Tag.int or tag == Tag.boolean or tag == Tag.null:
                            let val = js_value_get_int(op1)
                            # Note: -0 cannot be expressed as integer
                            if val == 0:
                                d = f64.bits(0x8000000000000000) # -0.0
                                fp_res = true
                            elif val == -2147483648:
                                d = -f64(val)
                                fp_res = true
                            else:
                                sp[(isize)-1] = js_new_int32(-val)
