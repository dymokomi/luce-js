                            let ret = bool_status(js_set_property_value(ctx, sp[(isize)-3], sp[(isize)-2], sp[(isize)-1], prop_throw_strict) catch: recover none)
                            js_free_value(ctx, sp[(isize)-3])
                            sp = sp - 3
                            if ret < 0:
                                break dispatch

                    .put_ref_value:
                        sf.cur_pc = pc
                        let atom = js_value_to_atom(ctx, sp[(isize)-2]) catch: break dispatch
                        if js_is_undefined(sp[(isize)-3]):
                            if is_strict_mode(ctx):
