#==============================================================================================
#
#   interpreter - JS_CallInternal: the bytecode interpreter's dispatch loop and frames
#
#   DESCRIPTION:
#       Port of quickjs.c lines 17746-20709: the frame setup of a bytecode call (or the
#       resumption of a suspended generator frame), the dispatch loop over every opcode,
#       the call opcodes, the exception unwinding and the frame's release. The bodies of
#       the other opcodes are in the interp_ops_*.lucb fragments that follow.
#
#       State. C keeps pc, sp, the frame buffers, b, ctx, ... in locals of JS_CallInternal.
#       Here they are the fields of one InterpState (interpreter_support.lucb), a local of
#       js_call_internal, so that the body of each opcode can be a function taking a
#       pointer to it. That keeps js_call_internal's native frame small (about 1 KB with
#       the 256 bytes of frame_space, plus about 240 bytes for interp_call), which is the
#       stack one level of JavaScript recursion takes: the native backend gives every
#       temporary its own slot, and with the bodies inline the frame was 48 KB.
#
#       Structure. C dispatches with computed goto (or a switch) and leaves each opcode
#       with `BREAK`, `goto exception`, `goto done` or `goto done_generator`. Base has no
#       goto, so the function is two nested loops:
#
#           frame: while true:                  # C: `restart:` + the `exception:` label
#               if not throwing:
#                   dispatch: while true:       # C: `for(;;) { SWITCH(pc) { ... } }`
#                       st.opcode = (Op)*st.pc; st.pc = st.pc + 1
#                       match st.opcode:        # every opcode, in C's order
#                           .push_i32: interp_push_i32(&st)             # cannot raise
#                           .add: if not interp_add(&st): break dispatch # goto exception
#                           .return_: ... exit = .done; break frame      # goto done
#                           _: ...              # OP_invalid and DEFAULT
#               # exception: interp_unwind unwinds the stack to the innermost catch
#               # offset; when one is found, `continue frame` runs its handler;
#               # otherwise `exit = .exception; break frame`.
#           interp_leave(&st, exit)             # done, done_generator or the exception
#
#       - An opcode body that raises answers false: a fallible callee failed (`f(...)
#         catch: return false`), or a `js_throw_*` helper stored the exception. The stack
#         pointer is left exactly where C leaves it at its `goto exception`, so the
#         unwinding frees the same values; a C push of JS_EXCEPTION (`*sp++ = f(); if
#         (JS_IsException(sp[-1])) goto exception;`) pushes nothing, which the unwinding
#         cannot tell apart. Where C does cleanup between the call and its exception
#         test, the call recovers C's status and the C test follows unchanged:
#         `bool_status(f(...) catch: recover none)` gives C's -1/0/1 for a `bool!`
#         callee, `catch: recover js_exception()` C's JS_EXCEPTION for a `Value!` one,
#         and a unit callee sets `ret = -1` in its handler.
#       - `goto done` and `goto done_generator` set `exit` (and st.ret_val) and leave with
#         `break frame`: the returns, the tail calls and the generator suspensions stay
#         in the loop. A generator resumed with `throw_flag` starts at the exception
#         handler (`throwing`).
#       - Shared C labels inside an opcode (`add_slow_case`, `binary_arith_slow`,
#         `mul_fp_res`, the `*_slow_path` labels, `set_true`, ...) are a local flag that
#         selects the shared tail of the body. The opcodes that share a body (call0 to
#         call3 with call, get_var_undef with get_var, ...) are one arm, as in C.
#       - The large macros are inline functions of interpreter_support.lucb.
#       - pc, sp and the frame buffers are pointers, exactly as in C; `sp[-1]` is written
#         `sp[(isize)-1]` (workaround: compiler-issues/negative-pointer-index).
#       - C allocates the frame with alloca. Base has no alloca: a frame that fits
#         `frame_space` (js_call_inline_frame_values values) lives in js_call_internal's
#         frame, a larger one is js_malloc'ed and released when the call returns.
#       - rt.current_stack_frame is set through js_push_stack_frame (workaround:
#         compiler-issues/local_address_store).
#
#==============================================================================================

## The number of values a bytecode call keeps in its own frame before it allocates the
## locals, stack and variable references on the heap (C uses alloca for all of them). Small
## functions fit; every value here adds 16 bytes to each level of JavaScript recursion.
let js_call_inline_frame_values: usize = 16

# mark: JS_CallInternal =========================================================================

# argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0.
## Call `func_obj` with `this_obj`, `new_target` and the `argc` arguments at `argv`: a
## bytecode function runs in the interpreter, another object through its class's call
## hook; with call_flag_generator, `func_obj` holds the AsyncFunctionState of a
## suspended generator frame, which is resumed (JS_CallInternal).
func js_call_internal(caller_ctx: Context*, func_obj: Value, this_obj: Value, new_target: Value, argc: i32, argv: Value*, flags: i32) -> Value!:
    var st: InterpState = ---
    var sf_s: StackFrame = ---
    # the frame when it fits; C allocates it with alloca
    var frame_space: Value[js_call_inline_frame_values] = ---
    st.sf = &sf_s
    let entry = try interp_enter(&st, caller_ctx, func_obj, this_obj, new_target, argc, argv, flags, &frame_space[0])
    if entry == InterpEntry.returned:
        return st.ret_val
    # set when the frame starts at the exception handler
    var throwing = entry == InterpEntry.throwing
    var exit = FrameExit.exception

    # restart:
    frame: while true:
        if not throwing:
            dispatch: while true:
                st.opcode = (Op)*st.pc
                st.pc = st.pc + 1
                match st.opcode:
                    .push_i32:
                        interp_push_i32(&st)
                    .push_bigint_i32:
                        interp_push_bigint_i32(&st)
                    .push_const:
                        interp_push_const(&st)
                    # SHORT_OPCODES
                    .push_minus1, .push_0, .push_1, .push_2, .push_3, .push_4, .push_5, .push_6, .push_7:
                        interp_push_minus1(&st)
                    .push_i8:
                        interp_push_i8(&st)
                    .push_i16:
                        interp_push_i16(&st)
                    .push_const8:
                        interp_push_const8(&st)
                    .fclosure8:
                        if not interp_fclosure8(&st): break dispatch
                    .push_empty_string:
                        if not interp_push_empty_string(&st): break dispatch
                    # end SHORT_OPCODES
                    .push_atom_value:
                        if not interp_push_atom_value(&st): break dispatch
                    .undefined:
                        interp_undefined(&st)
                    .null:
                        interp_null(&st)
                    .push_this:
                        if not interp_push_this(&st): break dispatch
                    .push_false:
                        interp_push_false(&st)
                    .push_true:
                        interp_push_true(&st)
                    .object:
                        if not interp_object(&st): break dispatch
                    .special_object:
                        if not interp_special_object(&st): break dispatch
                    .rest:
                        if not interp_rest(&st): break dispatch
                    .drop:
                        interp_drop(&st)
                    .nip:
                        interp_nip(&st)
                    .nip1: # a b c -> b c
                        interp_nip1(&st)
                    .dup:
                        interp_dup(&st)
                    .dup2: # a b -> a b a b
                        interp_dup2(&st)
                    .dup3: # a b c -> a b c a b c
                        interp_dup3(&st)
                    .dup1: # a b -> a a b
                        interp_dup1(&st)
                    .insert2: # obj a -> a obj a (dup_x1)
                        interp_insert2(&st)
                    .insert3: # obj prop a -> a obj prop a (dup_x2)
                        interp_insert3(&st)
                    .insert4: # this obj prop a -> a this obj prop a
                        interp_insert4(&st)
                    .perm3: # obj a b -> a obj b (213)
                        interp_perm3(&st)
                    .rot3l: # x a b -> a b x (231)
                        interp_rot3l(&st)
                    .rot4l: # x a b c -> a b c x
                        interp_rot4l(&st)
                    .rot5l: # x a b c d -> a b c d x
                        interp_rot5l(&st)
                    .rot3r: # a b x -> x a b (312)
                        interp_rot3r(&st)
                    .perm4: # obj prop a b -> a obj prop b
                        interp_perm4(&st)
                    .perm5: # this obj prop a b -> a this obj prop b
                        interp_perm5(&st)
                    .swap: # a b -> b a
                        interp_swap(&st)
                    .swap2: # a b c d -> c d a b
                        interp_swap2(&st)
                    .fclosure:
                        if not interp_fclosure(&st): break dispatch
                    # call0 to call3 are SHORT_OPCODES (C: goto has_call_argc)
                    .call0, .call1, .call2, .call3, .call, .tail_call:
                        if not interp_call(&st): break dispatch
                        if st.opcode == Op.tail_call:
                            exit = FrameExit.done
                            break frame
                    .call_constructor:
                        if not interp_call_constructor(&st): break dispatch
                    .call_method, .tail_call_method:
                        if not interp_call_method(&st): break dispatch
                        if st.opcode == Op.tail_call_method:
                            exit = FrameExit.done
                            break frame
                    .array_from:
                        if not interp_array_from(&st): break dispatch
                    .apply:
                        if not interp_apply(&st): break dispatch
                    .return_:
                        st.sp = st.sp - 1
                        st.ret_val = *st.sp
                        exit = FrameExit.done
                        break frame
                    .return_undef:
                        st.ret_val = js_undefined()
                        exit = FrameExit.done
                        break frame
                    .check_ctor_return:
                        if not interp_check_ctor_return(&st): break dispatch
                    .check_ctor:
                        if not interp_check_ctor(&st): break dispatch
                    .init_ctor:
                        if not interp_init_ctor(&st): break dispatch
                    .check_brand:
                        if not interp_check_brand(&st): break dispatch
                    .add_brand:
                        if not interp_add_brand(&st): break dispatch
                    .throw:
                        if not interp_throw(&st): break dispatch
                    .throw_error:
                        if not interp_throw_error(&st): break dispatch
                    .eval:
                        if not interp_eval(&st): break dispatch
                    # could merge with OP_apply
                    .apply_eval:
                        if not interp_apply_eval(&st): break dispatch
                    .regexp:
                        if not interp_regexp(&st): break dispatch
                    .get_super:
                        if not interp_get_super(&st): break dispatch
                    .import_:
                        if not interp_import(&st): break dispatch
                    .get_var_undef, .get_var:
                        if not interp_get_var_undef(&st): break dispatch
                    .put_var, .put_var_init:
                        if not interp_put_var(&st): break dispatch
                    .get_loc:
                        interp_get_loc(&st)
                    .put_loc:
                        interp_put_loc(&st)
                    .set_loc:
                        interp_set_loc(&st)
                    .get_arg:
                        interp_get_arg(&st)
                    .put_arg:
                        interp_put_arg(&st)
                    .set_arg:
                        interp_set_arg(&st)
                    # SHORT_OPCODES
                    .get_loc8:
                        interp_get_loc8(&st)
                    .put_loc8:
                        interp_put_loc8(&st)
                    .set_loc8:
                        interp_set_loc8(&st)
                    .get_loc0:
                        interp_get_loc0(&st)
                    .get_loc1:
                        interp_get_loc1(&st)
                    .get_loc2:
                        interp_get_loc2(&st)
                    .get_loc3:
                        interp_get_loc3(&st)
                    .put_loc0:
                        interp_put_loc0(&st)
                    .put_loc1:
                        interp_put_loc1(&st)
                    .put_loc2:
                        interp_put_loc2(&st)
                    .put_loc3:
                        interp_put_loc3(&st)
                    .set_loc0:
                        interp_set_loc0(&st)
                    .set_loc1:
                        interp_set_loc1(&st)
                    .set_loc2:
                        interp_set_loc2(&st)
                    .set_loc3:
                        interp_set_loc3(&st)
                    .get_arg0:
                        interp_get_arg0(&st)
                    .get_arg1:
                        interp_get_arg1(&st)
                    .get_arg2:
                        interp_get_arg2(&st)
                    .get_arg3:
                        interp_get_arg3(&st)
                    .put_arg0:
                        interp_put_arg0(&st)
                    .put_arg1:
                        interp_put_arg1(&st)
                    .put_arg2:
                        interp_put_arg2(&st)
                    .put_arg3:
                        interp_put_arg3(&st)
                    .set_arg0:
                        interp_set_arg0(&st)
                    .set_arg1:
                        interp_set_arg1(&st)
                    .set_arg2:
                        interp_set_arg2(&st)
                    .set_arg3:
                        interp_set_arg3(&st)
                    .get_var_ref0:
                        interp_get_var_ref0(&st)
                    .get_var_ref1:
                        interp_get_var_ref1(&st)
                    .get_var_ref2:
                        interp_get_var_ref2(&st)
                    .get_var_ref3:
                        interp_get_var_ref3(&st)
                    .put_var_ref0:
                        interp_put_var_ref0(&st)
                    .put_var_ref1:
                        interp_put_var_ref1(&st)
                    .put_var_ref2:
                        interp_put_var_ref2(&st)
                    .put_var_ref3:
                        interp_put_var_ref3(&st)
                    .set_var_ref0:
                        interp_set_var_ref0(&st)
                    .set_var_ref1:
                        interp_set_var_ref1(&st)
                    .set_var_ref2:
                        interp_set_var_ref2(&st)
                    .set_var_ref3:
                        interp_set_var_ref3(&st)
                    .get_var_ref:
                        interp_get_var_ref(&st)
                    .put_var_ref:
                        interp_put_var_ref(&st)
                    .set_var_ref:
                        interp_set_var_ref(&st)
                    .get_var_ref_check:
                        if not interp_get_var_ref_check(&st): break dispatch
                    .put_var_ref_check:
                        if not interp_put_var_ref_check(&st): break dispatch
                    .put_var_ref_check_init:
                        if not interp_put_var_ref_check_init(&st): break dispatch
                    .set_loc_uninitialized:
                        interp_set_loc_uninitialized(&st)
                    .get_loc_check:
                        if not interp_get_loc_check(&st): break dispatch
                    .get_loc_checkthis:
                        if not interp_get_loc_checkthis(&st): break dispatch
                    .put_loc_check:
                        if not interp_put_loc_check(&st): break dispatch
                    .set_loc_check:
                        if not interp_set_loc_check(&st): break dispatch
                    .put_loc_check_init:
                        if not interp_put_loc_check_init(&st): break dispatch
                    .close_loc:
                        interp_close_loc(&st)
                    .make_loc_ref, .make_arg_ref, .make_var_ref_ref:
                        if not interp_make_loc_ref(&st): break dispatch
                    .make_var_ref:
                        if not interp_make_var_ref(&st): break dispatch
                    .goto_:
                        if not interp_goto(&st): break dispatch
                    # SHORT_OPCODES
                    .goto16:
                        if not interp_goto16(&st): break dispatch
                    .goto8:
                        if not interp_goto8(&st): break dispatch
                    # end SHORT_OPCODES
                    .if_true:
                        if not interp_if_true(&st): break dispatch
                    .if_false:
                        if not interp_if_false(&st): break dispatch
                    # SHORT_OPCODES
                    .if_true8:
                        if not interp_if_true8(&st): break dispatch
                    .if_false8:
                        if not interp_if_false8(&st): break dispatch
                    # end SHORT_OPCODES
                    .catch_:
                        interp_catch(&st)
                    .gosub:
                        interp_gosub(&st)
                    .ret:
                        if not interp_ret(&st): break dispatch
                    .for_in_start:
                        if not interp_for_in_start(&st): break dispatch
                    .for_in_next:
                        if not interp_for_in_next(&st): break dispatch
                    .for_of_start:
                        if not interp_for_of_start(&st): break dispatch
                    .for_of_next:
                        if not interp_for_of_next(&st): break dispatch
                    .for_await_of_next:
                        if not interp_for_await_of_next(&st): break dispatch
                    .for_await_of_start:
                        if not interp_for_await_of_start(&st): break dispatch
                    .iterator_get_value_done:
                        if not interp_iterator_get_value_done(&st): break dispatch
                    .iterator_check_object:
                        if not interp_iterator_check_object(&st): break dispatch
                    .iterator_close:
                        if not interp_iterator_close(&st): break dispatch
                    .nip_catch:
                        if not interp_nip_catch(&st): break dispatch
                    .iterator_next:
                        if not interp_iterator_next(&st): break dispatch
                    .iterator_call:
                        if not interp_iterator_call(&st): break dispatch
                    .lnot:
                        interp_lnot(&st)
                    .get_field:
                        if not interp_get_field(&st): break dispatch
                    .get_field2:
                        if not interp_get_field2(&st): break dispatch
                    # SHORT_OPCODES
                    .get_length:
                        if not interp_get_length(&st): break dispatch
                    .put_field:
                        if not interp_put_field(&st): break dispatch
                    .private_symbol:
                        if not interp_private_symbol(&st): break dispatch
                    .get_private_field:
                        if not interp_get_private_field(&st): break dispatch
                    .put_private_field:
                        if not interp_put_private_field(&st): break dispatch
                    .define_private_field:
                        if not interp_define_private_field(&st): break dispatch
                    .define_field:
                        if not interp_define_field(&st): break dispatch
                    .set_name:
                        if not interp_set_name(&st): break dispatch
                    .set_name_computed:
                        if not interp_set_name_computed(&st): break dispatch
                    .set_proto:
                        if not interp_set_proto(&st): break dispatch
                    .set_home_object:
                        interp_set_home_object(&st)
                    .define_method, .define_method_computed:
                        if not interp_define_method(&st): break dispatch
                    .define_class, .define_class_computed:
                        if not interp_define_class(&st): break dispatch
                    .get_array_el:
                        if not interp_get_array_el(&st): break dispatch
                    .get_array_el2:
                        if not interp_get_array_el2(&st): break dispatch
                    .get_array_el3:
                        if not interp_get_array_el3(&st): break dispatch
                    .get_ref_value:
                        if not interp_get_ref_value(&st): break dispatch
                    .get_super_value:
                        if not interp_get_super_value(&st): break dispatch
                    .put_array_el:
                        if not interp_put_array_el(&st): break dispatch
                    .put_ref_value:
                        if not interp_put_ref_value(&st): break dispatch
                    .put_super_value:
                        if not interp_put_super_value(&st): break dispatch
                    .define_array_el:
                        if not interp_define_array_el(&st): break dispatch
                    .append: # array pos enumobj -- array pos
                        if not interp_append(&st): break dispatch
                    .copy_data_properties: # target source excludeList
                        if not interp_copy_data_properties(&st): break dispatch
                    .add:
                        if not interp_add(&st): break dispatch
                    .add_loc:
                        if not interp_add_loc(&st): break dispatch
                    .sub:
                        if not interp_sub(&st): break dispatch
                    .mul:
                        if not interp_mul(&st): break dispatch
                    .div:
                        if not interp_div(&st): break dispatch
                    .mod:
                        if not interp_mod(&st): break dispatch
                    .pow:
                        if not interp_pow(&st): break dispatch
                    .plus:
                        if not interp_plus(&st): break dispatch
                    .neg:
                        if not interp_neg(&st): break dispatch
                    .inc:
                        if not interp_inc(&st): break dispatch
                    .dec:
                        if not interp_dec(&st): break dispatch
                    .post_inc:
                        if not interp_post_inc(&st): break dispatch
                    .post_dec:
                        if not interp_post_dec(&st): break dispatch
                    .inc_loc:
                        if not interp_inc_loc(&st): break dispatch
                    .dec_loc:
                        if not interp_dec_loc(&st): break dispatch
                    .not_:
                        if not interp_not(&st): break dispatch
                    .shl:
                        if not interp_shl(&st): break dispatch
                    .shr:
                        if not interp_shr(&st): break dispatch
                    .sar:
                        if not interp_sar(&st): break dispatch
                    .and_:
                        if not interp_and(&st): break dispatch
                    .or_:
                        if not interp_or(&st): break dispatch
                    .xor:
                        if not interp_xor(&st): break dispatch
                    # OP_CMP(OP_lt, <, js_relational_slow(ctx, sp, opcode))
                    .lt:
                        if not interp_lt(&st): break dispatch
                    # OP_CMP(OP_lte, <=, js_relational_slow(ctx, sp, opcode))
                    .lte:
                        if not interp_lte(&st): break dispatch
                    # OP_CMP(OP_gt, >, js_relational_slow(ctx, sp, opcode))
                    .gt:
                        if not interp_gt(&st): break dispatch
                    # OP_CMP(OP_gte, >=, js_relational_slow(ctx, sp, opcode))
                    .gte:
                        if not interp_gte(&st): break dispatch
                    # OP_CMP_EQ(OP_eq, 0)
                    .eq:
                        if not interp_eq(&st): break dispatch
                    # OP_CMP_EQ(OP_neq, 1)
                    .neq:
                        if not interp_neq(&st): break dispatch
                    # OP_CMP_STRICT_EQ(OP_strict_eq, 0)
                    .strict_eq:
                        interp_strict_eq(&st)
                    # OP_CMP_STRICT_EQ(OP_strict_neq, 1)
                    .strict_neq:
                        interp_strict_neq(&st)
                    .in_:
                        if not interp_in(&st): break dispatch
                    .private_in:
                        if not interp_private_in(&st): break dispatch
                    .instanceof:
                        if not interp_instanceof(&st): break dispatch
                    .typeof:
                        interp_typeof(&st)
                    .delete:
                        if not interp_delete(&st): break dispatch
                    .delete_var:
                        if not interp_delete_var(&st): break dispatch
                    .to_object:
                        if not interp_to_object(&st): break dispatch
                    .to_propkey:
                        if not interp_to_propkey(&st): break dispatch
                    .with_get_var, .with_put_var, .with_delete_var, .with_make_ref, .with_get_ref:
                        if not interp_with_get_var(&st): break dispatch
                    # end SHORT_OPCODES
                    .await:
                        st.ret_val = js_new_int32(func_ret_await)
                        exit = FrameExit.done_generator
                        break frame
                    .yield:
                        st.ret_val = js_new_int32(func_ret_yield)
                        exit = FrameExit.done_generator
                        break frame
                    .yield_star, .async_yield_star:
                        st.ret_val = js_new_int32(func_ret_yield_star)
                        exit = FrameExit.done_generator
                        break frame
                    .return_async:
                        st.ret_val = js_undefined()
                        exit = FrameExit.done_generator
                        break frame
                    .initial_yield:
                        st.ret_val = js_new_int32(func_ret_initial_yield)
                        exit = FrameExit.done_generator
                        break frame
                    .nop:
                        continue dispatch
                    .is_undefined_or_null:
                        interp_is_undefined_or_null(&st)
                    # SHORT_OPCODES
                    .is_undefined:
                        interp_is_undefined(&st)
                    .is_null:
                        interp_is_null(&st)
                    # XXX: could merge to a single opcode
                    .typeof_is_undefined:
                        interp_typeof_is_undefined(&st)
                    .typeof_is_function:
                        interp_typeof_is_function(&st)
                    # end SHORT_OPCODES
                    _:
                        if not interp_invalid(&st): break dispatch

        # exception:
        throwing = false
        if interp_unwind(&st):
            continue frame
        exit = FrameExit.exception
        break frame

    interp_leave(&st, exit)
    if exit == FrameExit.exception:
        error(exception, "")
    return st.ret_val

# mark: Calls =================================================================================

# The bodies of the call opcodes. The callee runs in js_call_internal, called from here:
# the recursion of JavaScript calls then holds this small frame beside the dispatch loop's.

## The argument count of a call opcode: the u16 operand of OP_call, OP_tail_call,
## OP_call_constructor, OP_call_method and OP_tail_call_method, or `opcode - OP_call0`
## for the short forms (SHORT_OPCODES).
func interp_call_argc(st: InterpState*) -> i32:
    if st.opcode == Op.call0 or st.opcode == Op.call1 or st.opcode == Op.call2 or st.opcode == Op.call3:
        return (i32)(u8)st.opcode - (i32)(u8)Op.call0
    let call_argc = (i32)cutils.get_u16(st.pc)
    st.pc = st.pc + 2
    return call_argc

## After a call returned st.ret_val: release the function (and `this`, or new.target,
## when `extra` is 2) and the arguments, and push the result in their place.
func interp_call_done(st: InterpState*, call_argc: i32, extra: i32):
    let call_argv = st.sp - (usize)call_argc
    var i: isize = -(isize)extra
    while i < (isize)call_argc:
        js_free_value(st.ctx, call_argv[i])
        i += 1
    st.sp = st.sp - (usize)(call_argc + extra)
    *st.sp = st.ret_val
    st.sp = st.sp + 1

## The body of OP_call0 to OP_call3 (SHORT_OPCODES), OP_call and OP_tail_call. After a
## tail call the stack is left as it is: the frame returns st.ret_val (C: goto done).
noinline func interp_call(st: InterpState*) -> bool:
    let call_argc = interp_call_argc(st)
    # has_call_argc:
    let call_argv = st.sp - (usize)call_argc
    st.sf.cur_pc = st.pc
    st.ret_val = js_call_internal(st.ctx, call_argv[(isize)-1], js_undefined(), js_undefined(), call_argc, call_argv, 0) catch: return false
    if st.opcode == Op.tail_call:
        return true
    interp_call_done(st, call_argc, 1)
    return true

## The body of OP_call_constructor.
noinline func interp_call_constructor(st: InterpState*) -> bool:
    let call_argc = interp_call_argc(st)
    let call_argv = st.sp - (usize)call_argc
    st.sf.cur_pc = st.pc
    st.ret_val = js_call_constructor_internal(st.ctx, call_argv[(isize)-2], call_argv[(isize)-1], call_argc, call_argv, 0) catch: return false
    interp_call_done(st, call_argc, 2)
    return true

## The body of OP_call_method and OP_tail_call_method; after a tail call the frame
## returns st.ret_val (C: goto done).
noinline func interp_call_method(st: InterpState*) -> bool:
    let call_argc = interp_call_argc(st)
    let call_argv = st.sp - (usize)call_argc
    st.sf.cur_pc = st.pc
    st.ret_val = js_call_internal(st.ctx, call_argv[(isize)-1], call_argv[(isize)-2], js_undefined(), call_argc, call_argv, 0) catch: return false
    if st.opcode == Op.tail_call_method:
        return true
    interp_call_done(st, call_argc, 2)
    return true

# mark: Entering and leaving a frame ============================================================

## What interp_enter leaves js_call_internal to do.
enum InterpEntry:
    ## Run the frame from st.pc.
    run
    ## Resume a generator frame at the exception handler (its throw_flag is set).
    throwing
    ## The object was not a bytecode function: its class's call hook ran and st.ret_val
    ## is its result.
    returned

## The start of JS_CallInternal: fill `st` from the call, then set up the frame of a
## bytecode function (its arguments, variables, stack and variable references in
## `frame_space`, or on the heap when they do not fit), or take the suspended frame of a
## generator, and make it the runtime's current frame.
noinline func interp_enter(st: InterpState*, caller_ctx: Context*, func_obj: Value, this_obj: Value, new_target: Value, argc: i32, argv: Value*, flags: i32, frame_space: Value*) -> InterpEntry!:
    st.caller_ctx = caller_ctx
    st.rt = caller_ctx.rt
    st.ctx = caller_ctx
    st.func_obj = func_obj
    st.this_obj = this_obj
    st.new_target = new_target
    st.argc = argc
    st.argv = argv
    st.opcode = Op.invalid
    st.ret_val = js_undefined()
    st.var_refs = none
    st.heap_frame = none
    try js_poll_interrupts(st.caller_ctx)
    if st.func_obj.tag != Tag.object:
        if (flags & call_flag_generator) == 0:
            # not_a_function
            try js_throw_type_error(st.caller_ctx, "not a function")
        let s = (AsyncFunctionState*)st.func_obj.u.ptr
        # func_obj get contains a pointer to JSFuncAsyncState
        # the stack frame is already allocated
        st.sf = &s.frame
        st.p = st.sf.cur_func.u.obj
        st.b = st.p.u.func_.function_bytecode
        st.bc_buf = st.b.byte_code_buf
        st.ctx = st.b.realm
        st.var_refs = st.p.u.func_.var_refs
        st.arg_buf = st.sf.arg_buf else trap("generator frame without arguments")
        st.local_buf = st.arg_buf
        st.var_buf = st.sf.var_buf else trap("generator frame without variables")
        st.stack_buf = st.var_buf + (usize)st.b.var_count
        st.sp = st.sf.cur_sp else trap("generator frame is running")
        st.sf.cur_sp = none # cur_sp is NULL if the function is running
        st.pc = st.sf.cur_pc else trap("generator frame without pc")
        st.sf.prev_frame = st.rt.current_stack_frame
        # workaround: compiler-issues/local_address_store
        js_push_stack_frame(st.rt, st.sf)
        if s.throw_flag:
            return InterpEntry.throwing
    else:
        st.p = st.func_obj.u.obj
        if st.p.class_id != ClassId.bytecode_function:
            let class_array = st.rt.class_array else trap("the class array is not allocated")
            let call_func = class_array[(usize)(u16)st.p.class_id].call else try js_throw_type_error(st.caller_ctx, "not a function")
            st.ret_val = try call_func(st.caller_ctx, st.func_obj, st.this_obj, st.argc, st.argv, flags)
            return InterpEntry.returned
        st.b = st.p.u.func_.function_bytecode
        st.bc_buf = st.b.byte_code_buf

        var arg_allocated_size: i32 = 0
        if st.argc < (i32)st.b.arg_count or (flags & call_flag_copy_argv) != 0:
            arg_allocated_size = (i32)st.b.arg_count

        let alloca_size = sizeof(Value) * ((usize)arg_allocated_size + (usize)st.b.var_count + (usize)st.b.stack_size) + sizeof(VarRef*) * (usize)st.b.var_ref_count
        if js_check_stack_overflow(st.rt, alloca_size):
            try js_throw_stack_overflow(st.caller_ctx)

        st.sf.js_mode = (i32)st.b.js_mode
        st.arg_buf = st.argv
        st.sf.arg_count = st.argc
        st.sf.cur_func = st.func_obj
        st.var_refs = st.p.u.func_.var_refs

        if alloca_size <= sizeof(Value) * js_call_inline_frame_values:
            st.local_buf = frame_space
        else:
            let block = try js_malloc(st.caller_ctx, alloca_size)
            st.heap_frame = block
            st.local_buf = (Value*)block
        if arg_allocated_size != 0:
            let n = cutils.min_int(st.argc, (i32)st.b.arg_count)
            st.arg_buf = st.local_buf
            for i in 0..<(usize)n:
                st.arg_buf[i] = js_dup_value(st.caller_ctx, st.argv[i])
            for i in (usize)n..<(usize)st.b.arg_count:
                st.arg_buf[i] = js_undefined()
            st.sf.arg_count = (i32)st.b.arg_count
        st.var_buf = st.local_buf + (usize)arg_allocated_size
        st.sf.var_buf = st.var_buf
        st.sf.arg_buf = st.arg_buf

        for i in 0..<(usize)st.b.var_count:
            st.var_buf[i] = js_undefined()

        st.stack_buf = st.var_buf + (usize)st.b.var_count
        let frame_var_refs = (VarRef*?*)(st.stack_buf + (usize)st.b.stack_size)
        st.sf.var_refs = frame_var_refs
        for i in 0..<(usize)st.b.var_ref_count:
            frame_var_refs[i] = none
        st.sp = st.stack_buf
        st.pc = st.b.byte_code_buf
        st.sf.prev_frame = st.rt.current_stack_frame
        # workaround: compiler-issues/local_address_store
        js_push_stack_frame(st.rt, st.sf)
        st.ctx = st.b.realm # set the current realm

    return InterpEntry.run

## The `exception:` label of JS_CallInternal: record the backtrace, then unwind the stack
## to the innermost catch offset, closing the iterators of for-of loops on the way. True
## when a handler was found: the exception is pushed and st.pc is the handler.
noinline func interp_unwind(st: InterpState*) -> bool:
    if is_backtrace_needed(st.ctx, st.rt.current_exception):
        # add the backtrace information now (it is not done
        # before if the exception happens in a bytecode
        # operation
        st.sf.cur_pc = st.pc
        build_backtrace(st.ctx, st.rt.current_exception, none, 0, 0, 0)
    if not st.rt.current_exception_is_uncatchable:
        while st.sp > st.stack_buf:
            st.sp = st.sp - 1
            let val = *st.sp
            js_free_value(st.ctx, val)
            if val.tag == Tag.catch_offset:
                let pos = js_value_get_int(val)
                if pos == 0:
                    # enumerator: close it with a throw
                    js_free_value(st.ctx, st.sp[(isize)-1]) # drop the next method
                    st.sp = st.sp - 1
                    js_iterator_close(st.ctx, st.sp[(isize)-1], true) catch: recover ()
                else:
                    *st.sp = st.rt.current_exception
                    st.sp = st.sp + 1
                    st.rt.current_exception = js_uninitialized()
                    st.pc = st.bc_buf + (usize)pos
                    return true
    return false

## The exits of JS_CallInternal: a suspended generator keeps its frame (pc and sp are
## saved); otherwise the variable references are closed and the locals and stack are
## released. Then the caller's frame becomes current again.
noinline func interp_leave(st: InterpState*, exit: FrameExit):
    # ret_val = JS_EXCEPTION on the exception exit.
    # the local variables are freed by the caller in the generator
    # case. Hence the label 'done' should never be reached in a
    # generator function.
    if exit == FrameExit.done_generator or (exit == FrameExit.exception and st.b.func_kind != js_func_normal):
        # done_generator:
        st.sf.cur_pc = st.pc
        st.sf.cur_sp = st.sp
    else:
        # done:
        if st.b.var_ref_count != 0:
            # variable references reference the stack: must close them
            close_var_refs(st.rt, st.b, st.sf)
        # free the local variables and stack
        var pval = st.local_buf
        while pval < st.sp:
            js_free_value(st.ctx, *pval)
            pval = pval + 1
    st.rt.current_stack_frame = st.sf.prev_frame
    if let block = st.heap_frame:
        js_free_rt(st.rt, block)
