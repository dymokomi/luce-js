#==============================================================================================
#
#   interpreter - JS_CallInternal: the bytecode interpreter
#
#   DESCRIPTION:
#       Port of quickjs.c lines 17746-20709: the frame setup of a bytecode call (or the
#       resumption of a suspended generator frame), the dispatch loop over every opcode,
#       the exception unwinding and the frame's release.
#
#       Structure. C dispatches with computed goto (or a switch) and leaves each opcode
#       with `BREAK`, `goto exception`, `goto done` or `goto done_generator`. Base has no
#       goto, so the function is two nested loops:
#
#           frame: while true:                  # C: `restart:` + the `exception:` label
#               if not throwing:
#                   dispatch: while true:       # C: `for(;;) { SWITCH(pc) { ... } }`
#                       opcode = (Op)*pc; pc = pc + 1
#                       match opcode:
#                           .push_i32: ...      # an arm ends: the next opcode (BREAK)
#                           .add: ... f(...) catch: break dispatch    # goto exception
#                           .return_: ... exit = .done; break frame    # goto done
#                           _: ...              # OP_invalid and DEFAULT
#               # exception: unwind the stack to the innermost catch offset; when one is
#               # found, push the exception, set pc to its handler and `continue frame`;
#               # otherwise `exit = .exception; break frame`.
#           # the exits (done, done_generator, the exception return)
#
#       - An opcode that raises leaves with `break dispatch`: a fallible callee failed
#         (`f(...) catch: break dispatch`), or a `js_throw_*` helper stored the exception.
#         The stack pointer is left exactly where C leaves it at its `goto exception`, so
#         the unwinding frees the same values; a C push of JS_EXCEPTION (`*sp++ = f();
#         if (JS_IsException(sp[-1])) goto exception;`) pushes nothing, which the
#         unwinding cannot tell apart. Where C does cleanup between the call and its
#         exception test, the call recovers C's status and the C test follows unchanged:
#         `bool_status(f(...) catch: recover none)` gives C's -1/0/1 for a `bool!`
#         callee, `catch: recover js_exception()` C's JS_EXCEPTION for a `Value!` one,
#         and a unit callee sets `ret = -1` in its handler.
#       - `goto done` and `goto done_generator` set `exit` (and `ret_val`) and leave with
#         `break frame`. A generator resumed with `throw_flag` starts at the exception
#         handler (`throwing`).
#       - Shared C labels inside an opcode (`add_slow_case`, `binary_arith_slow`,
#         `mul_fp_res`, the `*_slow_path` labels, `set_true`, ...) are a local flag that
#         selects the shared tail of the arm. The opcodes that share a body (call0 to
#         call3 with call, get_var_undef with get_var, ...) are one arm, as in C.
#       - The large macros are inline functions of interpreter_support.lucb; the rest is
#         expanded in place so the fast paths (int + int, get_loc, ...) stay inline.
#       - pc, sp and the frame buffers are pointers, exactly as in C; `sp[-1]` is written
#         `sp[(isize)-1]` (workaround: compiler-issues/negative-pointer-index).
#       - C allocates the frame with alloca. Base has no alloca: a frame that fits
#         `frame_space` (js_call_inline_frame_values values) lives in this function's
#         frame, a larger one is js_malloc'ed and released when the call returns.
#       - rt.current_stack_frame is set through js_push_stack_frame (workaround:
#         compiler-issues/local_address_store).
#
#==============================================================================================

## The number of values a bytecode call keeps in its own frame before it allocates the
## locals, stack and variable references on the heap (C uses alloca for all of them).
let js_call_inline_frame_values: usize = 32

# mark: JS_CallInternal =========================================================================

# argv[] is modified if (flags & JS_CALL_FLAG_COPY_ARGV) = 0.
## Call `func_obj` with `this_obj`, `new_target` and the `argc` arguments at `argv`: a
## bytecode function runs in the interpreter, another object through its class's call
## hook; with call_flag_generator, `func_obj` holds the AsyncFunctionState of a
## suspended generator frame, which is resumed (JS_CallInternal).
func js_call_internal(caller_ctx: Context*, func_obj: Value, this_obj: Value, new_target: Value, argc: i32, argv: Value*, flags: i32) -> Value!:
    let rt = caller_ctx.rt
    var ctx: Context* = caller_ctx
    var p: Object* = ---
    var b: FunctionBytecode* = ---
    var sf_s: StackFrame = ---
    var sf: StackFrame* = &sf_s
    var pc: const u8* = ---
    var opcode = Op.invalid
    var local_buf: Value* = ---
    var stack_buf: Value* = ---
    var var_buf: Value* = ---
    var arg_buf: Value* = ---
    var sp: Value* = ---
    var ret_val = js_undefined()
    var var_refs: VarRef*?*? = none
    # the frame when it fits; C allocates it with alloca
    var frame_space: Value[js_call_inline_frame_values] = ---
    # the frame when it does not fit frame_space
    var heap_frame: void*? = none
    # set when the frame starts at the exception handler
    var throwing = false

    try js_poll_interrupts(caller_ctx)
    if func_obj.tag != Tag.object:
        if (flags & call_flag_generator) == 0:
            # not_a_function
            try js_throw_type_error(caller_ctx, "not a function")
        let s = (AsyncFunctionState*)func_obj.u.ptr
        # func_obj get contains a pointer to JSFuncAsyncState
        # the stack frame is already allocated
        sf = &s.frame
        p = sf.cur_func.u.obj
        b = p.u.func_.function_bytecode
        ctx = b.realm
        var_refs = p.u.func_.var_refs
        arg_buf = sf.arg_buf else trap("generator frame without arguments")
        local_buf = arg_buf
        var_buf = sf.var_buf else trap("generator frame without variables")
        stack_buf = var_buf + (usize)b.var_count
        sp = sf.cur_sp else trap("generator frame is running")
        sf.cur_sp = none # cur_sp is NULL if the function is running
        pc = sf.cur_pc else trap("generator frame without pc")
        sf.prev_frame = rt.current_stack_frame
        # workaround: compiler-issues/local_address_store
        js_push_stack_frame(rt, sf)
        throwing = s.throw_flag
    else:
        p = func_obj.u.obj
        if p.class_id != ClassId.bytecode_function:
            let class_array = rt.class_array else trap("the class array is not allocated")
            let call_func = class_array[(usize)(u16)p.class_id].call else try js_throw_type_error(caller_ctx, "not a function")
            return try call_func(caller_ctx, func_obj, this_obj, argc, argv, flags)
        b = p.u.func_.function_bytecode

        var arg_allocated_size: i32 = 0
        if argc < (i32)b.arg_count or (flags & call_flag_copy_argv) != 0:
            arg_allocated_size = (i32)b.arg_count

        let alloca_size = sizeof(Value) * ((usize)arg_allocated_size + (usize)b.var_count + (usize)b.stack_size) + sizeof(VarRef*) * (usize)b.var_ref_count
        if js_check_stack_overflow(rt, alloca_size):
            try js_throw_stack_overflow(caller_ctx)

        sf.js_mode = (i32)b.js_mode
        arg_buf = argv
        sf.arg_count = argc
        sf.cur_func = func_obj
        var_refs = p.u.func_.var_refs

        if alloca_size <= sizeof(Value) * js_call_inline_frame_values:
            local_buf = &frame_space[0]
        else:
            let block = try js_malloc(caller_ctx, alloca_size)
            heap_frame = block
            local_buf = (Value*)block
        if arg_allocated_size != 0:
            let n = cutils.min_int(argc, (i32)b.arg_count)
            arg_buf = local_buf
            for i in 0..<(usize)n:
                arg_buf[i] = js_dup_value(caller_ctx, argv[i])
            for i in (usize)n..<(usize)b.arg_count:
                arg_buf[i] = js_undefined()
            sf.arg_count = (i32)b.arg_count
        var_buf = local_buf + (usize)arg_allocated_size
        sf.var_buf = var_buf
        sf.arg_buf = arg_buf

        for i in 0..<(usize)b.var_count:
            var_buf[i] = js_undefined()

        stack_buf = var_buf + (usize)b.var_count
        let frame_var_refs = (VarRef*?*)(stack_buf + (usize)b.stack_size)
        sf.var_refs = frame_var_refs
        for i in 0..<(usize)b.var_ref_count:
            frame_var_refs[i] = none
        sp = stack_buf
        pc = b.byte_code_buf
        sf.prev_frame = rt.current_stack_frame
        # workaround: compiler-issues/local_address_store
        js_push_stack_frame(rt, sf)
        ctx = b.realm # set the current realm

    let bc_buf: const u8* = b.byte_code_buf
    var exit = FrameExit.exception

    # restart:
    frame: while true:
        if not throwing:
            dispatch: while true:
                opcode = (Op)*pc
                pc = pc + 1
                match opcode:
                    .push_i32:
                        *sp = js_new_int32((i32)cutils.get_u32(pc))
                        sp = sp + 1
                        pc = pc + 4
                    .push_bigint_i32:
                        *sp = js_new_short_big_int_raw((i32)cutils.get_u32(pc))
                        sp = sp + 1
                        pc = pc + 4
                    .push_const:
                        *sp = js_dup_value(ctx, cpool_at(b, cutils.get_u32(pc)))
                        sp = sp + 1
                        pc = pc + 4
                    # SHORT_OPCODES
                    .push_minus1, .push_0, .push_1, .push_2, .push_3, .push_4, .push_5, .push_6, .push_7:
                        *sp = js_new_int32((i32)(u8)opcode - (i32)(u8)Op.push_0)
                        sp = sp + 1
                    .push_i8:
                        *sp = js_new_int32(cutils.get_i8(pc))
                        sp = sp + 1
                        pc = pc + 1
                    .push_i16:
                        *sp = js_new_int32(cutils.get_i16(pc))
                        sp = sp + 1
                        pc = pc + 2
                    .push_const8:
                        *sp = js_dup_value(ctx, cpool_at(b, (u32)*pc))
                        sp = sp + 1
                        pc = pc + 1
                    .fclosure8:
                        let bfunc = js_dup_value(ctx, cpool_at(b, (u32)*pc))
                        pc = pc + 1
                        *sp = js_closure(ctx, bfunc, var_refs, sf, false) catch: break dispatch
                        sp = sp + 1
                    .push_empty_string:
                        *sp = js_atom_to_string(ctx, atom_empty_string) catch: break dispatch
                        sp = sp + 1
                    # end SHORT_OPCODES
                    .push_atom_value:
                        *sp = js_atom_to_value(ctx, cutils.get_u32(pc)) catch: break dispatch
                        sp = sp + 1
                        pc = pc + 4
                    .undefined:
                        *sp = js_undefined()
                        sp = sp + 1
                    .null:
                        *sp = js_null()
                        sp = sp + 1
                    .push_this:
                        # OP_push_this is only called at the start of a function
                        var val = js_undefined()
                        if ((i32)b.js_mode & js_mode_strict) == 0 and this_obj.tag != Tag.object:
                            let tag = this_obj.tag
                            if tag == Tag.null or tag == Tag.undefined:
                                val = js_dup_value(ctx, ctx.global_obj)
                            else:
                                val = js_to_object(ctx, this_obj) catch: break dispatch
                        else:
                            # normal_this
                            val = js_dup_value(ctx, this_obj)
                        *sp = val
                        sp = sp + 1
                    .push_false:
                        *sp = js_false()
                        sp = sp + 1
                    .push_true:
                        *sp = js_true()
                        sp = sp + 1
                    .object:
                        *sp = js_new_object(ctx) catch: break dispatch
                        sp = sp + 1
                    .special_object:
                        let arg = (OpSpecialObject)*pc
                        pc = pc + 1
                        match arg:
                            .arguments:
                                *sp = js_build_arguments(ctx, argc, argv) catch: break dispatch
                                sp = sp + 1
                            .mapped_arguments:
                                *sp = js_build_mapped_arguments(ctx, argc, argv, sf, cutils.min_int(argc, (i32)b.arg_count)) catch: break dispatch
                                sp = sp + 1
                            .this_func:
                                *sp = js_dup_value(ctx, sf.cur_func)
                                sp = sp + 1
                            .new_target:
                                *sp = js_dup_value(ctx, new_target)
                                sp = sp + 1
                            .home_object:
                                if let p1 = p.u.func_.home_object:
                                    *sp = js_dup_value(ctx, js_mkptr(Tag.object, p1))
                                else:
                                    *sp = js_undefined()
                                sp = sp + 1
                            .var_object:
                                *sp = js_new_object_proto(ctx, js_null()) catch: break dispatch
                                sp = sp + 1
                            .import_meta:
                                *sp = js_import_meta(ctx) catch: break dispatch
                                sp = sp + 1
                            _:
                                trap("invalid OP_special_object argument")
                    .rest:
                        var first = (i32)cutils.get_u16(pc)
                        pc = pc + 2
                        first = cutils.min_int(first, argc)
                        *sp = js_create_array(ctx, argc - first, argv + (usize)first) catch: break dispatch
                        sp = sp + 1

                    .drop:
                        js_free_value(ctx, sp[(isize)-1])
                        sp = sp - 1
                    .nip:
                        js_free_value(ctx, sp[(isize)-2])
                        sp[(isize)-2] = sp[(isize)-1]
                        sp = sp - 1
                    .nip1: # a b c -> b c
                        js_free_value(ctx, sp[(isize)-3])
                        sp[(isize)-3] = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-1]
                        sp = sp - 1
                    .dup:
                        sp[0] = js_dup_value(ctx, sp[(isize)-1])
                        sp = sp + 1
                    .dup2: # a b -> a b a b
                        sp[0] = js_dup_value(ctx, sp[(isize)-2])
                        sp[1] = js_dup_value(ctx, sp[(isize)-1])
                        sp = sp + 2
                    .dup3: # a b c -> a b c a b c
                        sp[0] = js_dup_value(ctx, sp[(isize)-3])
                        sp[1] = js_dup_value(ctx, sp[(isize)-2])
                        sp[2] = js_dup_value(ctx, sp[(isize)-1])
                        sp = sp + 3
                    .dup1: # a b -> a a b
                        sp[0] = sp[(isize)-1]
                        sp[(isize)-1] = js_dup_value(ctx, sp[(isize)-2])
                        sp = sp + 1
                    .insert2: # obj a -> a obj a (dup_x1)
                        sp[0] = sp[(isize)-1]
                        sp[(isize)-1] = sp[(isize)-2]
                        sp[(isize)-2] = js_dup_value(ctx, sp[0])
                        sp = sp + 1
                    .insert3: # obj prop a -> a obj prop a (dup_x2)
                        sp[0] = sp[(isize)-1]
                        sp[(isize)-1] = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-3]
                        sp[(isize)-3] = js_dup_value(ctx, sp[0])
                        sp = sp + 1
                    .insert4: # this obj prop a -> a this obj prop a
                        sp[0] = sp[(isize)-1]
                        sp[(isize)-1] = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-3]
                        sp[(isize)-3] = sp[(isize)-4]
                        sp[(isize)-4] = js_dup_value(ctx, sp[0])
                        sp = sp + 1
                    .perm3: # obj a b -> a obj b (213)
                        let tmp = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-3]
                        sp[(isize)-3] = tmp
                    .rot3l: # x a b -> a b x (231)
                        let tmp = sp[(isize)-3]
                        sp[(isize)-3] = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-1]
                        sp[(isize)-1] = tmp
                    .rot4l: # x a b c -> a b c x
                        let tmp = sp[(isize)-4]
                        sp[(isize)-4] = sp[(isize)-3]
                        sp[(isize)-3] = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-1]
                        sp[(isize)-1] = tmp
                    .rot5l: # x a b c d -> a b c d x
                        let tmp = sp[(isize)-5]
                        sp[(isize)-5] = sp[(isize)-4]
                        sp[(isize)-4] = sp[(isize)-3]
                        sp[(isize)-3] = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-1]
                        sp[(isize)-1] = tmp
                    .rot3r: # a b x -> x a b (312)
                        let tmp = sp[(isize)-1]
                        sp[(isize)-1] = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-3]
                        sp[(isize)-3] = tmp
                    .perm4: # obj prop a b -> a obj prop b
                        let tmp = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-3]
                        sp[(isize)-3] = sp[(isize)-4]
                        sp[(isize)-4] = tmp
                    .perm5: # this obj prop a b -> a this obj prop b
                        let tmp = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-3]
                        sp[(isize)-3] = sp[(isize)-4]
                        sp[(isize)-4] = sp[(isize)-5]
                        sp[(isize)-5] = tmp
                    .swap: # a b -> b a
                        let tmp = sp[(isize)-2]
                        sp[(isize)-2] = sp[(isize)-1]
                        sp[(isize)-1] = tmp
                    .swap2: # a b c d -> c d a b
                        let tmp1 = sp[(isize)-4]
                        let tmp2 = sp[(isize)-3]
                        sp[(isize)-4] = sp[(isize)-2]
                        sp[(isize)-3] = sp[(isize)-1]
                        sp[(isize)-2] = tmp1
                        sp[(isize)-1] = tmp2

                    .fclosure:
                        let bfunc = js_dup_value(ctx, cpool_at(b, cutils.get_u32(pc)))
                        pc = pc + 4
                        *sp = js_closure(ctx, bfunc, var_refs, sf, false) catch: break dispatch
                        sp = sp + 1
                    # call0 to call3 are SHORT_OPCODES (C: goto has_call_argc)
                    .call0, .call1, .call2, .call3, .call, .tail_call:
                        var call_argc: i32 = 0
                        if opcode == Op.call or opcode == Op.tail_call:
                            call_argc = (i32)cutils.get_u16(pc)
                            pc = pc + 2
                        else:
                            call_argc = (i32)(u8)opcode - (i32)(u8)Op.call0
                        # has_call_argc:
                        let call_argv = sp - (usize)call_argc
                        sf.cur_pc = pc
                        ret_val = js_call_internal(ctx, call_argv[(isize)-1], js_undefined(), js_undefined(), call_argc, call_argv, 0) catch: break dispatch
                        if opcode == Op.tail_call:
                            exit = FrameExit.done
                            break frame
                        var i: isize = -1
                        while i < (isize)call_argc:
                            js_free_value(ctx, call_argv[i])
                            i += 1
                        sp = sp - (usize)(call_argc + 1)
                        *sp = ret_val
                        sp = sp + 1
                    .call_constructor:
                        let call_argc = (i32)cutils.get_u16(pc)
                        pc = pc + 2
                        let call_argv = sp - (usize)call_argc
                        sf.cur_pc = pc
                        ret_val = js_call_constructor_internal(ctx, call_argv[(isize)-2], call_argv[(isize)-1], call_argc, call_argv, 0) catch: break dispatch
                        var i: isize = -2
                        while i < (isize)call_argc:
                            js_free_value(ctx, call_argv[i])
                            i += 1
                        sp = sp - (usize)(call_argc + 2)
                        *sp = ret_val
                        sp = sp + 1
                    .call_method, .tail_call_method:
                        let call_argc = (i32)cutils.get_u16(pc)
                        pc = pc + 2
                        let call_argv = sp - (usize)call_argc
                        sf.cur_pc = pc
                        ret_val = js_call_internal(ctx, call_argv[(isize)-1], call_argv[(isize)-2], js_undefined(), call_argc, call_argv, 0) catch: break dispatch
                        if opcode == Op.tail_call_method:
                            exit = FrameExit.done
                            break frame
                        var i: isize = -2
                        while i < (isize)call_argc:
                            js_free_value(ctx, call_argv[i])
                            i += 1
                        sp = sp - (usize)(call_argc + 2)
                        *sp = ret_val
                        sp = sp + 1
                    .array_from:
                        let call_argc = (i32)cutils.get_u16(pc)
                        pc = pc + 2
                        ret_val = js_create_array_free(ctx, call_argc, sp - (usize)call_argc) catch:
                            sp = sp - (usize)call_argc
                            break dispatch
                        sp = sp - (usize)call_argc
                        *sp = ret_val
                        sp = sp + 1

                    .apply:
                        let magic = (i32)cutils.get_u16(pc)
                        pc = pc + 2
                        sf.cur_pc = pc

                        ret_val = js_function_apply(ctx, sp[(isize)-3], 2, sp - 2, magic) catch: break dispatch
                        js_free_value(ctx, sp[(isize)-3])
                        js_free_value(ctx, sp[(isize)-2])
                        js_free_value(ctx, sp[(isize)-1])
                        sp = sp - 3
                        *sp = ret_val
                        sp = sp + 1
                    .return_:
                        sp = sp - 1
                        ret_val = *sp
                        exit = FrameExit.done
                        break frame
                    .return_undef:
                        ret_val = js_undefined()
                        exit = FrameExit.done
                        break frame

                    .check_ctor_return:
                        # return TRUE if 'this' should be returned
                        if not js_is_object(sp[(isize)-1]):
                            if not js_is_undefined(sp[(isize)-1]):
                                js_throw_type_error(caller_ctx, "derived class constructor must return an object or undefined") catch: break dispatch
                            sp[0] = js_true()
                        else:
                            sp[0] = js_false()
                        sp = sp + 1
                    .check_ctor:
                        if js_is_undefined(new_target):
                            # non_ctor_call
                            js_throw_type_error(ctx, "class constructors must be invoked with 'new'") catch: break dispatch
                    .init_ctor:
                        sf.cur_pc = pc
                        if js_is_undefined(new_target):
                            # non_ctor_call
                            js_throw_type_error(ctx, "class constructors must be invoked with 'new'") catch: break dispatch
                        let super_ = js_get_prototype(ctx, func_obj) catch: break dispatch
                        let ret = js_call_constructor2(ctx, super_, new_target, argc, argv) catch: recover js_exception()
                        js_free_value(ctx, super_)
                        if js_is_exception(ret):
                            break dispatch
                        *sp = ret
                        sp = sp + 1
                    .check_brand:
                        let ret = js_check_brand(ctx, sp[(isize)-2], sp[(isize)-1]) catch: break dispatch
                        if not ret:
                            js_throw_type_error(ctx, "invalid brand on object") catch: break dispatch
                    .add_brand:
                        js_add_brand(ctx, sp[(isize)-2], sp[(isize)-1]) catch: break dispatch
                        js_free_value(ctx, sp[(isize)-2])
                        js_free_value(ctx, sp[(isize)-1])
                        sp = sp - 2

                    .throw:
                        sp = sp - 1
                        js_throw(ctx, *sp) catch: break dispatch

                    .throw_error:
                        let atom = cutils.get_u32(pc)
                        let type_ = (i32)pc[4]
                        pc = pc + 5
                        if type_ == throw_var_ro:
                            discard(js_throw_type_error_read_only(ctx, prop_throw, atom) catch: break dispatch)
                        elif type_ == throw_var_redecl:
                            js_throw_syntax_error_var_redeclaration(ctx, atom) catch: break dispatch
                        elif type_ == throw_var_uninitialized:
                            js_throw_reference_error_uninitialized(ctx, atom) catch: break dispatch
                        elif type_ == throw_error_delete_super:
                            js_throw_reference_error(ctx, "unsupported reference to 'super'") catch: break dispatch
                        elif type_ == throw_error_iterator_throw:
                            js_throw_type_error(ctx, "iterator does not have a throw method") catch: break dispatch
                        else:
                            js_throw_internal_error(ctx, f"invalid throw var type {type_}") catch: break dispatch
                        break dispatch

                    .eval:
                        let call_argc = (i32)cutils.get_u16(pc)
                        let scope_idx = (i32)cutils.get_u16(pc + 2) + arg_scope_end
                        pc = pc + 4
                        let call_argv = sp - (usize)call_argc
                        sf.cur_pc = pc
                        if js_same_value_internal(ctx, call_argv[(isize)-1], ctx.eval_obj):
                            var obj = js_undefined()
                            if call_argc >= 1:
                                obj = call_argv[0]
                            ret_val = js_eval_object(ctx, js_undefined(), obj, eval_type_direct, scope_idx) catch: break dispatch
                        else:
                            ret_val = js_call_internal(ctx, call_argv[(isize)-1], js_undefined(), js_undefined(), call_argc, call_argv, 0) catch: break dispatch
                        var i: isize = -1
                        while i < (isize)call_argc:
                            js_free_value(ctx, call_argv[i])
                            i += 1
                        sp = sp - (usize)(call_argc + 1)
                        *sp = ret_val
                        sp = sp + 1
                    # could merge with OP_apply
                    .apply_eval:
                        let scope_idx = (i32)cutils.get_u16(pc) + arg_scope_end
                        pc = pc + 2
                        sf.cur_pc = pc
                        var len: u32 = 0
                        let tab = build_arg_list(ctx, &len, sp[(isize)-1]) catch: break dispatch
                        if js_same_value_internal(ctx, sp[(isize)-2], ctx.eval_obj):
                            var obj = js_undefined()
                            if len >= 1:
                                obj = tab[0]
                            ret_val = js_eval_object(ctx, js_undefined(), obj, eval_type_direct, scope_idx) catch: recover js_exception()
                        else:
                            ret_val = js_call(ctx, sp[(isize)-2], js_undefined(), (i32)len, tab) catch: recover js_exception()
                        free_arg_list(ctx, tab, len)
                        if js_is_exception(ret_val):
                            break dispatch
                        js_free_value(ctx, sp[(isize)-2])
                        js_free_value(ctx, sp[(isize)-1])
                        sp = sp - 2
                        *sp = ret_val
                        sp = sp + 1

                    .regexp:
                        sp[(isize)-2] = js_new_regexp(ctx, sp[(isize)-2], sp[(isize)-1]) catch: recover js_exception()
                        sp = sp - 1
                        if js_is_exception(sp[(isize)-1]):
                            break dispatch

                    .get_super:
                        sf.cur_pc = pc
                        let proto = js_get_prototype(ctx, sp[(isize)-1]) catch: break dispatch
                        js_free_value(ctx, sp[(isize)-1])
                        sp[(isize)-1] = proto

                    .import_:
                        sf.cur_pc = pc
                        let val = js_dynamic_import(ctx, sp[(isize)-2], sp[(isize)-1]) catch: break dispatch
                        js_free_value(ctx, sp[(isize)-2])
                        js_free_value(ctx, sp[(isize)-1])
                        sp = sp - 1
                        sp[(isize)-1] = val

                    .get_var_undef, .get_var:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        let val = *var_ref_at(var_refs, idx).pvalue
                        if js_is_uninitialized(val):
                            let cv = closure_var_at(b, (i32)idx)
                            if cv.is_lexical:
                                js_throw_reference_error_uninitialized(ctx, cv.var_name) catch: break dispatch
                            else:
                                sf.cur_pc = pc
                                # throw_ref_error is `opcode - OP_get_var_undef`
                                sp[0] = js_get_property_internal(ctx, ctx.global_obj, cv.var_name, ctx.global_obj, opcode == Op.get_var) catch: break dispatch
                        else:
                            sp[0] = js_dup_value(ctx, val)
                        sp = sp + 1

                    .put_var, .put_var_init:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        let var_ref = var_ref_at(var_refs, idx)
                        if js_is_uninitialized(*var_ref.pvalue) or var_ref.is_const != 0:
                            let cv = closure_var_at(b, (i32)idx)
                            if var_ref.is_lexical != 0:
                                if opcode == Op.put_var_init:
                                    # put_var_ok
                                    set_value(ctx, var_ref.pvalue, sp[(isize)-1])
                                    sp = sp - 1
                                else:
                                    if js_is_uninitialized(*var_ref.pvalue):
                                        js_throw_reference_error_uninitialized(ctx, cv.var_name) catch: break dispatch
                                    else:
                                        discard(js_throw_type_error_read_only(ctx, prop_throw, cv.var_name) catch: break dispatch)
                                    break dispatch
                            else:
                                sf.cur_pc = pc
                                var ret = bool_status(js_has_property(ctx, ctx.global_obj, cv.var_name) catch: recover none)
                                if ret < 0:
                                    break dispatch
                                if ret == 0 and is_strict_mode(ctx):
                                    js_throw_reference_error_not_defined(ctx, cv.var_name) catch: break dispatch
                                ret = bool_status(js_set_property_internal(ctx, ctx.global_obj, cv.var_name, sp[(isize)-1], ctx.global_obj, prop_throw_strict) catch: recover none)
                                sp = sp - 1
                                if ret < 0:
                                    break dispatch
                        else:
                            # put_var_ok
                            set_value(ctx, var_ref.pvalue, sp[(isize)-1])
                            sp = sp - 1
                    .get_loc:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        sp[0] = js_dup_value(ctx, var_buf[idx])
                        sp = sp + 1
                    .put_loc:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        set_value(ctx, var_buf + idx, sp[(isize)-1])
                        sp = sp - 1
                    .set_loc:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        set_value(ctx, var_buf + idx, js_dup_value(ctx, sp[(isize)-1]))
                    .get_arg:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        sp[0] = js_dup_value(ctx, arg_buf[idx])
                        sp = sp + 1
                    .put_arg:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        set_value(ctx, arg_buf + idx, sp[(isize)-1])
                        sp = sp - 1
                    .set_arg:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        set_value(ctx, arg_buf + idx, js_dup_value(ctx, sp[(isize)-1]))

                    # SHORT_OPCODES
                    .get_loc8:
                        *sp = js_dup_value(ctx, var_buf[(usize)*pc])
                        sp = sp + 1
                        pc = pc + 1
                    .put_loc8:
                        let idx = (usize)*pc
                        pc = pc + 1
                        sp = sp - 1
                        set_value(ctx, var_buf + idx, *sp)
                    .set_loc8:
                        let idx = (usize)*pc
                        pc = pc + 1
                        set_value(ctx, var_buf + idx, js_dup_value(ctx, sp[(isize)-1]))

                    .get_loc0:
                        *sp = js_dup_value(ctx, var_buf[0])
                        sp = sp + 1
                    .get_loc1:
                        *sp = js_dup_value(ctx, var_buf[1])
                        sp = sp + 1
                    .get_loc2:
                        *sp = js_dup_value(ctx, var_buf[2])
                        sp = sp + 1
                    .get_loc3:
                        *sp = js_dup_value(ctx, var_buf[3])
                        sp = sp + 1
                    .put_loc0:
                        sp = sp - 1
                        set_value(ctx, var_buf, *sp)
                    .put_loc1:
                        sp = sp - 1
                        set_value(ctx, var_buf + 1, *sp)
                    .put_loc2:
                        sp = sp - 1
                        set_value(ctx, var_buf + 2, *sp)
                    .put_loc3:
                        sp = sp - 1
                        set_value(ctx, var_buf + 3, *sp)
                    .set_loc0:
                        set_value(ctx, var_buf, js_dup_value(ctx, sp[(isize)-1]))
                    .set_loc1:
                        set_value(ctx, var_buf + 1, js_dup_value(ctx, sp[(isize)-1]))
                    .set_loc2:
                        set_value(ctx, var_buf + 2, js_dup_value(ctx, sp[(isize)-1]))
                    .set_loc3:
                        set_value(ctx, var_buf + 3, js_dup_value(ctx, sp[(isize)-1]))
                    .get_arg0:
                        *sp = js_dup_value(ctx, arg_buf[0])
                        sp = sp + 1
                    .get_arg1:
                        *sp = js_dup_value(ctx, arg_buf[1])
                        sp = sp + 1
                    .get_arg2:
                        *sp = js_dup_value(ctx, arg_buf[2])
                        sp = sp + 1
                    .get_arg3:
                        *sp = js_dup_value(ctx, arg_buf[3])
                        sp = sp + 1
                    .put_arg0:
                        sp = sp - 1
                        set_value(ctx, arg_buf, *sp)
                    .put_arg1:
                        sp = sp - 1
                        set_value(ctx, arg_buf + 1, *sp)
                    .put_arg2:
                        sp = sp - 1
                        set_value(ctx, arg_buf + 2, *sp)
                    .put_arg3:
                        sp = sp - 1
                        set_value(ctx, arg_buf + 3, *sp)
                    .set_arg0:
                        set_value(ctx, arg_buf, js_dup_value(ctx, sp[(isize)-1]))
                    .set_arg1:
                        set_value(ctx, arg_buf + 1, js_dup_value(ctx, sp[(isize)-1]))
                    .set_arg2:
                        set_value(ctx, arg_buf + 2, js_dup_value(ctx, sp[(isize)-1]))
                    .set_arg3:
                        set_value(ctx, arg_buf + 3, js_dup_value(ctx, sp[(isize)-1]))
                    .get_var_ref0:
                        *sp = js_dup_value(ctx, *var_ref_at(var_refs, 0).pvalue)
                        sp = sp + 1
                    .get_var_ref1:
                        *sp = js_dup_value(ctx, *var_ref_at(var_refs, 1).pvalue)
                        sp = sp + 1
                    .get_var_ref2:
                        *sp = js_dup_value(ctx, *var_ref_at(var_refs, 2).pvalue)
                        sp = sp + 1
                    .get_var_ref3:
                        *sp = js_dup_value(ctx, *var_ref_at(var_refs, 3).pvalue)
                        sp = sp + 1
                    .put_var_ref0:
                        sp = sp - 1
                        set_value(ctx, var_ref_at(var_refs, 0).pvalue, *sp)
                    .put_var_ref1:
                        sp = sp - 1
                        set_value(ctx, var_ref_at(var_refs, 1).pvalue, *sp)
                    .put_var_ref2:
                        sp = sp - 1
                        set_value(ctx, var_ref_at(var_refs, 2).pvalue, *sp)
                    .put_var_ref3:
                        sp = sp - 1
                        set_value(ctx, var_ref_at(var_refs, 3).pvalue, *sp)
                    .set_var_ref0:
                        set_value(ctx, var_ref_at(var_refs, 0).pvalue, js_dup_value(ctx, sp[(isize)-1]))
                    .set_var_ref1:
                        set_value(ctx, var_ref_at(var_refs, 1).pvalue, js_dup_value(ctx, sp[(isize)-1]))
                    .set_var_ref2:
                        set_value(ctx, var_ref_at(var_refs, 2).pvalue, js_dup_value(ctx, sp[(isize)-1]))
                    .set_var_ref3:
                        set_value(ctx, var_ref_at(var_refs, 3).pvalue, js_dup_value(ctx, sp[(isize)-1]))
                    # end SHORT_OPCODES

                    .get_var_ref:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        let val = *var_ref_at(var_refs, idx).pvalue
                        sp[0] = js_dup_value(ctx, val)
                        sp = sp + 1
                    .put_var_ref:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        set_value(ctx, var_ref_at(var_refs, idx).pvalue, sp[(isize)-1])
                        sp = sp - 1
                    .set_var_ref:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        set_value(ctx, var_ref_at(var_refs, idx).pvalue, js_dup_value(ctx, sp[(isize)-1]))
                    .get_var_ref_check:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        let val = *var_ref_at(var_refs, idx).pvalue
                        if js_is_uninitialized(val):
                            js_throw_reference_error_uninitialized2(ctx, b, (i32)idx, true) catch: break dispatch
                        sp[0] = js_dup_value(ctx, val)
                        sp = sp + 1
                    .put_var_ref_check:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        if js_is_uninitialized(*var_ref_at(var_refs, idx).pvalue):
                            js_throw_reference_error_uninitialized2(ctx, b, (i32)idx, true) catch: break dispatch
                        set_value(ctx, var_ref_at(var_refs, idx).pvalue, sp[(isize)-1])
                        sp = sp - 1
                    .put_var_ref_check_init:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        if not js_is_uninitialized(*var_ref_at(var_refs, idx).pvalue):
                            js_throw_reference_error_uninitialized2(ctx, b, (i32)idx, true) catch: break dispatch
                        set_value(ctx, var_ref_at(var_refs, idx).pvalue, sp[(isize)-1])
                        sp = sp - 1
                    .set_loc_uninitialized:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        set_value(ctx, var_buf + idx, js_uninitialized())
                    .get_loc_check:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        if js_is_uninitialized(var_buf[idx]):
                            js_throw_reference_error_uninitialized2(ctx, b, (i32)idx, false) catch: break dispatch
                        sp[0] = js_dup_value(ctx, var_buf[idx])
                        sp = sp + 1
                    .get_loc_checkthis:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        if js_is_uninitialized(var_buf[idx]):
                            js_throw_reference_error_uninitialized2(caller_ctx, b, (i32)idx, false) catch: break dispatch
                        sp[0] = js_dup_value(ctx, var_buf[idx])
                        sp = sp + 1
                    .put_loc_check:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        if js_is_uninitialized(var_buf[idx]):
                            js_throw_reference_error_uninitialized2(ctx, b, (i32)idx, false) catch: break dispatch
                        set_value(ctx, var_buf + idx, sp[(isize)-1])
                        sp = sp - 1
                    .set_loc_check:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        if js_is_uninitialized(var_buf[idx]):
                            js_throw_reference_error_uninitialized2(ctx, b, (i32)idx, false) catch: break dispatch
                        set_value(ctx, var_buf + idx, js_dup_value(ctx, sp[(isize)-1]))
                    .put_loc_check_init:
                        let idx = (usize)cutils.get_u16(pc)
                        pc = pc + 2
                        if not js_is_uninitialized(var_buf[idx]):
                            js_throw_reference_error(ctx, "'this' can be initialized only once") catch: break dispatch
                        set_value(ctx, var_buf + idx, sp[(isize)-1])
                        sp = sp - 1
                    .close_loc:
                        let idx = (i32)cutils.get_u16(pc)
                        pc = pc + 2
                        close_lexical_var(ctx, b, sf, idx)

                    .make_loc_ref, .make_arg_ref, .make_var_ref_ref:
                        let atom = cutils.get_u32(pc)
                        let idx = (i32)cutils.get_u16(pc + 4)
                        pc = pc + 6
                        *sp = js_new_object_proto(ctx, js_null()) catch: break dispatch
                        sp = sp + 1
                        var var_ref: VarRef* = ---
                        if opcode == Op.make_var_ref_ref:
                            var_ref = var_ref_at(var_refs, (usize)idx)
                            js_rc(var_ref).ref_count += 1
                        else:
                            var_ref = get_var_ref(ctx, sf, idx, opcode == Op.make_arg_ref) catch: break dispatch
                        let pr = add_property(ctx, sp[(isize)-1].u.obj, atom, prop_writable | prop_varref) catch:
                            free_var_ref(rt, var_ref)
                            break dispatch
                        pr.u.var_ref = var_ref
                        *sp = js_atom_to_value(ctx, atom) catch: break dispatch
                        sp = sp + 1
                    .make_var_ref:
                        let atom = cutils.get_u32(pc)
                        pc = pc + 4
                        sf.cur_pc = pc

                        js_get_global_var_ref(ctx, atom, sp) catch: break dispatch
                        sp = sp + 2

                    .goto_:
                        pc = pc + (isize)(i32)cutils.get_u32(pc)
                        js_poll_interrupts(ctx) catch: break dispatch
                    # SHORT_OPCODES
                    .goto16:
                        pc = pc + (isize)(i16)cutils.get_u16(pc)
                        js_poll_interrupts(ctx) catch: break dispatch
                    .goto8:
                        pc = pc + (isize)(i8)pc[0]
                        js_poll_interrupts(ctx) catch: break dispatch
                    # end SHORT_OPCODES
                    .if_true:
                        let op1 = sp[(isize)-1]
                        pc = pc + 4
                        var res = false
                        if (u64)op1.tag <= (u64)Tag.undefined:
                            res = js_value_get_int(op1) != 0
                        else:
                            res = js_to_bool_free(ctx, op1) catch: recover true # C: -1 is true
                        sp = sp - 1
                        if res:
                            pc = pc + (isize)((i32)cutils.get_u32(pc - 4) - 4)
                        js_poll_interrupts(ctx) catch: break dispatch
                    .if_false:
                        let op1 = sp[(isize)-1]
                        pc = pc + 4
                        var res = false
                        # quick and dirty test for JS_TAG_INT, JS_TAG_BOOL, JS_TAG_NULL and
                        # JS_TAG_UNDEFINED
                        if (u64)op1.tag <= (u64)Tag.undefined:
                            res = js_value_get_int(op1) != 0
                        else:
                            res = js_to_bool_free(ctx, op1) catch: recover true # C: -1 is true
                        sp = sp - 1
                        if not res:
                            pc = pc + (isize)((i32)cutils.get_u32(pc - 4) - 4)
                        js_poll_interrupts(ctx) catch: break dispatch
                    # SHORT_OPCODES
                    .if_true8:
                        let op1 = sp[(isize)-1]
                        pc = pc + 1
                        var res = false
                        if (u64)op1.tag <= (u64)Tag.undefined:
                            res = js_value_get_int(op1) != 0
                        else:
                            res = js_to_bool_free(ctx, op1) catch: recover true # C: -1 is true
                        sp = sp - 1
                        if res:
                            pc = pc + (isize)((i32)(i8)pc[(isize)-1] - 1)
                        js_poll_interrupts(ctx) catch: break dispatch
                    .if_false8:
                        let op1 = sp[(isize)-1]
                        pc = pc + 1
                        var res = false
                        if (u64)op1.tag <= (u64)Tag.undefined:
                            res = js_value_get_int(op1) != 0
                        else:
                            res = js_to_bool_free(ctx, op1) catch: recover true # C: -1 is true
                        sp = sp - 1
                        if not res:
                            pc = pc + (isize)((i32)(i8)pc[(isize)-1] - 1)
                        js_poll_interrupts(ctx) catch: break dispatch
                    # end SHORT_OPCODES
                    .catch_:
                        let diff = (i32)cutils.get_u32(pc)
                        sp[0] = js_new_catch_offset((i32)(pc + (isize)diff - bc_buf))
                        sp = sp + 1
                        pc = pc + 4
                    .gosub:
                        let diff = (i32)cutils.get_u32(pc)
                        # XXX: should have a different tag to avoid security flaw
                        sp[0] = js_new_int32((i32)(pc + 4 - bc_buf))
                        sp = sp + 1
                        pc = pc + (isize)diff
                    .ret:
                        let op1 = sp[(isize)-1]
                        if op1.tag != Tag.int or (u32)js_value_get_int(op1) >= (u32)b.byte_code_len:
                            # ret_fail
                            js_throw_internal_error(ctx, "invalid ret value") catch: break dispatch
                        let pos = (u32)js_value_get_int(op1)
                        sp = sp - 1
                        pc = bc_buf + (usize)pos

                    .for_in_start:
                        sf.cur_pc = pc
                        js_for_in_start(ctx, sp) catch: break dispatch
                    .for_in_next:
                        sf.cur_pc = pc
                        js_for_in_next(ctx, sp) catch: break dispatch
                        sp = sp + 2
                    .for_of_start:
                        sf.cur_pc = pc
                        js_for_of_start(ctx, sp, false) catch: break dispatch
                        sp = sp + 1
                        *sp = js_new_catch_offset(0)
                        sp = sp + 1
                    .for_of_next:
                        let offset = -3 - (i32)pc[0]
                        pc = pc + 1
                        sf.cur_pc = pc
                        js_for_of_next(ctx, sp, offset) catch: break dispatch
                        sp = sp + 2
                    .for_await_of_next:
                        sf.cur_pc = pc
                        js_for_await_of_next(ctx, sp) catch: break dispatch
                        sp = sp + 1
                    .for_await_of_start:
                        sf.cur_pc = pc
                        js_for_of_start(ctx, sp, true) catch: break dispatch
                        sp = sp + 1
                        *sp = js_new_catch_offset(0)
                        sp = sp + 1
                    .iterator_get_value_done:
                        sf.cur_pc = pc
                        js_iterator_get_value_done(ctx, sp) catch: break dispatch
                        sp = sp + 1
                    .iterator_check_object:
                        if not js_is_object(sp[(isize)-1]):
                            js_throw_type_error(ctx, "iterator must return an object") catch: break dispatch

                    .iterator_close:
                        # iter_obj next catch_offset ->
                        sp = sp - 1 # drop the catch offset to avoid getting caught by exception
                        js_free_value(ctx, sp[(isize)-1]) # drop the next method
                        sp = sp - 1
                        if not js_is_undefined(sp[(isize)-1]):
                            sf.cur_pc = pc
                            js_iterator_close(ctx, sp[(isize)-1], false) catch: break dispatch
                            js_free_value(ctx, sp[(isize)-1])
                        sp = sp - 1
                    .nip_catch:
                        # catch_offset ... ret_val -> ret_eval
                        sp = sp - 1
                        let nip_val = *sp
                        while sp > stack_buf and sp[(isize)-1].tag != Tag.catch_offset:
                            sp = sp - 1
                            js_free_value(ctx, *sp)
                        if sp == stack_buf:
                            js_throw_internal_error(ctx, "nip_catch") catch:
                                js_free_value(ctx, nip_val)
                                break dispatch
                        sp[(isize)-1] = nip_val

                    .iterator_next:
                        # stack: iter_obj next catch_offset val
                        sf.cur_pc = pc
                        let ret = js_call(ctx, sp[(isize)-3], sp[(isize)-4], 1, sp - 1) catch: break dispatch
                        js_free_value(ctx, sp[(isize)-1])
                        sp[(isize)-1] = ret

                    .iterator_call:
                        # stack: iter_obj next catch_offset val
                        let iter_flags = (i32)*pc
                        pc = pc + 1
                        sf.cur_pc = pc
                        let method = js_get_property(ctx, sp[(isize)-4], atom_throw if (iter_flags & 1) != 0 else atom_return) catch: break dispatch
                        var ret_flag = false
                        if js_is_undefined(method) or js_is_null(method):
                            ret_flag = true
                        else:
                            var ret = js_undefined()
                            if (iter_flags & 2) != 0:
                                # no argument
                                ret = js_call_free(ctx, method, sp[(isize)-4], 0, sp) catch: break dispatch
                            else:
                                ret = js_call_free(ctx, method, sp[(isize)-4], 1, sp - 1) catch: break dispatch
                            js_free_value(ctx, sp[(isize)-1])
                            sp[(isize)-1] = ret
                            ret_flag = false
                        sp[0] = js_new_bool(ret_flag)
                        sp = sp + 1

                    .lnot:
                        let op1 = sp[(isize)-1]
                        var res = false
                        if (u64)op1.tag <= (u64)Tag.undefined:
                            res = js_value_get_int(op1) != 0
                        else:
                            res = js_to_bool_free(ctx, op1) catch: recover true # C: -1 is true
                        sp[(isize)-1] = js_new_bool(not res)

                    .get_field:
                        let atom = cutils.get_u32(pc)
                        pc = pc + 4
                        let val = get_field_inline(ctx, sf, pc, sp[(isize)-1], atom) catch: break dispatch
                        js_free_value(ctx, sp[(isize)-1])
                        sp[(isize)-1] = val

                    .get_field2:
                        let atom = cutils.get_u32(pc)
                        pc = pc + 4
                        let val = get_field_inline(ctx, sf, pc, sp[(isize)-1], atom) catch: break dispatch
                        *sp = val
                        sp = sp + 1

                    # SHORT_OPCODES
                    .get_length:
                        let val = get_field_inline(ctx, sf, pc, sp[(isize)-1], atom_length) catch: break dispatch
                        js_free_value(ctx, sp[(isize)-1])
                        sp[(isize)-1] = val

                    .put_field:
                        let atom = cutils.get_u32(pc)
                        pc = pc + 4

                        let obj = sp[(isize)-2]
                        var fast = false
                        if obj.tag == Tag.object:
                            var pr: Property*? = none
                            if let prs = find_own_property(&pr, obj.u.obj, atom):
                                if ((i32)prs.flags & (prop_tmask | prop_writable | prop_length)) == prop_writable:
                                    # fast path
                                    let found = pr else trap("find_own_property found no property")
                                    set_value(ctx, &found.u.value, sp[(isize)-1])
                                    fast = true
                        if fast:
                            js_free_value(ctx, obj)
                            sp = sp - 2
                        else:
                            # put_field_slow_path
                            sf.cur_pc = pc
                            let ret = bool_status(js_set_property_internal(ctx, obj, atom, sp[(isize)-1], obj, prop_throw_strict) catch: recover none)
                            js_free_value(ctx, obj)
                            sp = sp - 2
                            if ret < 0:
                                break dispatch

                    .private_symbol:
                        let atom = cutils.get_u32(pc)
                        pc = pc + 4
                        let val = js_new_symbol_from_atom(ctx, atom, js_atom_type_private) catch: break dispatch
                        *sp = val
                        sp = sp + 1

                    .get_private_field:
                        let val = js_get_private_field(ctx, sp[(isize)-2], sp[(isize)-1]) catch: recover js_exception()
                        js_free_value(ctx, sp[(isize)-1])
                        js_free_value(ctx, sp[(isize)-2])
                        sp[(isize)-2] = val
                        sp = sp - 1
                        if js_is_exception(val):
                            break dispatch

                    .put_private_field:
                        var ret: i32 = 0
                        js_set_private_field(ctx, sp[(isize)-3], sp[(isize)-1], sp[(isize)-2]) catch:
                            ret = -1
                            recover ()
                        js_free_value(ctx, sp[(isize)-3])
                        js_free_value(ctx, sp[(isize)-1])
                        sp = sp - 3
                        if ret < 0:
                            break dispatch

                    .define_private_field:
                        var ret: i32 = 0
                        js_define_private_field(ctx, sp[(isize)-3], sp[(isize)-2], sp[(isize)-1]) catch:
                            ret = -1
                            recover ()
                        js_free_value(ctx, sp[(isize)-2])
                        sp = sp - 2
                        if ret < 0:
                            break dispatch

                    .define_field:
                        let atom = cutils.get_u32(pc)
                        pc = pc + 4

                        discard(js_define_property_value(ctx, sp[(isize)-2], atom, sp[(isize)-1], prop_c_w_e | prop_throw) catch:
                            sp = sp - 1
                            break dispatch)
