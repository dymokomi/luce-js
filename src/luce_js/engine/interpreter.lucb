                    .set_name:
                        let atom = cutils.get_u32(pc)
                        pc = pc + 4

                        js_define_object_name(ctx, sp[(isize)-1], atom, prop_configurable) catch: break dispatch
                    .set_name_computed:
                        js_define_object_name_computed(ctx, sp[(isize)-1], sp[(isize)-2], prop_configurable) catch: break dispatch
                    .set_proto:
