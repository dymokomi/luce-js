                        let op1 = sp[(isize)-2]
                        let op2 = sp[(isize)-1]
                        var slow = false
                        if js_value_is_both_int(op1, op2):
                            let r = (i64)js_value_get_int(op1) + (i64)js_value_get_int(op2)
                            if (i64)(i32)r != r:
                                sp[(isize)-2] = js_new_float64_raw(f64(r))
                            else:
                                sp[(isize)-2] = js_new_int32((i32)r)
