# Constants of unported regions that ported code already uses. The region that declares
# each one deletes it here.

# quickjs.c:16190 (region r13): the variable index flags of the scope opcodes.
let global_var_offset: i32 = 0x40000000
let argument_var_offset: i32 = 0x20000000

# quickjs.c:39802 (region r22): the flags of JS_NewCConstructor.
let new_ctor_no_global: i32 = 1 << 0
let new_ctor_proto_class: i32 = 1 << 1
let new_ctor_proto_exist: i32 = 1 << 2
let new_ctor_readonly: i32 = 1 << 3

# quickjs.c:42112 and 42276 (region r23): the magic of js_array_every and js_array_reduce.
let special_every: i32 = 0
let special_some: i32 = 1
let special_for_each: i32 = 2
let special_map: i32 = 3
let special_filter: i32 = 4
let special_ta: i32 = 8
let special_reduce: i32 = 0
let special_reduce_right: i32 = 1

# quickjs.c:42548 (region r23): the modes of js_array_find.
let array_find: i32 = 0
let array_find_index: i32 = 1
let array_find_last: i32 = 2
let array_find_last_index: i32 = 3

# Builtin tables of unported regions that ported code already uses (the intrinsics of
# quickjs.c 56379-56730 name them). Each placeholder is one inert entry; the region that
# declares the real table deletes its line here.
let unported_function_list: CFunctionListEntry[1] = [
    CFunctionListEntry(name = "unported", def_type = def_prop_undefined),
]
# region r22 (quickjs.c 41006-41575)
