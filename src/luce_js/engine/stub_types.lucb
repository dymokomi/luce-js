#==============================================================================================
#
#   stub_types - Not yet ported: placeholders for types declared inside regions
#
#   DESCRIPTION:
#       Each placeholder is deleted when the fragment that ports its region declares the
#       real type. The file is deleted when it is empty.
#
#==============================================================================================

struct ArrayIteratorData:
    var unported: i32

struct AsyncFromSyncIteratorData:
    var unported: i32

struct AsyncGeneratorData:
    var unported: i32

struct BCReaderState:
    var unported: i32

struct BCWriterState:
    var unported: i32

struct ClassFieldsDef:
    var unported: i32

struct CodeContext:
    var unported: i32

struct ExecModuleList:
    var unported: i32

struct GeneratorData:
    var unported: i32

struct GetExportNamesState:
    var unported: i32

struct IteratorConcatData:
    var unported: i32

struct IteratorHelperData:
    var unported: i32

struct IteratorWrapData:
    var unported: i32

struct JSONParseRecord:
    var unported: i32

struct JSONParseRecordObject:
    var unported: i32

struct JSONStringifyContext:
    var unported: i32

struct MapIteratorData:
    var unported: i32

struct ObjectList:
    var unported: i32

struct ParsePos:
    var unported: i32

struct PrintValueOptions:
    var unported: i32

struct PrintValueState:
    var unported: i32

struct PromiseData:
