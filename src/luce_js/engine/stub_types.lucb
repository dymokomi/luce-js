#==============================================================================================
#
#   stub_types - Not yet ported: placeholders for types declared inside regions
#
#   DESCRIPTION:
#       Each placeholder is deleted when the fragment that ports its region declares the
#       real type. The file is deleted when it is empty.
#
#==============================================================================================

struct ArrayIteratorData:
    var unported: i32

struct AsyncFromSyncIteratorData:
    var unported: i32

struct AsyncGeneratorData:
    var unported: i32

struct BCReaderState:
    var unported: i32

struct BCWriterState:
    var unported: i32

struct ClassFieldsDef:
    var unported: i32

struct CodeContext:
    var unported: i32

struct ExecModuleList:
    var unported: i32

struct GeneratorData:
    var unported: i32

struct GetExportNamesState:
    var unported: i32

struct IteratorConcatData:
    var unported: i32

struct IteratorHelperData:
    var unported: i32

struct IteratorWrapData:
    var unported: i32

struct JSONParseRecord:
    var unported: i32

struct JSONParseRecordObject:
    var unported: i32

struct JSONStringifyContext:
    var unported: i32

struct MapIteratorData:
    var unported: i32

struct ParsePos:
    var unported: i32

struct PrintValueOptions:
    var unported: i32

struct PrintValueState:
    var unported: i32

struct PromiseData:
    var unported: i32

struct PromiseFunctionData:
    var unported: i32

struct PromiseFunctionDataResolved:
    var unported: i32

struct PromiseReactionData:
    var unported: i32

struct RegExpStringIteratorData:
    var unported: i32

struct ResolveState:
    var unported: i32

struct SumPreciseState:
    var unported: i32

struct ValueBuffer:
    var unported: i32

enum PutLValueKind as i32:
    unported = 0

enum ResolveResult as i32:
    unported = 0

enum StrictEqMode as i32:
    unported = 0

# The cases are those of quickjs.c's JSVarDefEnum (region r17), which region r20 passes
# to define_var.
enum VarDefKind as i32:
    with_ = 0
    let_ = 1
    const_ = 2
    ## Function declaration.
    function_decl = 3
    ## Async/generator function declaration.
    new_function_decl = 4
    catch_ = 5
    var_ = 6

type PrintValueWrite = func() -> unit

# Constants of unported regions that ported code already uses. The region that declares
# each one deletes it here.

# quickjs.c:16190 (region r13): the variable index flags of the scope opcodes.
let global_var_offset: i32 = 0x40000000
let argument_var_offset: i32 = 0x20000000

# quickjs.c:24784 (region r17): the bits js_parse_skip_parens_token answers.
let skip_has_assignment: i32 = 1 << 2
