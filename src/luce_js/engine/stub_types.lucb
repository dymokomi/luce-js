# Constants of unported regions that ported code already uses. The region that declares
# each one deletes it here.

# quickjs.c:16190 (region r13): the variable index flags of the scope opcodes.
let global_var_offset: i32 = 0x40000000
let argument_var_offset: i32 = 0x20000000

# quickjs.c:17424 (region r13): js_op_define_class's class flags.
let js_define_class_has_heritage: i32 = 1 << 0

# quickjs.c:19328 (region r14): the flags operand of OP_define_method.
let op_define_method_method: i32 = 0
let op_define_method_getter: i32 = 1
let op_define_method_setter: i32 = 2
let op_define_method_enumerable: i32 = 4
