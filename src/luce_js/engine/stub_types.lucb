#==============================================================================================
#
#   stub_types - Not yet ported: placeholders for types declared inside regions
#
#   DESCRIPTION:
#       Each placeholder is deleted when the fragment that ports its region declares the
#       real type. The file is deleted when it is empty.
#
#==============================================================================================

struct ArrayIteratorData:
    var unported: i32

struct AsyncFromSyncIteratorData:
    var unported: i32

struct AsyncGeneratorData:
    var unported: i32

struct ClassFieldsDef:
    var unported: i32

struct CodeContext:
    var unported: i32

struct GeneratorData:
    var unported: i32

struct IteratorConcatData:
    var unported: i32

struct IteratorHelperData:
    var unported: i32

struct IteratorWrapData:
    var unported: i32

struct JSONParseRecord:
    var unported: i32

struct JSONParseRecordObject:
    var unported: i32

struct JSONStringifyContext:
    var unported: i32

struct MapIteratorData:
    var unported: i32

struct ObjectList:
    var unported: i32

struct ParsePos:
    var unported: i32

struct PromiseData:
    var unported: i32

struct PromiseFunctionData:
    var unported: i32

struct PromiseFunctionDataResolved:
    var unported: i32

struct PromiseReactionData:
    var unported: i32

struct RegExpStringIteratorData:
    var unported: i32

struct StackSizeState:
    var unported: i32

struct SumPreciseState:
    var unported: i32

struct ValueBuffer:
    var unported: i32

enum PutLValueKind as i32:
    unported = 0

## The kinds of variable definition (JSVarDefEnum, quickjs.c:24293). Declared here with
## its real cases because module_parse (r18) uses them; region 17 moves it to its fragment.
enum VarDefKind as i32:
    with_ = 0
    let_ = 1
    const_ = 2
    function_decl = 3 # function declaration
    new_function_decl = 4 # async/generator function declaration
    catch_ = 5
    var_ = 6
