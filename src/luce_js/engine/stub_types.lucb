# quickjs.c:26066 (region r17, first half): declared here so the second half of the
# parser can name its cases; the fragment porting get_lvalue/put_lvalue moves it.
enum PutLValueKind as i32:
    ## [depth] v ->
    nokeep = 0
    ## [depth] v -> , keep depth (currently just disable optimizations)
    nokeep_depth = 1
    ## [depth] v -> v
    keep_top = 2
    ## [depth] v0 v -> v0
    keep_second = 3
    ## v [depth] ->
    nokeep_bottom = 4

# quickjs.c:24293 (region r17, first half, JSVarDefEnum): declared here so the second
# half of the parser can name its cases; the fragment porting define_var moves it.
enum VarDefKind as i32:
    with_ = 0
    let_ = 1
    const_ = 2
    ## function declaration
    function_decl = 3
    ## async/generator function declaration
    new_function_decl = 4
    catch_ = 5
    var_ = 6

# mark: Declared by other regions ===============================================================

# Placeholders for the builtin tables of the typed arrays region (r28) that
# js_add_intrinsic_typed_arrays (r29) installs; delete them when r28's real tables arrive.
let js_array_buffer_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_array_buffer_proto_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_shared_array_buffer_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_shared_array_buffer_proto_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_typed_array_base_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_typed_array_base_proto_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_uint8array_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_uint8array_proto_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_typed_array_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]
let js_dataview_proto_funcs: CFunctionListEntry[1] = [CFunctionListEntry(name = "unported", def_type = def_prop_undefined)]

# quickjs.c:24784 (region r17): the bits js_parse_skip_parens_token answers.
let skip_has_assignment: i32 = 1 << 2

# quickjs.c:25085 (region r17, first half): the parse_flags of the expression parser.
# allow the 'in' binary operator
let pf_in_accepted: i32 = 1 << 0
# allow function calls parsing in js_parse_postfix_expr()
let pf_postfix_call: i32 = 1 << 1
# allow the exponentiation operator in js_parse_unary()
let pf_pow_allowed: i32 = 1 << 2
# forbid the exponentiation operator in js_parse_unary()
let pf_pow_forbidden: i32 = 1 << 3

# quickjs.c:24781 (region r17, first half): the bits js_parse_skip_parens_token answers.
let skip_has_semi: i32 = 1 << 0
let skip_has_ellipsis: i32 = 1 << 1
