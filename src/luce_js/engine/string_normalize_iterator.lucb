let js_string_proto_normalize: CFunctionListEntry[2] = [
    CFunctionListEntry(name = "normalize", def_type = def_cfunc, length = 0, generic = js_string_normalize),
    CFunctionListEntry(name = "localeCompare", def_type = def_cfunc, length = 1, generic = js_string_locale_compare),
]

## Add String.prototype.normalize and localeCompare to the context
## (JS_AddIntrinsicStringNormalize).
pub func js_add_intrinsic_string_normalize(ctx: Context*) -> !:
    let protos = ctx.class_proto else trap("js_add_intrinsic_string_normalize: no class prototypes")
    try js_set_property_function_list(ctx, protos[(usize)ClassId.string], js_string_proto_normalize)
