## The methods of WeakSet.prototype.
let js_weak_set_proto_funcs: CFunctionListEntry[4] = [
    CFunctionListEntry(name = "add", def_type = def_cfunc, length = 1,
                       cproto = CFunctionEnum.generic_magic, generic_magic = js_map_set,
                       magic = (i16)(magic_set | magic_weak)),
    CFunctionListEntry(name = "has", def_type = def_cfunc, length = 1,
                       cproto = CFunctionEnum.generic_magic, generic_magic = js_map_has,
                       magic = (i16)(magic_set | magic_weak)),
    CFunctionListEntry(name = "delete", def_type = def_cfunc, length = 1,
                       cproto = CFunctionEnum.generic_magic, generic_magic = js_map_delete,
                       magic = (i16)(magic_set | magic_weak)),
    CFunctionListEntry(name = "[Symbol.toStringTag]", prop_flags = (u8)prop_configurable,
                       def_type = def_prop_string, string_value = "WeakSet"),
]

## The prototype tables of Map, Set, WeakMap, WeakSet, and the Map and Set iterators, in
## ClassId order from ClassId.map (js_map_proto_funcs_ptr and js_map_proto_funcs_count).
let js_map_proto_funcs_ptr: const CFunctionListEntry*[6] = [
    &js_map_proto_funcs[0],
    &js_set_proto_funcs[0],
    &js_weak_map_proto_funcs[0],
    &js_weak_set_proto_funcs[0],
    &js_map_iterator_proto_funcs[0],
    &js_set_iterator_proto_funcs[0],
]

# the lengths of the tables above (an array's length is not a constant expression)
let js_map_proto_funcs_count: u8[6] = [14, 18, 7, 4, 2, 2]

## Add Map, Set, WeakMap, WeakSet and the Map and Set iterator prototypes to the context
## (JS_AddIntrinsicMapSet).
pub func js_add_intrinsic_map_set(ctx: Context*) -> !:
    var buf: u8[atom_get_str_buf_size] = ---

    for i: i32 in 0..<4:
        let name = js_atom_get_str(ctx, buf, atom_Map + (u32)i)
        var ft: CFunctionType = ---
        ft.constructor_magic = js_map_constructor
        let n_ctor_fields = (i32)js_map_funcs.length if i < 2 else 0
        let obj1 = try js_new_c_constructor(ctx, (i32)ClassId.map + i, name.bytes.data,
                                            ft.generic, 0, CFunctionEnum.constructor_magic, i,
                                            js_undefined(),
                                            &js_map_funcs[0], n_ctor_fields,
                                            js_map_proto_funcs_ptr[(usize)i],
                                            (i32)js_map_proto_funcs_count[(usize)i],
                                            0)
        js_free_value(ctx, obj1)

    for i: i32 in 0..<2:
        let class_proto = context_class_proto(ctx)
        # upstream stores the JS_EXCEPTION marker in the slot on failure; the slot keeps
        # its previous value here
        let proto = try js_new_object_proto_list(ctx, class_proto[(usize)ClassId.iterator],
                                                 js_map_proto_funcs_ptr[(usize)(i + 4)],
                                                 (i32)js_map_proto_funcs_count[(usize)(i + 4)])
        class_proto[(usize)((i32)ClassId.map_iterator + i)] = proto

# mark: Generators ==============================================================================

## The members of %GeneratorFunction.prototype%.
let js_generator_function_proto_funcs: CFunctionListEntry[1] = [
    CFunctionListEntry(name = "[Symbol.toStringTag]", prop_flags = (u8)prop_configurable,
                       def_type = def_prop_string, string_value = "GeneratorFunction"),
]

## The methods of %GeneratorPrototype%; the magic is GEN_MAGIC_NEXT (0), GEN_MAGIC_RETURN
## (1) or GEN_MAGIC_THROW (2) of js_generator_next.
let js_generator_proto_funcs: CFunctionListEntry[4] = [
    CFunctionListEntry(name = "next", def_type = def_cfunc, length = 1,
                       cproto = CFunctionEnum.iterator_next, iterator_next = js_generator_next, magic = 0),
    CFunctionListEntry(name = "return", def_type = def_cfunc, length = 1,
                       cproto = CFunctionEnum.iterator_next, iterator_next = js_generator_next, magic = 1),
    CFunctionListEntry(name = "throw", def_type = def_cfunc, length = 1,
                       cproto = CFunctionEnum.iterator_next, iterator_next = js_generator_next, magic = 2),
    CFunctionListEntry(name = "[Symbol.toStringTag]", prop_flags = (u8)prop_configurable,
                       def_type = def_prop_string, string_value = "Generator"),
]
