#==============================================================================================
#
#   map_tables - The function lists of Map, Set, WeakMap, WeakSet and generators
#
#   DESCRIPTION:
#       Port of quickjs.c lines 53201-53331: the builtin tables of the four map classes
#       and their iterators, JS_AddIntrinsicMapSet, and the tables of GeneratorFunction and
#       Generator prototypes (installed by JS_AddIntrinsicBaseObjects).
#
#==============================================================================================

# mark: Map and Set =============================================================================

## The static members of Map and Set.
let js_map_funcs: CFunctionListEntry[2] = [
    CFunctionListEntry(name = "groupBy", def_type = def_cfunc, length = 2,
                       cproto = CFunctionEnum.generic_magic, generic_magic = js_object_group_by, magic = 1),
    CFunctionListEntry(name = "[Symbol.species]", prop_flags = (u8)prop_configurable, def_type = def_cgetset,
                       getter = js_get_this),
]

