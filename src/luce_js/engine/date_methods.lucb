#==============================================================================================
#
#   date_methods - The other Date methods, the Date tables and intrinsics, and
#                  JS_ToBigIntCtorFree
#
#   DESCRIPTION:
#       Port of quickjs.c lines 55957-56230: Date.now, Date.prototype's
#       Symbol.toPrimitive, getTimezoneOffset, getTime, setTime, setYear and toJSON, the
#       function lists of Date and Date.prototype, JS_NewDate, JS_AddIntrinsicDate,
#       JS_AddIntrinsicEval and the conversion the BigInt constructor applies to its
#       argument.
#
#==============================================================================================

# mark: Methods =================================================================================

## Date.now().
func js_date_now(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    # now()
    return js_new_int64(date_now())

## Date.prototype[Symbol.toPrimitive](hint).
func js_date_symbol_to_primitive(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    # Symbol_toPrimitive(hint)
    let obj = this_val
    var hint = no_atom
    var hint_num: i32 = 0

    if not js_is_object(obj):
        try js_throw_type_error_not_an_object(ctx)

    if js_is_string(argv[0]):
        hint = try js_value_to_atom(ctx, argv[0])
        js_free_atom(ctx, hint)
    if hint == atom_number or hint == atom_integer:
        hint_num = hint_number
    elif hint == atom_string or hint == atom_default:
        hint_num = hint_string
    else:
        try js_throw_type_error(ctx, "invalid hint")
    return try js_to_primitive(ctx, obj, hint_num | hint_force_ordinary)

## Date.prototype.getTimezoneOffset().
func js_date_get_timezone_offset(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    # getTimezoneOffset()
    var v: f64 = 0.0

    try js_this_time_value(ctx, &v, this_val)
    if math.is_nan(v):
        return js_nan()
    else:
        # assuming -8.64e15 <= v <= -8.64e15
        return js_new_int64((i64)get_timezone_offset((i64)math.trunc(v)))

## Date.prototype.getTime() and valueOf().
func js_date_get_time(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    # getTime()
    var v: f64 = 0.0

    try js_this_time_value(ctx, &v, this_val)
    return js_new_float64(v)

## Date.prototype.setTime(v).
func js_date_set_time(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    # setTime(v)
    var v: f64 = 0.0

    try js_this_time_value(ctx, &v, this_val)
    try js_to_float64(ctx, &v, argv[0])
    return try js_set_this_time_value(ctx, this_val, time_clip(v))

## Date.prototype.setYear(y).
func js_date_set_year(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    # setYear(y)
    var y: f64 = 0.0

    try js_this_time_value(ctx, &y, this_val)
    try js_to_float64(ctx, &y, argv[0])
    if math.is_finite(y):
        y = math.trunc(y)
        if y >= 0.0 and y < 100.0:
            y += 1900.0
    var args: Value[1] = [js_new_float64(y)]
    return try set_date_field(ctx, this_val, 1, &args[0], 0x011)

## Date.prototype.toJSON(key).
func js_date_to_json(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    # toJSON(key)
    var d: f64 = 0.0

    let obj = try js_to_object(ctx, this_val)
    defer js_free_value(ctx, obj)
    let tv = try js_to_primitive(ctx, obj, hint_number)
    defer js_free_value(ctx, tv)
    if js_is_number(tv):
        try js_to_float64(ctx, &d, tv)
        if not math.is_finite(d):
            return js_null()
    let method = try js_get_property(ctx, obj, atom_toISOString)
    if not js_is_function(ctx, method):
        js_throw_type_error(ctx, "object needs toISOString method") catch failure:
            js_free_value(ctx, method)
            error(failure.code, failure.message)
    var no_args = js_undefined()
    return try js_call_free(ctx, method, obj, 0, &no_args)

