# mark: Intrinsics ==============================================================================

## A new Date of the time value `epoch_ms` (JS_NewDate).
pub func js_new_date(ctx: Context*, epoch_ms: f64) -> Value!:
    let obj = try js_create_from_ctor(ctx, js_undefined(), (u32)ClassId.date)
    js_set_object_data(ctx, obj, js_new_float64_raw(time_clip(epoch_ms))) catch: recover ()
    return obj

## Add Date to the context (JS_AddIntrinsicDate).
pub func js_add_intrinsic_date(ctx: Context*) -> !:
    # Date
    let obj = try js_new_c_constructor(ctx, (i32)(u16)ClassId.date, "Date",
                                       js_date_constructor, 7, CFunctionEnum.constructor_or_func, 0,
                                       js_undefined(),
                                       js_date_funcs,
                                       js_date_proto_funcs,
                                       0)
    js_free_value(ctx, obj)

## Enable eval() in the context (JS_AddIntrinsicEval).
pub func js_add_intrinsic_eval(ctx: Context*) -> i32:
    ctx.eval_internal = js_eval_internal_raw
    return 0

# mark: BigInt ==================================================================================

## ToBigInt as the BigInt constructor applies it: numbers that are integers convert too.
## Takes ownership of `val` (JS_ToBigIntCtorFree).
func js_to_bigint_ctor_free(ctx: Context*, val0: Value) -> Value!:
    var val = val0
    # redo:
    while true:
        match val.tag:
            .int, .boolean:
                return try js_new_bigint64(ctx, (i64)js_value_get_int(val))
            .short_big_int, .big_int:
                return val
            .float64:
                let d = js_value_get_float64(val)
                var res: i32 = 0
                # a memory error fails here (C: r is NULL and res is 0)
                let r = try js_bigint_from_float64(ctx, &res, d)
                if let big = r:
                    return js_compact_bigint(ctx, big)
                elif res == 1:
                    try js_throw_range_error(ctx, "cannot convert to BigInt: not an integer")
                else:
                    try js_throw_range_error(ctx, "cannot convert NaN or Infinity to BigInt")
            .string, .string_rope:
                return try js_string_to_bigint_err(ctx, val)
            .object:
                val = try js_to_primitive_free(ctx, val, hint_number)
            _:
                # null, undefined and the other tags
                js_free_value(ctx, val)
                try js_throw_type_error(ctx, "cannot convert to BigInt")
