    # ClassId.boolean
    ClassShortDef(atom_Boolean, js_object_data_finalizer, js_object_data_mark),
    # ClassId.symbol
    ClassShortDef(atom_Symbol, js_object_data_finalizer, js_object_data_mark),
    # ClassId.arguments
    ClassShortDef(atom_Arguments, js_array_finalizer, js_array_mark),
    # ClassId.mapped_arguments
    ClassShortDef(atom_Arguments, js_mapped_arguments_finalizer, js_mapped_arguments_mark),
    # ClassId.date
