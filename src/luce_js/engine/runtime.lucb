#==============================================================================================
#
#   runtime - Creating a runtime: the standard classes, the stack check, the host allocator
#
#   DESCRIPTION:
#       Port of quickjs.c lines 1965-2335: the table of the standard classes, the stack
#       overflow check (CONFIG_STACK_CHECK is on: the stack pointer is the address of a
#       local), JS_NewRuntime2 and JS_NewRuntime, the default host allocator with its
#       memory limit and accounting, the runtime's setters and getters, and the job
#       queue.
#
#==============================================================================================

# mark: Standard classes ========================================================================

## A class of the standard table: its name, finalizer and marking function
## (JSClassShortDef).
struct ClassShortDef:
    var class_name: Atom
    var finalizer: ClassFinalizer?
    var gc_mark: ClassGCMark?

## The classes from ClassId.object to ClassId.rawjson, in ClassId order.
let js_std_class_def: ClassShortDef[50] = [
    # ClassId.object
    ClassShortDef(atom_Object, none, none),
    # ClassId.array
    ClassShortDef(atom_Array, js_array_finalizer, js_array_mark),
    # ClassId.error
    ClassShortDef(atom_Error, none, none),
    # ClassId.number
    ClassShortDef(atom_Number, js_object_data_finalizer, js_object_data_mark),
    # ClassId.string
