## The body of OP_make_loc_ref, OP_make_arg_ref, OP_make_var_ref_ref in JS_CallInternal.
noinline func interp_make_loc_ref(st: InterpState*) -> bool:
    let atom = cutils.get_u32(st.pc)
    let idx = (i32)cutils.get_u16(st.pc + 4)
    st.pc = st.pc + 6
    *st.sp = js_new_object_proto(st.ctx, js_null()) catch: return false
    st.sp = st.sp + 1
    var var_ref: VarRef* = ---
    if st.opcode == Op.make_var_ref_ref:
        var_ref = var_ref_at(st.var_refs, (usize)idx)
        js_rc(var_ref).ref_count += 1
    else:
        var_ref = get_var_ref(st.ctx, st.sf, idx, st.opcode == Op.make_arg_ref) catch: return false
    let pr = add_property(st.ctx, st.sp[-1].u.obj, atom, prop_writable | prop_varref) catch:
        free_var_ref(st.rt, var_ref)
        return false
    pr.u.var_ref = var_ref
    *st.sp = js_atom_to_value(st.ctx, atom) catch: return false
    st.sp = st.sp + 1
    return true

## The body of OP_make_var_ref in JS_CallInternal.
noinline func interp_make_var_ref(st: InterpState*) -> bool:
    let atom = cutils.get_u32(st.pc)
    st.pc = st.pc + 4
    st.sf.cur_pc = st.pc

    js_get_global_var_ref(st.ctx, atom, st.sp) catch: return false
    st.sp = st.sp + 2
    return true
