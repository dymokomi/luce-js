noinline func interp_put_var_ref_check(st: InterpState*) -> bool:
    let idx = (usize)cutils.get_u16(st.pc)
    st.pc = st.pc + 2
    if js_is_uninitialized(*var_ref_at(st.var_refs, idx).pvalue):
        js_throw_reference_error_uninitialized2(st.ctx, st.b, (i32)idx, true) catch: return false
    set_value(st.ctx, var_ref_at(st.var_refs, idx).pvalue, st.sp[-1])
    st.sp = st.sp - 1
    return true

## The body of OP_put_var_ref_check_init in JS_CallInternal.
noinline func interp_put_var_ref_check_init(st: InterpState*) -> bool:
    let idx = (usize)cutils.get_u16(st.pc)
    st.pc = st.pc + 2
    if not js_is_uninitialized(*var_ref_at(st.var_refs, idx).pvalue):
        js_throw_reference_error_uninitialized2(st.ctx, st.b, (i32)idx, true) catch: return false
    set_value(st.ctx, var_ref_at(st.var_refs, idx).pvalue, st.sp[-1])
    st.sp = st.sp - 1
    return true

