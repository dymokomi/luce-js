#==============================================================================================
#
#   interp_ops_variables - Opcodes: global, local, argument and closure variables
#
#   DESCRIPTION:
#       Port of the opcode bodies of JS_CallInternal, quickjs.c lines 18461-18821:
#       OP_get_var_undef to OP_make_var_ref. Each body is a function taking the interpreter
#       state (InterpState, see interpreter_support.lucb); the dispatch loop calls it from its
#       arm. A body that can raise answers false with the exception pending, which the loop
#       treats as C's `goto exception`; one that cannot raise answers nothing.
#
#==============================================================================================

# mark: Global variables ========================================================================

## The body of OP_get_var_undef, OP_get_var in JS_CallInternal.
noinline func interp_get_var_undef(st: InterpState*) -> bool:
    let idx = (usize)cutils.get_u16(st.pc)
    st.pc = st.pc + 2
    let val = *var_ref_at(st.var_refs, idx).pvalue
    if js_is_uninitialized(val):
        let cv = closure_var_at(st.b, (i32)idx)
        if cv.is_lexical:
            js_throw_reference_error_uninitialized(st.ctx, cv.var_name) catch: return false
        else:
            st.sf.cur_pc = st.pc
            # throw_ref_error is `opcode - OP_get_var_undef`
            st.sp[0] = js_get_property_internal(st.ctx, st.ctx.global_obj, cv.var_name, st.ctx.global_obj, st.opcode == Op.get_var) catch: return false
    else:
        st.sp[0] = js_dup_value(st.ctx, val)
    st.sp = st.sp + 1
    return true

## The body of OP_put_var, OP_put_var_init in JS_CallInternal.
noinline func interp_put_var(st: InterpState*) -> bool:
    let idx = (usize)cutils.get_u16(st.pc)
    st.pc = st.pc + 2
    let var_ref = var_ref_at(st.var_refs, idx)
    if js_is_uninitialized(*var_ref.pvalue) or var_ref.is_const != 0:
        let cv = closure_var_at(st.b, (i32)idx)
        if var_ref.is_lexical != 0:
            if st.opcode == Op.put_var_init:
                # put_var_ok
                set_value(st.ctx, var_ref.pvalue, st.sp[-1])
                st.sp = st.sp - 1
            else:
                if js_is_uninitialized(*var_ref.pvalue):
                    js_throw_reference_error_uninitialized(st.ctx, cv.var_name) catch: return false
                else:
                    discard(js_throw_type_error_read_only(st.ctx, prop_throw, cv.var_name) catch: return false)
                return false
        else:
            st.sf.cur_pc = st.pc
            var ret = bool_status(js_has_property(st.ctx, st.ctx.global_obj, cv.var_name) catch: recover none)
            if ret < 0:
                return false
            if ret == 0 and is_strict_mode(st.ctx):
                js_throw_reference_error_not_defined(st.ctx, cv.var_name) catch: return false
            ret = bool_status(js_set_property_internal(st.ctx, st.ctx.global_obj, cv.var_name, st.sp[-1], st.ctx.global_obj, prop_throw_strict) catch: recover none)
            st.sp = st.sp - 1
            if ret < 0:
                return false
    else:
        # put_var_ok
        set_value(st.ctx, var_ref.pvalue, st.sp[-1])
        st.sp = st.sp - 1
    return true

