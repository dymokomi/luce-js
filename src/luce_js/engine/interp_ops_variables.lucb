# mark: Checked variables and references ========================================================

## The body of OP_get_var_ref_check in JS_CallInternal.
noinline func interp_get_var_ref_check(st: InterpState*) -> bool:
    let idx = (usize)cutils.get_u16(st.pc)
    st.pc = st.pc + 2
    let val = *var_ref_at(st.var_refs, idx).pvalue
    if js_is_uninitialized(val):
        js_throw_reference_error_uninitialized2(st.ctx, st.b, (i32)idx, true) catch: return false
    st.sp[0] = js_dup_value(st.ctx, val)
    st.sp = st.sp + 1
    return true

