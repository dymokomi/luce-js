#==============================================================================================
#
#   std_module - The `std` module: process, environment, scripts and its tables
#
#   DESCRIPTION:
#       Port of quickjs-libc.c lines 737-923 (std.exit, getenv, setenv, unsetenv,
#       getenviron, gc, evalScript, strerror, parseExtJSON) and 1630-1732 (the `std`
#       tables, js_std_init and js_init_module_std). std.urlGet is in `url_get`.
#
#==============================================================================================

# mark: Process and environment =================================================================

func js_std_exit(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    var status: i32 = 0
    js.js_to_int32(ctx, &status, argv[0]) catch:
        status = -1
    c_exit(status)

func js_std_getenv(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    let name = try js.js_to_c_string(ctx, argv[0])
    let value = getenv(name)
    js.js_free_c_string(ctx, name)
    let text = value else return js.js_undefined()
    return try js.js_new_string(ctx, text)

func js_std_setenv(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    let name = try js.js_to_c_string(ctx, argv[0])
    defer js.js_free_c_string(ctx, name)
    let value = try js.js_to_c_string(ctx, argv[1])
    defer js.js_free_c_string(ctx, value)
    discard(setenv(name, value, 1))
    return js.js_undefined()

func js_std_unsetenv(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    let name = try js.js_to_c_string(ctx, argv[0])
    discard(unsetenv(name))
    js.js_free_c_string(ctx, name)
    return js.js_undefined()

## return an object containing the list of the available environment variables.
func js_std_getenviron(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    let obj = try js.js_new_object(ctx)
    errdefer js.js_free_value(ctx, obj)
    let envp = environment()
    var idx: usize = 0
    while let name = envp[idx]:
        idx += 1
        let p = strchr(name, (i32)'=') else continue
        let name_len = (usize)(p - name)
        let value = p + 1
        let atom = try js.js_new_atom_len(ctx, name, name_len)
        defer js.js_free_atom(ctx, atom)
        discard(try js.js_define_property_value(ctx, obj, atom, try js.js_new_string(ctx, value), js.prop_c_w_e))
    return obj

func js_std_gc(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    js.js_run_gc(js.js_get_runtime(ctx))
    return js.js_undefined()

## Interrupt the evaluation of std.evalScript when SIGINT was received.
func interrupt_handler(rt: Runtime*, opaque: void*?) -> i32:
    let pending: u64 = os_pending_signals
    return (i32)((pending >> (u64)sig_int) & 1)

# mark: Scripts =================================================================================

## Set `*pbool` from the property `option` of `obj` when it is defined (get_bool_option).
func get_bool_option(ctx: Context*, pbool: bool*, obj: Value, option: str) -> !:
    let val = try js.js_get_property_str(ctx, obj, option)
    defer js.js_free_value(ctx, val)
    if not js.js_is_undefined(val):
        *pbool = js.js_to_bool(ctx, val) catch: recover false

## std.evalScript(str, options): evaluate `str` as a global script; options are
## `backtrace_barrier` and `async`.
func js_eval_script(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    var backtrace_barrier = false
    var is_async = false
    if argc >= 2:
        let options_obj = argv[1]
        try get_bool_option(ctx, &backtrace_barrier, options_obj, "backtrace_barrier")
        try get_bool_option(ctx, &is_async, options_obj, "async")

    var len: usize = 0
    let text = try js.js_to_c_string_len(ctx, &len, argv[0])
    defer js.js_free_c_string(ctx, text)
    let rt = js.js_get_runtime(ctx)
    let ts = thread_state(rt)
    let main_thread = ts.recv_pipe == none
    if main_thread:
        ts.eval_script_recurse += 1
        if ts.eval_script_recurse == 1:
            # install the interrupt handler
            js.js_set_interrupt_handler(rt, interrupt_handler, none)
    errdefer eval_script_failed(ctx, ts, main_thread)
    defer eval_script_leave(rt, ts, main_thread)
    var flags = js.eval_type_global
    if backtrace_barrier:
        flags |= js.eval_flag_backtrace_barrier
    if is_async:
        flags |= js.eval_flag_async
    return try js.js_eval(ctx, text, len, "<evalScript>".bytes.data, flags)

## The end of std.evalScript: remove the interrupt handler when leaving the outermost one.
func eval_script_leave(rt: Runtime*, ts: ThreadState*, main_thread: bool):
    if not main_thread:
        return
    ts.eval_script_recurse -= 1
    if ts.eval_script_recurse == 0:
        # remove the interrupt handler
        js.js_set_interrupt_handler(rt, none, none)
        os_pending_signals &= ~((u64)1 << (u64)sig_int)

## The end of a failed std.evalScript, after eval_script_leave.
func eval_script_failed(ctx: Context*, ts: ThreadState*, main_thread: bool):
    if main_thread and ts.eval_script_recurse == 0:
        # convert the uncatchable "interrupted" error into a normal error so that it can
        # be caught by the REPL
        js.js_set_uncatchable_exception(ctx, false)

func js_std_strerror(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    var err: i32 = 0
    try js.js_to_int32(ctx, &err, argv[0])
    return try js.js_new_string(ctx, strerror(err))

func js_std_parse_ext_json(ctx: Context*, this_val: Value, argc: i32, argv: Value*) -> Value!:
    var len: usize = 0
    let text = try js.js_to_c_string_len(ctx, &len, argv[0])
    defer js.js_free_c_string(ctx, text)
    return try parse_json2(ctx, text, len, "<input>".bytes.data, js.parse_json_ext)

