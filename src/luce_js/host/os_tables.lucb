## OS_PLATFORM.
func os_platform() -> str:
    if platform.windows:
        return "win32"
    elif platform.macos:
        return "darwin"
    else:
        return "linux"

func js_os_init(ctx: Context*, m: ModuleDef*) -> !:
    os_poll_func = js_os_poll
    try js.js_set_module_export_list(ctx, m, js_os_funcs)
    let name = os_platform()
    discard(try js.js_set_module_export(ctx, m, "platform".bytes.data,
                                        try js.js_new_string_len(ctx, name.bytes.data, name.length)))

## Register the `os` module under `module_name` (js_init_module_os).
pub func js_init_module_os(ctx: Context*, module_name: const u8*) -> ModuleDef*!:
    let m = try js.js_new_c_module(ctx, module_name, js_os_init)
    try js.js_add_module_export_list(ctx, m, js_os_funcs)
    try js.js_add_module_export(ctx, m, "platform".bytes.data)
    return m
