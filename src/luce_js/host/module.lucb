import c
import platform
import thread
import time
import luce_js.cutils as cutils
import luce_js.engine as js
from luce_js.cutils import DynBuf, ListHead
from luce_js.engine import Context, Runtime, Value, ModuleDef, Atom, CFunctionListEntry
from luce_js.engine import CFunctionEnum, ClassDef, PropertyEnum, PromiseState

# mark: Per-runtime state =======================================================================

## A read and/or write handler of a file descriptor (JSOSRWHandler).
struct OSRWHandler:
    var link: ListHead
    var fd: i32
    ## temporary use in js_os_poll()
    var poll_fd_index: i32
    ## the read (0) and write (1) handlers, null when unset
    var rw_func: Value[2]

## A JavaScript handler of a signal (JSOSSignalHandler).
struct OSSignalHandler:
    var link: ListHead
    var sig_num: i32
    var func_: Value

## A pending os.setTimeout or os.sleepAsync (JSOSTimer).
struct OSTimer:
    var link: ListHead
    var timer_id: i32
    var timeout: i64
    var func_: Value

## A rejected promise without a handler yet (JSRejectedPromiseEntry).
struct RejectedPromiseEntry:
    var link: ListHead
    var promise: Value
    var reason: Value

## The host state of one runtime, its opaque pointer (JSThreadState). QuickJS also keeps
## the worker ports and message pipes here; without workers every runtime is the main
## thread.
struct ThreadState:
    ## list of OSRWHandler.link
    var os_rw_handlers: ListHead
    ## list of OSSignalHandler.link
    var os_signal_handlers: ListHead
    ## list of OSTimer.link
    var os_timers: ListHead
    ## list of RejectedPromiseEntry.link
    var rejected_promise_list: ListHead
    ## only used in the main thread
    var eval_script_recurse: i32
    ## for setTimeout()
    var next_timer_id: i32
    ## the descriptors js_os_poll waits for, poll_fds_size of them allocated
    var poll_fds: PollFd*?
    var poll_fds_size: i32

## Waits for and runs one event (js_os_poll); installed when the `os` module is
## initialized. Answers -1 when there are no more events.
type PollFunc = func(Context*) -> i32

## One bit per signal received and not yet handled; set by os_signal_handler.
var os_pending_signals: @u64
var os_poll_func: PollFunc?

## The host state of the runtime of `ctx`, installed by js_std_init_handlers.
func thread_state(rt: Runtime*) -> ThreadState*:
    let opaque = js.js_get_runtime_opaque(rt) else trap("host: js_std_init_handlers was not called")
    return (ThreadState*)opaque

func js_std_realloc(opaque: void*?, ptr: void*?, size: usize) -> void*?:
    let rt = (Runtime*)(opaque else trap("host: dynbuf without runtime"))
    return js.js_realloc_rt(rt, ptr, size)

func js_std_dbuf_init(ctx: Context*, s: DynBuf*):
    cutils.dbuf_init2(s, js.js_get_runtime(ctx), js_std_realloc)

func my_isdigit(ch: u8) -> bool:
    return ch >= '0' and ch <= '9'

## Whether the NUL-terminated `text` ends with `suffix` (has_suffix of cutils.c).
func has_suffix(text: const u8*, suffix: str) -> bool:
    let len = cutils.strlen(text)
    let slen = suffix.length
    return len >= slen and cutils.memcmp(text + (len - slen), suffix.bytes.data, slen) == 0
