test "js_atod long inputs 1":
    check_atod("9999999999999999999999999999999999999999", 0, 0, 0x483d6329f1c35ca5, 40)
    check_atod(".999999999999999999999999999999999999999", 0, 0, 0x3ff0000000000000, 40)
    check_atod("1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890", 0, 0, 0x6731bbcf48529a53, 190)
    check_atod(".234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890", 0, 0, 0x3fce06521462cfdc, 190)
    check_atod("", 0, 0, 0x7ff0000000000000, 340)
    check_atod(".", 0, 0, 0x3ff0000000000000, 340)
    check_atod("-790", 0, 0, 0x01752a64e34ba0d3, 495)
    check_atod(".-790", 0, 0, 0x0000000000000000, 495)
    check_atod("-940", 0, 0, 0x01a56e1fc2f8f359, 645)
    check_atod(".-940", 0, 0, 0x0000000000000000, 645)
    check_atod("-1090", 0, 0, 0x01752a64e34ba0d3, 796)
    check_atod(".-1090", 0, 0, 0x0000000000000000, 796)
