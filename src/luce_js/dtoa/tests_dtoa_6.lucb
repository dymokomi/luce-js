#==============================================================================================
#
#   tests_dtoa_6 - Expected dtoa results pinned from the C dtoa.c
#
#   DESCRIPTION:
#       Generated by a C driver compiled against upstream QuickJS dtoa.c (2026-06-04): each
#       line is one call and the exact bytes (or bits) C produced. Do not edit by hand.
#
#==============================================================================================

test "js_dtoa radix 7":
    check_dtoa(0x41f0000000080000, 36, 0, 0, 20, "1z141z4.i")
    check_dtoa(0x4340000000000000, 36, 0, 0, 20, "2gosa7pa2gw")
    check_dtoa(0x3e7ad7f29abcaf48, 36, 0, 0, 20, "0.000061oezo085tj")
    check_dtoa(0x7ff8000000000000, 36, 0, 0, 20, "NaN")
    check_dtoa(0xfff0000000000000, 36, 0, 0, 20, "-Infinity")
    check_dtoa(0x3fb999999999999a, 36, 0, 4, 20, "3.lllllllllm@-1")
    check_dtoa(0x3e7ad7f29abcaf48, 36, 0, 8, 27, "0.000061oezo085tj")
    check_dtoa(0x2e6f66b049cdc80b, 36, 0, 0, 20, "j.ycmic1363@-55")
