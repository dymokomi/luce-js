#==============================================================================================
#
#   tests_dtoa_1 - Expected dtoa results pinned from the C dtoa.c
#
#   DESCRIPTION:
#       Generated by a C driver compiled against upstream QuickJS dtoa.c (2026-06-04): each
#       line is one call and the exact bytes (or bits) C produced. Do not edit by hand.
#
#==============================================================================================

test "js_dtoa free format 1":
    check_dtoa(0x0000000000000000, 10, 0, 0, 25, "0")
    check_dtoa(0x0000000000000000, 10, 0, 4, 25, "0e+0")
    check_dtoa(0x0000000000000000, 10, 0, 8, 336, "0")
    check_dtoa(0x0000000000000000, 10, 0, 16, 25, "0")
