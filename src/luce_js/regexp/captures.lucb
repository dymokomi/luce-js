#==============================================================================================
#
#   captures - Quantified atom analysis, capture groups, group names and modifiers
#
#   DESCRIPTION:
#       Port of QuickJS libregexp.c lines 1554-1843: re_need_check_adv_and_capture_init,
#       re_parse_group_name, re_parse_captures, re_count_captures, re_has_named_captures,
#       find_group_name, is_duplicate_group_name, re_parse_modifiers and update_modifier.
#
#==============================================================================================

# mark: Atom analysis ==========================================================================

# need_check_adv: false if the opcodes always advance the char pointer
# need_capture_init: true if all the captures in the atom are not set
func re_need_check_adv_and_capture_init(pneed_capture_init: bool*, bc_buf: const u8*,
                                        bc_buf_len: i32) -> bool:
    var need_check_adv = true
    var need_capture_init = false
    var pos: i32 = 0
    while pos < bc_buf_len:
        let opcode = (REOp)bc_buf[(usize)pos]
        var len = (i32)reopcode_size[(u8)opcode]
        var done = false
        match opcode:
            .range, .range_i:
                let val = cutils.get_u16(bc_buf + (usize)pos + 1)
                len += (i32)val * 4
                need_check_adv = false
            .range32, .range32_i:
                let val = cutils.get_u16(bc_buf + (usize)pos + 1)
                len += (i32)val * 8
                need_check_adv = false
            .char_, .char_i, .char32, .char32_i, .dot, .any, .space, .not_space:
                need_check_adv = false
            .line_start, .line_start_m, .line_end, .line_end_m, .set_i32, .set_char_pos, .word_boundary, .word_boundary_i, .not_word_boundary, .not_word_boundary_i, .prev:
                # no effect
                len = len # (a match arm needs a statement)
            .save_start, .save_end, .save_reset:
                len = len # (a match arm needs a statement)
            .back_reference, .back_reference_i, .backward_back_reference, .backward_back_reference_i:
                let val = bc_buf[(usize)pos + 1]
                len += (i32)val
                need_capture_init = true
            _:
                # safe behavior: we cannot predict the outcome
                need_capture_init = true
                done = true
        if done:
            break
        pos += len
    *pneed_capture_init = need_capture_init
    return need_check_adv

# mark: Group names ============================================================================

# Whether the NUL-terminated strings `a` and `b` are equal (C `!strcmp(a, b)`).
func c_str_eq(a: const u8*, b: const u8*) -> bool:
    let len = cutils.strlen(a)
    return len == cutils.strlen(b) and cutils.memcmp(a, b, len) == 0

# '*pp' is the first char after '<'
func re_parse_group_name(buf: u8[], pp: const u8**) -> i32:
    var p = *pp
    var q: usize = 0
    while true:
        var c: u32 = *p
        if c == (u32)'\\':
            p = p + 1
            if *p != 'u':
                return -1
            c = (u32)lre_parse_escape(&p, 2) # accept surrogate pairs
        elif c == (u32)'>':
            break
        elif c >= 128:
            c = (u32)cutils.unicode_from_utf8(p, cutils.utf8_char_len_max, &p)
            if cutils.is_hi_surrogate(c):
                var p1 = p
                let d = (u32)cutils.unicode_from_utf8(p, cutils.utf8_char_len_max, &p1)
                if cutils.is_lo_surrogate(d):
                    c = cutils.from_surrogate(c, d)
                    p = p1
        else:
            p = p + 1
        if c > 0x10FFFF:
            return -1
        if q == 0:
            if not unicode.lre_js_is_ident_first(c):
                return -1
        else:
            if not unicode.lre_js_is_ident_next(c):
                return -1
        if (q + (usize)cutils.utf8_char_len_max + 1) > buf.length:
            return -1
        if c < 128:
            buf[q] = (u8)c
            q += 1
        else:
            q += (usize)cutils.unicode_to_utf8(&buf[q], c)
    if q == 0:
        return -1
    buf[q] = 0
    p = p + 1
    *pp = p
    return 0

# if capture_name = NULL: return the number of captures + 1.
# Otherwise, return the number of matching capture groups
func re_parse_captures(s: REParseState*, phas_named_captures: i32*, capture_name: const u8*?,
                       emit_group_index: bool) -> i32:
    var name: u8[128]

    var capture_index: i32 = 1
    var n: i32 = 0
    *phas_named_captures = 0
    var p = s.buf_start
    scan: while p < s.buf_end:
        match *p:
            '(':
                if p[1] == '?':
                    if p[2] == '<' and p[3] != '=' and p[3] != '!':
                        *phas_named_captures = 1
                        # potential named capture
                        if let wanted = capture_name:
                            p = p + 3
                            if re_parse_group_name(name, &p) == 0:
                                if c_str_eq(&name[0], wanted):
                                    if emit_group_index:
                                        discard(cutils.dbuf_putc(&s.byte_code, (u8)capture_index))
                                    n += 1
                        capture_index += 1
                        if capture_index >= capture_count_max:
                            break scan
                else:
                    capture_index += 1
                    if capture_index >= capture_count_max:
                        break scan
            '\\':
                p = p + 1
            '[':
                p = p + 1 + (usize)(*p == ']')
                while p < s.buf_end and *p != ']':
                    if *p == '\\':
                        p = p + 1
                    p = p + 1
            _:
                p = p # nothing to do (a match arm needs a statement)
        p = p + 1
    if capture_name != none:
        return n
    else:
        return capture_index

func re_count_captures(s: REParseState*) -> i32:
    if s.total_capture_count < 0:
        s.total_capture_count = re_parse_captures(s, &s.has_named_captures, none, false)
    return s.total_capture_count

func re_has_named_captures(s: REParseState*) -> bool:
    if s.has_named_captures < 0:
        discard(re_count_captures(s))
    return s.has_named_captures != 0

func find_group_name(s: REParseState*, name: const u8*, emit_group_index: bool) -> i32:
    var p: const u8* = s.group_names.buf else return 0
    let buf_end = p + s.group_names.size
    let name_len = cutils.strlen(name)
    var capture_index: i32 = 1
    var n: i32 = 0
    while p < buf_end:
        let len = cutils.strlen(p)
        if len == name_len and cutils.memcmp(name, p, name_len) == 0:
            if emit_group_index:
                discard(cutils.dbuf_putc(&s.byte_code, (u8)capture_index))
            n += 1
        p = p + len + (usize)lre_group_name_trailer_len
        capture_index += 1
    return n

func is_duplicate_group_name(s: REParseState*, name: const u8*, scope: i32) -> bool:
    var p: const u8* = s.group_names.buf else return false
    let buf_end = p + s.group_names.size
    let name_len = cutils.strlen(name)
    while p < buf_end:
        let len = cutils.strlen(p)
        if len == name_len and cutils.memcmp(name, p, name_len) == 0:
            let scope1 = (i32)p[len + 1]
            if scope == scope1:
                return true
        p = p + len + (usize)lre_group_name_trailer_len
    return false

# mark: Modifiers ==============================================================================

func re_parse_modifiers(s: REParseState*, pp: const u8**) -> i32:
    var p = *pp
    var mask: i32 = 0

    while true:
        var val: i32 = 0
        if *p == 'i':
            val = lre_flag_ignorecase
        elif *p == 'm':
            val = lre_flag_multiline
        elif *p == 's':
            val = lre_flag_dotall
        else:
            break
        if (mask & val) != 0:
            return re_parse_error(s, f"duplicate modifier: '{char_text(p)}'")
        mask |= val
        p = p + 1
    *pp = p
    return mask

func update_modifier(val: bool, add_mask: i32, remove_mask: i32, mask: i32) -> bool:
    var v = val
    if (add_mask & mask) != 0:
        v = true
    if (remove_mask & mask) != 0:
        v = false
    return v
