#==============================================================================================
#
#   interp_ops_compare - Opcodes: comparisons, operators and with statements
#
#   DESCRIPTION:
#       Port of the opcode bodies of JS_CallInternal, quickjs.c lines 20268-20661: OP_lt to
#       OP_invalid. Each body is a function taking the interpreter state (InterpState, see
#       interpreter_support.lucb); the dispatch loop calls it from its arm. A body that can
#       raise answers false with the exception pending, which the loop treats as C's `goto
#       exception`; one that cannot raise answers nothing.
#
#==============================================================================================

# mark: Comparisons =============================================================================

## The body of OP_lt in JS_CallInternal.
noinline func interp_lt(st: InterpState*) -> bool:
    let op1 = st.sp[-2]
    let op2 = st.sp[-1]
    var slow = false
    if js_value_is_both_int(op1, op2):
        st.sp[-2] = js_new_bool(js_value_get_int(op1) < js_value_get_int(op2))
        st.sp -= 1
    elif js_tag_is_float64(op1.tag) or js_tag_is_float64(op2.tag):
        var d1: f64 = 0.0
        var d2: f64 = 0.0
        if js_tag_is_float64(op1.tag):
            d1 = js_value_get_float64(op1)
        elif op1.tag == Tag.int:
            d1 = f64(js_value_get_int(op1))
        else:
            slow = true
        if js_tag_is_float64(op2.tag):
            d2 = js_value_get_float64(op2)
        elif op2.tag == Tag.int:
            d2 = f64(js_value_get_int(op2))
        else:
            slow = true
        if not slow:
            st.sp[-2] = js_new_bool(d1 < d2)
            st.sp -= 1
    else:
        slow = true
    if slow:
        st.sf.cur_pc = st.pc
        js_relational_slow(st.ctx, st.sp, st.opcode) catch: return false
        st.sp -= 1
    return true

