#==============================================================================================
#
#   array_iterator_tables - The builtin tables of Iterator, Array and the Array Iterator
#
#   DESCRIPTION:
#       Port of quickjs.c lines 44719-44811: the function lists the intrinsics setup
#       installs on Iterator, Iterator.prototype, the Iterator Helper prototype,
#       Array.prototype (with its [Symbol.unscopables] object) and the Array Iterator
#       prototype. Each entry spells its C macro as api_types.lucb documents.
#
#==============================================================================================

# mark: Iterator ================================================================================

## The static methods of the Iterator constructor.
let js_iterator_funcs: CFunctionListEntry[2] = [
    CFunctionListEntry(name = "concat", def_type = def_cfunc, length = 0, generic = js_iterator_concat),
    CFunctionListEntry(name = "from", def_type = def_cfunc, length = 1, generic = js_iterator_from),
]

## Iterator.prototype.
