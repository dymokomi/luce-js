                       generic_magic = js_create_iterator_helper, magic = (i16)IteratorHelperKind.flat_map),
    CFunctionListEntry(name = "map", def_type = def_cfunc, length = 1, cproto = CFunctionEnum.generic_magic,
                       generic_magic = js_create_iterator_helper, magic = (i16)IteratorHelperKind.map),
    CFunctionListEntry(name = "take", def_type = def_cfunc, length = 1, cproto = CFunctionEnum.generic_magic,
                       generic_magic = js_create_iterator_helper, magic = (i16)IteratorHelperKind.take),
    CFunctionListEntry(name = "every", def_type = def_cfunc, length = 1, cproto = CFunctionEnum.generic_magic,
                       generic_magic = js_iterator_proto_func, magic = (i16)IteratorHelperKind.every),
    CFunctionListEntry(name = "find", def_type = def_cfunc, length = 1, cproto = CFunctionEnum.generic_magic,
                       generic_magic = js_iterator_proto_func, magic = (i16)IteratorHelperKind.find),
    CFunctionListEntry(name = "forEach", def_type = def_cfunc, length = 1, cproto = CFunctionEnum.generic_magic,
                       generic_magic = js_iterator_proto_func, magic = (i16)IteratorHelperKind.for_each),
    CFunctionListEntry(name = "some", def_type = def_cfunc, length = 1, cproto = CFunctionEnum.generic_magic,
                       generic_magic = js_iterator_proto_func, magic = (i16)IteratorHelperKind.some),
    CFunctionListEntry(name = "reduce", def_type = def_cfunc, length = 1, generic = js_iterator_proto_reduce),
    CFunctionListEntry(name = "toArray", def_type = def_cfunc, length = 0, generic = js_iterator_proto_to_array),
    CFunctionListEntry(name = "[Symbol.iterator]", def_type = def_cfunc, length = 0, generic = js_iterator_proto_iterator),
    CFunctionListEntry(name = "[Symbol.toStringTag]", prop_flags = 1, def_type = def_cgetset,
                       getter = js_iterator_proto_get_to_string_tag, setter = js_iterator_proto_set_to_string_tag),
]

## The prototype of the Iterator Helper objects.
let js_iterator_helper_proto_funcs: CFunctionListEntry[3] = [
    CFunctionListEntry(name = "next", def_type = def_cfunc, length = 0, cproto = CFunctionEnum.iterator_next,
                       iterator_next = js_iterator_helper_next, magic = (i16)gen_magic_next),
    CFunctionListEntry(name = "return", def_type = def_cfunc, length = 0, cproto = CFunctionEnum.iterator_next,
                       iterator_next = js_iterator_helper_next, magic = (i16)gen_magic_return),
    CFunctionListEntry(name = "[Symbol.toStringTag]", prop_flags = (u8)prop_configurable, def_type = def_prop_string,
                       string_value = "Iterator Helper"),
]

