# A `break` of an inner loop is taken as leaving the outer `while true`.
#
# Expected: compiles; the outer `while true` has no `break` of its own, so its end is never
#           reached and `f` always returns (base.md §8.5: `break` acts on the innermost loop).
# Actual:   inner_break_ends_outer_loop.lucb:9:1: this function may reach its end without
#           returning
# Workaround in luce_js.regexp (lre_exec_backtrack): `trap("unreachable")` after the loop.

func f(n: i32) -> i32:
    var i: i32 = 0
    while true:
        i += 1
        if i > n:
            return i
        while true:
            break

test "inner break does not end the outer loop":
    assert(f(3) == 4)
