# The C backend emits a GNU statement expression for a conditional on `sizeof` in a
# top-level constant, which C rejects at file scope.
#
# Expected: `luce-base test c_backend_global_conditional.lucb --backend=c` passes, as the
#           native backend does (base.md §5.1, §6.4: a `usize` expression built from
#           literals, `sizeof` and arithmetic is a constant; the conditional is one).
# Actual:   gen.c: error: statement expression not allowed at file scope
#               size_t lb_..._mask = ((size_t)((((size_t)(1ULL << ((({ size_t _lb_sq1 ...
#           luce-base: the C compiler rejected the generated code
# Workaround in luce_js.regexp (exec_state.lucb): `bp_type_bits` is a function.

let bits: usize = 3 if sizeof(usize) >= 8 else 2
let mask: usize = (1 << bits) - 1

test "conditional constant":
    assert(mask == 7 or mask == 3)
