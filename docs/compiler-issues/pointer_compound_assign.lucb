# `p += n` on a pointer is rejected although `p = p + n` is accepted.
#
# Expected: base.md §7.7 defines `p + n` for a pointer and an integer, and §6.5 makes
#           `x += y` the assignment `x = x + y`, so `p += 1` advances `p` by one element.
# Actual:   pointer_compound_assign.lucb:13:10: expected `u8*`, got an integer literal
#           (and with an `i32` operand: expected `u8*`, got `i32`).
# Workaround: write `p = p + n`.

func second(bytes: u8[]) -> u8:
    var p = bytes.data
    p = p + 1
    let q = p
    p += 1
    return *q

test "pointer compound assignment":
    var buf: u8[2] = [1, 2]
    assert(second(buf) == 2)
