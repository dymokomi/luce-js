# In a `mutating` method `self` has the struct's type, not `Self*`.
#
# Expected: base.md §9.5 says "a `mutating` method receives `self` as `Self*`", so `self`
#           can be passed where a `Counter*` is expected.
# Actual:   mutating_self_type.lucb:13:17: expected `Counter*`, got `Counter`
# Workaround: pass `&self` (it is the receiver's address, not a copy: luce_js.cutils
#           DynBuf.write does this and its dbuf_printf test sees the caller's buffer change).

struct Counter:
    var n: i32

    mutating func bump():
        add_one(self)

func add_one(c: Counter*):
    c.n += 1

test "mutating self is a pointer":
    var c = Counter(n = 0)
    c.bump()
    assert(c.n == 1)
