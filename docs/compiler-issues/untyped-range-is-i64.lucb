# A range of two untyped literals is `i64`, not `usize`.
#
# The language (base.md §8.3, and §4.2) says: "a range of two untyped literals is
# `usize`". The checker makes the loop variable `i64`:
#
#   expected: compiles; `ext` is `usize` and `main` returns 1.
#   actual:   untyped-range-is-i64.lucb:13:18: expected `usize`, got `i64`
#
# Workaround in the libunicode tests (then luce_js.unicode, now in luce-regex): type the loop variable, `for ext: usize in 0..<2`.

func main(arguments: str[]) -> i32:
    var total: usize = 0
    for ext in 0..<2:
        total += ext
    return (i32)total
