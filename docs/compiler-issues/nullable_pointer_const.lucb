# Nullable pointers do not gain `const` implicitly.
#
# Expected: `void*?` converts to `const void*?` and `u8*?` to `const u8*?` implicitly, as
#           `T*` converts to `const T*` (base.md §5.3: "T* converts implicitly to const T*",
#           and §5 "T to T?"); `none` stays `none`. C code passes a possibly-NULL buffer to
#           memcpy's `const void *` source constantly.
# Actual:   nullable_pointer_const.lucb:13:12: expected `const void*?`, got `void*?`
#           (and `expected const u8*?, got u8*?` for the byte pointer).
# Workaround: an `if let` helper (luce_js.engine array_buffers.lucb `bytes_as_const_void`),
#           as for compiler-issues/nullable_pointer_cast.

func as_const(p: void*?) -> const void*?:
    return p

test "nullable pointer gains const":
    assert(as_const(none) == none)
