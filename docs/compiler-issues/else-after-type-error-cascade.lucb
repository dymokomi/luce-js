# One type error makes every later `else` fallback on a fallible call an error.
#
# `g` has a real error (a character literal adapts to `u8` only, base.md §4.4). After it,
# the checker also rejects the correct `f(x) else false` in `h`, and every other `else`
# fallback on a fallible call later in the module, with a message that names the wrong
# cause:
#
#   expected: one diagnostic, e.lucb:11:9: expected `u32`, got `char`
#   actual:   that one, then e.lucb:14:14: `else` needs an optional or a fallible result
#             (and one more per later function using an `else` fallback)
#
# No workaround is needed in the port: fixing the first error removes the others. Seen in
# luce_js.engine function_builtins.lucb (`string_buffer_putc8(b, (u32)'(')`).

let failed: ErrorCode = ErrorCode.package(1)

func put(c: u32) -> !:
    if c > 100: error(failed, "no")

func f(x: i32) -> bool!:
    if x > 1: error(failed, "no")
    return true

func g() -> !:
    put('(') catch: recover ()

func h(x: i32) -> i32:
    discard(f(x) else false)
    return 1

func main(arguments: str[]) -> i32:
    return h(3)
