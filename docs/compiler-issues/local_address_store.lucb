# Storing a local's address through a pointer read from a parameter is rejected.
#
# base.md §6.6 lists four rejected uses of a local's address: returning it, passing it to
# `error(...)`, storing it in a global, and storing it "through a pointer parameter or
# into a struct that is returned"; "a value read through a pointer or a view is not the
# pointer". Here `rt` is read through the parameter `ctx`, so storing `&frame` through
# `rt` is none of the four (and the frame is unlinked before the function returns, which
# is how QuickJS pushes the stack frames of C function calls).
#
#   expected: compiles; the test passes.
#   actual:   local_address_store.lucb:31:14: this pointer or view
#             names a local and must not be stored where it outlives the function
#
# Workaround in luce_js.engine (calls.lucb): store the frame through a small helper,
# `js_push_stack_frame(rt, sf)`, since the check stops at calls.

struct Frame:
    var prev: Frame*?
    var depth: i32

struct Rt:
    var cur: Frame*?

struct Ctx:
    var rt: Rt*

func call(ctx: Ctx*) -> i32:
    let rt = ctx.rt
    var frame = Frame(prev = rt.cur, depth = 1)
    let sf = &frame
    rt.cur = sf
    let depth = sf.depth
    rt.cur = sf.prev
    return depth

test "a frame pushed and popped":
    var rt = Rt(cur = none)
    var ctx = Ctx(rt = &rt)
    assert(call(&ctx) == 1)
    assert(rt.cur == none)
