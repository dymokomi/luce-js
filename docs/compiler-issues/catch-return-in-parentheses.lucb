# A bare `return` in a `catch` handler written inside parentheses does not parse.
#
# The language (base.md §11.4) says a handler may `recover value`, `error`, `trap`, or
# `return`; §3.2 says a handler can be written as an argument. In a unit function the
# `return` has no value, but the parser reads the closing `)` as its missing expression:
#
#   expected: compiles; `caller` returns at the failure and the test passes silently.
#   actual:   catch-return-in-parentheses.lucb:19:42: expected an expression
#
# Workaround in luce_js.engine exceptions.lucb: the fallible calls move into a helper
# returning `!`, whose one failure is handled by a statement-level `catch failure: return`.

let failed: ErrorCode = ErrorCode.package(1)

func fails() -> i32!:
    error(failed, "no")

func caller():
    discard(fails() catch failure: return)
    print("not reached")

test "bare return in a catch handler inside parentheses":
    caller()
