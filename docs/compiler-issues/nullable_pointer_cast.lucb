# Nullable pointers do not convert between pointee types.
#
# Expected: `u8*?` converts to `void*?` implicitly (as `u8*` converts to `void*`, §5.3), or
#           at least by the C cast `(void*?)p` (§7.5: "(T*)p from U*, void*, ..."); `none`
#           stays `none`. C code does this constantly (`realloc(s->buf, n)` with a NULL buf).
# Actual:   both forms are rejected:
#               nullable_pointer_cast.lucb:12:12: expected `void*?`, got `u8*?`
#           and `(void*)p` says "a nullable pointer needs `if let`, not a cast".
# Workaround: an `if let` helper (`cutils.nullable_void` in luce_js.cutils module.lucb).

func as_void(p: u8*?) -> void*?:
    return (void*?)p

test "nullable pointer cast":
    assert(as_void(none) == none)
