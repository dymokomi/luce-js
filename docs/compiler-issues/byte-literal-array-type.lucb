# Byte literal is typed `const u8[]`, not `const u8[N]`.
#
# The language (base.md §4.4) says a byte literal `b"..."` is static data of type
# `const u8[N]`. The checker types it as the span `const u8[]`, and reads the written
# annotation `const u8[3]` as `u8[3]` (the `const` is dropped), so this program fails:
#
#   expected: compiles; `t` is a `const u8[3]` and `main` returns 97.
#   actual:   bl.lucb:1:22: expected `u8[3]`, got `const u8[]`
#
# Workaround in luce_js.unicode: the generated byte tables are declared `const u8[]`.

let t: const u8[3] = b"abc"

func main(arguments: str[]) -> i32:
    return (i32)t[0]
