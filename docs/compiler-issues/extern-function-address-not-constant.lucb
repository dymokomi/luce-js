# The address of an `extern` function is not accepted in a constant expression.
#
# The language (base.md §6.4) says a constant expression may hold "the address of a global
# or a function", so a table of function pointers is a top-level `let`. That works for a
# Base function, and an extern function converts to a function value at run time, but the
# checker refuses the extern one in a constant:
#
#   expected: compiles; the test passes.
#   actual:   extern-function-address-not-constant.lucb:17:36: a top-level `let` needs a
#             constant expression (§6.4)
#
# Workaround in luce_js.engine math.lucb: Math.acosh/asinh/atanh are Base functions that call
# the bound C functions, and the table holds those.

extern func c_fabs as "fabs"(x: f64) -> f64

let table: (func(f64) -> f64)[1] = [c_fabs]

test "extern function address in a constant":
    let f = table[0]
    assert(f(-2.0) == 2.0)
