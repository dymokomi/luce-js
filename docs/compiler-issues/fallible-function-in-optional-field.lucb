# A non-fallible function stored into an optional fallible function-pointer field is
# not adapted: native prints garbage for 'local' and -1 for 'table' (expected 8 and 8);
# --backend=c rejects the generated C (incompatible function pointer types).
# Assigning to a plain (non-optional) Getter works. Workaround: declare such
# functions fallible themselves.
type Getter = func(i32) -> i32!

struct Entry:
    let getter: Getter? = none

func get(a: i32) -> i32:
    return a * 2

let table: Entry[1] = [Entry(getter = get)]

pub func main(arguments: str[]) -> i32:
    var e = Entry(getter = get)
    if let g = e.getter:
        print(f"local {g(4) catch failure: recover -1}")
    if let g = table[0].getter:
        print(f"table {g(4) catch failure: recover -1}")
    return 0
