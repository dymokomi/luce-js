# A float-to-integer cast is a call: `(i32)d` (and `(i64)d`, `i32(d)`) lowers to a call of
# std/core's f_to_s(value, bits, mode, at), about 60 instructions with its own frame, where
# the target has one instruction for it (arm64 fcvtzs, which already saturates and maps NaN
# to 0; x86-64 cvttsd2si plus the range test).
#
# Expected: `fcvtzs w0, d0` in `to_int` below (C: `(int32_t)d`).
# Actual:   with `luce-base build --release` (native backend, arm64 macOS):
#               _lb_..._to_int: ... mov x0, #0x20; mov x1, #0x1; bl _lb_core_6f_to_s
#           In luce_js every number result goes through JS_NewFloat64's `(int32_t)d`; in
#           a loop of Math.abs calls, f_to_s alone was 1.9% of the time.
# Workaround: luce_js.engine value.lucb f64_to_i32_small computes the truncation of a float
#           of magnitude at most 2^31 from its representation; js_new_float64 and
#           js_to_int32_free's fast case use it.

noinline func to_int(d: f64) -> i32:
    return (i32)d

func main(args: str[]) -> i32:
    return to_int(3.5) - 3
