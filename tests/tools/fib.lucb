#==============================================================================================
#
#   fib - A native module for the ljsc tests: QuickJS's examples/fib.c
#
#   DESCRIPTION:
#       Port of examples/fib.c, the module test_fib.js imports as "./fib.so". ljsc's
#       -M fib.so,fib makes the generated program call js_init_module_fib, as qjsc's does
#       with the C function of that name; tests/tools.py copies this file next to the
#       generated one.
#
#==============================================================================================

import js

func fib(n: i32) -> i32:
    if n <= 0:
        return 0
    elif n == 1:
        return 1
    else:
        return fib(n - 1) + fib(n - 2)

func js_fib(ctx: js.Context*, this_val: js.Value, argc: i32, argv: js.Value*) -> js.Value!:
    var n: i32 = 0
    try js.js_to_int32(ctx, &n, argv[0])
    let res = fib(n)
    return js.js_new_int32(res)

let js_fib_funcs: js.CFunctionListEntry[1] = [
    js.CFunctionListEntry(name = "fib", def_type = js.def_cfunc, length = 1, generic = js_fib),
]

func js_fib_init(ctx: js.Context*, m: js.ModuleDef*) -> !:
    try js.js_set_module_export_list(ctx, m, js_fib_funcs)

## Declare the module `module_name` exporting fib (JS_INIT_MODULE of examples/fib.c).
pub func js_init_module_fib(ctx: js.Context*, module_name: const u8*) -> js.ModuleDef*!:
    let m = try js.js_new_c_module(ctx, module_name, js_fib_init)
    try js.js_add_module_export_list(ctx, m, js_fib_funcs)
    return m
