# mark: C library ===============================================================================

extern func malloc(size: usize) -> void*?
extern func realloc(ptr: void*?, size: usize) -> void*?
extern func c_free as "free"(ptr: u8*?)
extern func memcpy(dest: void*, src: const void*, n: usize) -> void*
extern func memset(dest: void*, ch: i32, n: usize) -> void*
extern func strlen(s: const u8*) -> usize
extern func strcmp(a: const u8*, b: const u8*) -> i32
extern func strncmp(a: const u8*, b: const u8*, n: usize) -> i32
extern func strstr(haystack: const u8*, needle: const u8*) -> u8*?
extern func strchr(s: const u8*, ch: i32) -> u8*?
extern func strrchr(s: const u8*, ch: i32) -> u8*?
extern func strcspn(s: const u8*, reject: const u8*) -> usize
extern func strtol(s: const u8*, endp: u8**?, base: i32) -> i64
extern func atoi(s: const u8*) -> i32
extern func isspace(ch: i32) -> i32
extern func isdigit(ch: i32) -> i32
extern func qsort(base: void*?, n: usize, size: usize, compar: func(const void*, const void*) -> i32)
