import js

func text(p: const u8*) -> str:
    var n: usize = 0
    while p[n] != 0:
        n += 1
    return (str)u8[]((u8*)p, n)

pub func main(arguments: str[]) -> i32:
    let rt = js.js_new_runtime() else trap("no runtime")
    let ctx = js.js_new_context(rt) else trap("no context")
    let source = arguments[1] if arguments.length > 1 else "1 + 2"
    let v = js.js_eval_text(ctx, source, "<eval>", 0) catch failure:
        let e = js.js_get_exception(ctx)
        let s = js.js_to_c_string(ctx, e) catch f2: trap("cannot print exception")
        print(f"exception: {text(s)}")
        return 1
    let s = js.js_to_c_string(ctx, v) catch f3: trap("cannot print result")
    print(text(s))
    return 0
